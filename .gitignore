.DS_Store

# the matrix sdk binary and sources, fetched by scripts/setup-matrix-sdk.sh
/vendor/
/apps/multiplexer/modules/apple/MatrixSDKFFI.xcframework
/apps/multiplexer/modules/apple/sdk-*.swift
/apps/multiplexer/modules/apple/core-*.swift

# swift package build output
/matrix-core/.build/
/matrix-core/.swiftpm/

# the matrix playbook checkout and the server secrets (both written by server/setup.sh)
/server/vendor/
/server/inventory/host_vars/*/vars.yml

# the beeper walkthrough: a screen recording of real chats, kept out of git
/research/

# the cli: the macOS sdk build that scripts/setup-cli-sdk.sh writes, and swift build output
/cli/.sdk/
/cli/.build/
/cli/.swiftpm/

# local nonsecret apple identity and self-hosted push gateway
/ios.config.local.json
