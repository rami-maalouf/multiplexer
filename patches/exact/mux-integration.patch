+        }
+        XCTAssertNil(host.presentedViewController)
+        XCTAssertNotEqual(nav.navigationBar.tintAdjustmentMode, .dimmed)
+        try assertProperties(enabled: true, lightFill: [0, 101, 212], darkFill: [49, 148, 255])
