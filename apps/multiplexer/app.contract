// Multiplexer: the view. app.ts answers what it asks for. For now the screen
// proves that matrix-rust-sdk loads: only the Rust library knows its commit.
shape SdkInfo
  commit: string

routes nav
  home "/"

component Multiplexer
  resource sdk = sdkInfo() as shape SdkInfo
  view
    main testId="root" navigationKey=`${top(nav).id}` navigationBack="back" width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` navigationScroll="content" position="absolute" inset=0 display="flex" flex-direction="column"
          header display="flex" align-items="center"
            text "Multiplexer" role="heading" aria-level=1 flex=1
          list id="content" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
            section
              row
                text "Matrix SDK" flex=1
                text (sdk.commit == "" ? "Not loaded" : sdk.commit.slice(0, 12)) color="-exact-secondary-label" testId="sdk-commit"
              footer
                text "The commit of matrix-rust-sdk that this app linked."
