// Multiplexer: the view. app.ts answers what it asks for, through the native module
// (modules/apple/Matrix.swift), which calls MatrixCore.
use EmptyState from "exact:content"
use Badge from "exact:content"

shape Session
  userId: string

// avatar: the room's picture once it is downloaded (""), else its initials show.
shape Room
  id: string
  name: string
  isDirect: bool
  lastMessage: string
  lastSender: string
  lastIsOwn: bool
  lastTime: number
  avatar: string
  initials: string
  unread: number

// owner is the account the rooms belong to, so a list never shows under another account.
shape RoomList
  owner: string
  rooms: Room[]

// state: "sending", "sent" or "failed". startsGroup: the time shows above it.
// showName: the sender's name shows above it. A photo (isImage) has its size in pixels
// (0 when unknown), its width in the chat in rem, and its thumbnail's path once it is
// downloaded ("" until then); its body is the caption, or "". waitingForKey: an encrypted
// message this device cannot read yet; it turns into the message when its key comes.
shape Message
  id: string
  senderName: string
  body: string
  time: number
  isOwn: bool
  state: string
  startsGroup: bool
  showName: bool
  isImage: bool
  image: string
  imageWidth: number
  imageHeight: number
  photoWidth: number
  waitingForKey: bool

// the full picture of the photo open in the viewer; message names it.
shape Photo
  message: string
  path: string

// room is the chat the messages belong to, so a chat never shows another's. atStart:
// the chat shows the room's first message, so there is nothing older to load.
shape Thread
  room: string
  atStart: bool
  messages: Message[]

shape Time
  epochAtZero: number
  utcOffset: number

shape SignInReply
  ok: bool
  error: string

shape Reply
  ok: bool

routes nav
  home "/"
    room "/room/:id"
      photo "/room/:id/photo/:message"

// a group chat names who wrote the last message; a one-to-one chat does not.
fn preview(r: Room): string = r.lastIsOwn ? `You: ${r.lastMessage}` : (r.isDirect or r.lastSender == r.name ? r.lastMessage : `${r.lastSender}: ${r.lastMessage}`)

component Multiplexer
  state server = ""
  state user = ""
  state password = ""
  state problem = ""
  state draft = ""
  state now = 0
  resource time = exactTime() as shape Time
  resource session = currentSession() as shape Session else empty()
  // newest activity first: the order the server ranks the rooms in.
  resource roomList = loadRoomsByRecency(session.userId) as shape RoomList else empty()
  mutation signedIn as shape SignInReply refreshes session then afterSignIn
  mutation signedOut as shape Reply refreshes session
  mutation sent as shape Reply then afterSend
  mutation retried as shape Reply
  mutation discarded as shape Reply
  mutation older as shape Reply
  derive canSignIn = server.trim() != "" and user.trim() != "" and password != "" and not pending(signedIn)
  derive refusal = match signedIn { case some(r) => r.ok ? "" : r.error, case none => "" }
  derive roomsShown = roomList.owner == session.userId
  derive shown = time.epochAtZero + now
  // the chat stays open under its photo viewer, so the open room is the stack's, not the top's.
  derive openRoom = match first(stack(nav).filter(x => x.name == "room")) { case some(r) => r.params.id, case none => "" }
  derive shownPhoto = top(nav).name == "photo" ? top(nav).params.message : ""
  derive shownPhotoMessage = first(thread.messages.filter(m => m.id == shownPhoto))
  resource photo = loadPhoto(openRoom, shownPhoto) as shape Photo else empty()
  derive openRoomInfo = first(roomList.rooms.filter(r => r.id == openRoom))
  derive openName = match openRoomInfo { case some(r) => r.name, case none => "" }
  derive openIsDirect = match openRoomInfo { case some(r) => r.isDirect, case none => false }
  resource thread = loadMessages(openRoom, openIsDirect) as shape Thread else empty()
  derive threadShown = thread.room == openRoom
  task tick mount
    every(60000, step)

  action step
    now = performanceNow()
  action follow(url: string)
    nav = go(nav, url)
  action back
    nav = back(nav)

  action editServer(v: string)
    server = v
  action editUser(v: string)
    user = v
  action editPassword(v: string)
    password = v
  action toUser
    focus("user")
  action toPassword
    focus("password")
  action signIn
    if canSignIn
      send signedIn = signIn(server.trim(), user.trim(), password)
  action afterSignIn
    if refusal != ""
      problem = refusal
      showModal("sign-in-failed")
    else
      password = ""
  action askSignOut
    showModal("sign-out")
  action signOut
    send signedOut = signOut()
  action reloadRooms
    refresh roomList
  action reloadThread
    refresh thread
  action editDraft(v: string)
    draft = v
  action post
    if draft.trim() != "" and not pending(sent)
      send sent = sendMessage(openRoom, draft.trim())
    focus("composer")
  action afterSend
    if match sent { case some(r) => r.ok, case none => false }
      draft = ""
  action showPhoto(id: string)
    nav = push(nav, path("photo", openRoom, id))
  action retry(id: string)
    send retried = retryMessage(openRoom, id)
  action loadOlder
    if threadShown and not thread.atStart and not pending(older)
      send older = loadOlderMessages(openRoom)
  action discard(id: string)
    send discarded = discardMessage(openRoom, id)

  view
    main testId="root" navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow interactive-widget="resizes-content"
      width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "home"
          if session.userId == ""
            column navigationKey=`${e.id}` navigationScroll="sign-in-form" position="absolute" inset=0 display="flex" flex-direction="column"
              header display="flex" align-items="center"
                text "Multiplexer" role="heading" aria-level=1 flex=1
                button press=signIn disabled=(not canSignIn) buttonStyle="filled" testId="sign-in"
                  text "Sign In"
              list id="sign-in-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                section
                  row
                    text "Server" width="6.5rem"
                    input id="server" value=server input=editServer submit=toUser placeholder="matrix.org"
                      aria-label="Server" autocomplete="url" inputmode="url" autocapitalize="none" enterkeyhint="next"
                      disabled=pending(signedIn) testId="server" flex=1 min-width=0
                  footer
                    text "Your chats from WhatsApp and other networks come through this Matrix server."
                section
                  row
                    text "User Name" width="6.5rem"
                    input id="user" value=user input=editUser submit=toPassword placeholder="Required"
                      aria-label="User Name" autocomplete="username" autocapitalize="none" enterkeyhint="next"
                      disabled=pending(signedIn) testId="user" flex=1 min-width=0
                  row
                    text "Password" width="6.5rem"
                    input id="password" type="password" value=password input=editPassword submit=signIn placeholder="Required"
                      aria-label="Password" autocomplete="current-password" enterkeyhint="go"
                      disabled=pending(signedIn) testId="password" flex=1 min-width=0
                if pending(signedIn)
                  section
                    row gap=8 testId="signing-in"
                      progress aria-label="Signing in"
                      text "Signing In…" color="-exact-secondary-label"
          else
            column navigationKey=`${e.id}` navigationScroll="rooms" position="absolute" inset=0 display="flex" flex-direction="column"
              header display="flex" align-items="center"
                text "Chats" role="heading" aria-level=1 flex=1
                text session.userId
                button press=askSignOut testId="sign-out"
                  text "Sign Out"
              if roomsShown
                if roomList.rooms.length == 0
                  EmptyState(symbol="symbol:messages", title="No Chats Yet", message="Chats you join on this account show here.")
                else
                  list id="rooms" refresh=reloadRooms refreshing=pending(roomList) flex=1 min-height=0 testId="room-list"
                    for r in roomList.rooms key=r.id
                      link href=path("room", r.id) testId=`room-${r.id}`
                        row align-items="center" flex=1 min-width=0
                          // a fixed 44-point picture, as Messages has; initials grow with the text size, to a cap.
                          view width=44 height=44 border-radius=22 overflow="hidden" flex-shrink=0 margin-right=12
                            background-color="-exact-tertiary-fill" display="flex" align-items="center" justify-content="center"
                            testId=`avatar-${r.id}`
                            if r.avatar != ""
                              image r.avatar width="100%" height="100%" object-fit="cover" aria-label=""
                            else
                              text r.initials font-size="min(-exact-headline, 20px)" font-weight=600 color="-exact-secondary-label"
                          column flex=1 min-width=0 gap=2 padding="10px 0"
                            // at large text sizes the time wraps under the name instead of covering it.
                            row flex-wrap="wrap" column-gap=6 align-items="baseline"
                              text r.name font="-exact-headline" font-weight=(r.unread > 0 ? 700 : 600) flex="1 1 10rem" min-width=0
                              row gap=6 align-items="baseline" flex-shrink=0 margin-left="auto"
                                if r.lastTime > 0
                                  text formatDay(r.lastTime, shown, time.utcOffset, "list") font="-exact-subheadline"
                                    color=(r.unread > 0 ? "AccentColor" : "-exact-secondary-label")
                                image "symbol:forward-chevron" font="-exact-footnote" color="-exact-tertiary-label"
                            // an unread chat: a bold name and a count beside the preview.
                            row gap=8 align-items="flex-start"
                              text (r.lastMessage != "" ? preview(r) : "") font="-exact-subheadline" color="-exact-secondary-label" line-clamp=2
                                flex=1 min-width=0 testId=`room-preview-${r.id}`
                              if r.unread > 0
                                Badge(label=(r.unread > 99 ? "99+" : r.unread.toString()), tint=some("AccentColor"))
              else
                if failed(roomList) and not pending(roomList)
                  column flex=1 justify-content="center" align-items="center" gap=12 padding=24
                    text "Couldn’t load your chats." color="-exact-secondary-label" testId="rooms-error"
                    button press=reloadRooms buttonStyle="bordered" testId="rooms-retry"
                      text "Try Again"
                else
                  column flex=1 justify-content="center" align-items="center"
                    progress aria-label="Loading chats" testId="rooms-loading"
        if e.name == "photo"
          column navigationKey=`${e.id}` navigationPresentation="fullscreen" navigationSource=`photo-${e.params.message}`
            position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center"
              button id="back" press=back aria-label="Close" testId="close-photo"
                image "symbol:close"
              text (match shownPhotoMessage { case some(m) => m.isOwn ? "You" : m.senderName, case none => "Photo" }) role="heading" aria-level=2
              text (match shownPhotoMessage { case some(m) => formatDay(m.time, shown, time.utcOffset, "day-time"), case none => "" })
            // the thumbnail shows at once; the full picture replaces it when it is here.
            match shownPhotoMessage
              case some(m)
                image (photo.message == m.id and photo.path != "" ? photo.path : m.image) flex=1 min-height=0 width="100%"
                  object-fit="contain" aria-label=(m.body != "" ? m.body : "Photo") testId="photo-full"
              case none
                column flex=1
        if e.name == "room"
          column navigationKey=`${e.id}` navigationScroll="transcript" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center"
              text openName role="heading" aria-level=2
            if threadShown
              if thread.messages.length == 0
                EmptyState(symbol="symbol:messages", title="No Messages Yet", message="Messages in this chat show here.")
              else
                list id="transcript" appearance="none" virtualized=true scroll-start="end" scrollFollowEnd=true
                  reachstart=loadOlder flex=1 min-height=0 testId="transcript"
                  for m in thread.messages key=m.id
                    column align-items=(m.isOwn ? "flex-end" : "flex-start") padding="2px 12px" gap=2
                      if m.startsGroup
                        text formatDay(m.time, shown, time.utcOffset, "day-time") font="-exact-caption1"
                          color="-exact-secondary-label" align-self="center" padding="12px 0 4px"
                      // no name in a chat named after the sender (a one-to-one chat that is not marked direct).
                      if m.showName and m.senderName != openName
                        text m.senderName font="-exact-caption1" color="-exact-secondary-label" padding="0 12px"
                      // a photo keeps its shape while it downloads; a tap opens it, zooming out of its box.
                      if m.isImage
                        button appearance="none" press=showPhoto(m.id) id=`photo-${m.id}` width=`${m.photoWidth}rem` max-width="75%"
                          aspect-ratio=(m.imageWidth > 0 and m.imageHeight > 0 ? `${m.imageWidth} / ${m.imageHeight}` : "4 / 3")
                          border-radius=18 overflow="hidden" background-color="-exact-secondary-background"
                          aria-label=(m.body != "" ? m.body : "Photo") testId=`photo-${m.id}`
                          if m.image != ""
                            image m.image width="100%" height="100%" object-fit="cover"
                      // a message on its way is dimmed; one that failed says so, with a way to send it again.
                      if m.waitingForKey
                        text "Waiting for this message" padding="8px 12px" border-radius=18 max-width="75%" font-style="italic"
                          background-color="-exact-fill" color="-exact-secondary-label" testId=`message-${m.id}`
                      else if not m.isImage or m.body != ""
                        text m.body padding="8px 12px" border-radius=18 max-width="75%" overflow-wrap="break-word"
                          background-color=(m.isOwn ? "AccentColor" : "-exact-fill") color=(m.isOwn ? "AccentColorText" : "-exact-label")
                          opacity=(m.state == "sending" ? 0.6 : 1) testId=`message-${m.id}`
                      if m.state == "failed"
                        row gap=12 align-items="center"
                          text "Not Delivered" font="-exact-footnote" color="-exact-system-red" testId=`failed-${m.id}`
                          button press=retry(m.id) disabled=pending(retried) testId=`retry-${m.id}`
                            text "Try Again"
                          button press=discard(m.id) destructive=true disabled=pending(discarded) testId=`discard-${m.id}`
                            text "Delete"
            else
              if failed(thread) and not pending(thread)
                column flex=1 justify-content="center" align-items="center" gap=12 padding=24
                  text "Couldn’t load this chat." color="-exact-secondary-label" testId="thread-error"
                  button press=reloadThread buttonStyle="bordered" testId="thread-retry"
                    text "Try Again"
              else
                column flex=1 justify-content="center" align-items="center"
                  progress aria-label="Loading messages" testId="thread-loading"
            if threadShown
              // the field's own padding makes it a 44-point target; the row adds none above or below.
              row align-items="flex-end" margin="6px 12px" padding="0 4px 0 12px" border-radius=22
                border="1px solid -exact-separator"
                textarea id="composer" value=draft input=editDraft rows=1 field-sizing="content" max-height=140
                  placeholder="Message" aria-label="Message" testId="composer" flex=1 min-width=0 padding="12px 0"
                  border="none" background-color="transparent"
                button press=post disabled=(draft.trim() == "" or pending(sent)) buttonStyle="filled" margin="4px 0"
                  retainFocus=true aria-label="Send" testId="send"
                  image "symbol:send"
      dialog id="sign-in-failed" role="alertdialog" aria-label="Couldn’t Sign In"
        text problem testId="problem"
        button commandfor="sign-in-failed" command="close" testId="sign-in-failed-ok"
          text "OK"
      dialog id="sign-out" role="alertdialog" aria-label="Sign Out?"
        text "This iPhone forgets your session. Your chats stay on the server."
        button press=signOut destructive=true commandfor="sign-out" command="close" testId="sign-out-confirm"
          text "Sign Out"
        button commandfor="sign-out" command="close"
          text "Cancel"
