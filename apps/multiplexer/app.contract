// Multiplexer: the view. app.ts answers what it asks for, through the native module
// (modules/apple/Matrix.swift), which calls MatrixCore.
use ClipboardItem from "@exact/clipboard"
use notificationclick from "@exact/notifications"
use EmptyState from "exact:content"
use Badge from "exact:content"
use Balloon, Face from "./bubble.contract"
use Attachment, chosenOf, AddButton, AddPanel, Tray, FileBubble, UploadRing, sizeText, fileDetail from "./attach.contract"
use BottomBar, PinnedGrid, PinnedChat, TitleMenu, emptyTitle, emptyMessage, listTitle, listEmptyTitle, listEmptyMessage, deleteMessage from "./inbox.contract"
use NetworkBadge, networkName from "./network.contract"
use InboxSheet, NetworkCount from "./sheet.contract"
use ChatBar, ComposerNetwork, replyPlaceholder, composerPlaceholder from "./chat.contract"
use MessageActions, ForwardSheet, ForwardChat, deleteMessageText from "./menu.contract"
use EmojiSheet, EmojiRow, emojiGroupOf from "./emoji.contract"
use Run, DayHeader, NewLine, StatusLine, JumpButton, BigEmoji, RichBalloon, Sticker, VideoPoster, VideoPlayer, SwipeReply, seenText, videoLabel, OlderLine from "./details.contract"
use VoiceBar, VoiceBubble, VoiceStill, VoiceButton, RecordingBar, DraftBar from "./voice.contract"
use SearchBar, SearchResults, ChatSearchResults, JumpNote from "./search.contract"
use SettingsScreen, Profile from "./settings.contract"
use InfoPage, EditGroupSheet, CustomNameSheet, AddMemberSheet from "./info.contract"
use ScheduledBar, ScheduledScreen, LaterSheet, laterProblem, weekdayOf from "./send-later.contract"
use GifSheet from "./gif.contract"
use CameraScreen from "./camera.contract"

shape Session
  userId: string

// avatar: the room's picture once it is downloaded (""), else its initials show. network: the
// chat network its bridge brings it from (whatsapp, instagram, ...), or matrix for none. listed:
// the list shows it under the filter menu's choice (a pinned chat, or one the filter leaves out,
// is still here, so an open chat keeps its name). markedUnread: marked unread by hand. muted: its
// messages do not notify, so its count is grey; mentions: its unread messages that mention you.
// lowPriority, archived: in those lists, not the inbox.
shape Room
  id: string
  name: string
  // the chat's own name, which everyone sees; name is yours when you gave it one (B20).
  roomName: string
  isDirect: bool
  lastMessage: string
  lastSender: string
  lastIsOwn: bool
  lastTime: number
  avatar: string
  initials: string
  unread: number
  network: string
  listed: bool
  markedUnread: bool
  muted: bool
  mentions: number
  lowPriority: bool
  archived: bool
  // when the account asked to be reminded to answer it (ms since 1970); 0 for none (Remind Me).
  reminder: number

// owner is the account the rooms belong to, so a list never shows under another account; filter
// the filter menu's choice the list is for, network the filter sheet's ("": every network), list
// the list shown (inbox, archive or lowPriority). pinned: the network's pinned chats in the inbox,
// in their pin order; they are not in rooms in the inbox under "all". networks: the filter
// sheet's rows, each network the account has chats on; unread, archiveUnread,
// lowPriorityUnread: each list's unread chats on every network.
shape RoomList
  owner: string
  filter: string
  network: string
  list: string
  rooms: Room[]
  pinned: PinnedChat[]
  networks: NetworkCount[]
  unread: number
  archiveUnread: number
  lowPriorityUnread: number
  // the chats with a reminder (the filter sheet's Reminders row).
  reminders: number

// state: "sending", "sent" or "failed". startsGroup: the day and time show above it (a new day, or
// an hour after the message before). endsRun: the
// sender's next message is not next, so this bubble has the tail and their picture beside it.
// showName: the sender's name shows above it. A photo (isImage) has its size in pixels
// (0 when unknown), its width in the chat in rem, and its thumbnail's path once it is
// downloaded ("" until then); its body is the caption, or "". waitingForKey: an encrypted
// message this device cannot read yet; it turns into the message when its key comes.
// hasReply: it answers a message, whose sender (replyName, "You" for yours) and text show above it.
// A file message (isFile) has its name and size in bytes; its body is the caption, or "".
// progress: how much of a photo or file on its way is uploaded, from 0 to 1; -1 when none uploads.
// A video (isVideo) and a sticker (isSticker) show their picture as a photo does: image is a
// video's poster ("" for none), seconds its length (0 when unknown). bigEmoji: one to three emoji
// and nothing else, large with no bubble. balloon: a bubble shows its text (not for a photo, file,
// video or sticker without a caption, a big emoji, or a message waiting for its key). runs: its
// text, with its links apart. status: under the chat's newest message, "Sent", "Seen" or
// "Seen by Ana, Ben" ("" for none); statusTime: when a direct chat's other person saw it, or 0.
// isDeleted: deleted for everyone, so it has no text, picture or file (no balloon). isEditable:
// your own text message, which an edit can change. editUntil, deleteUntil: when its network stops
// taking an edit or a delete for everyone (0: no limit). A voice message or an audio file (isAudio) has its
// length in seconds and its waveform's bars, each from 0 to 1.
shape Message
  id: string
  senderName: string
  senderInitials: string
  senderPicture: string
  body: string
  time: number
  isOwn: bool
  state: string
  startsGroup: bool
  endsRun: bool
  showName: bool
  isImage: bool
  image: string
  imageWidth: number
  imageHeight: number
  photoWidth: number
  waitingForKey: bool
  isEdited: bool
  isDeleted: bool
  isEditable: bool
  editUntil: number
  deleteUntil: number
  hasReply: bool
  replyName: string
  replyBody: string
  reactions: Reaction[]
  isFile: bool
  fileName: string
  fileSize: number
  progress: number
  isVideo: bool
  seconds: number
  isSticker: bool
  bigEmoji: bool
  balloon: bool
  runs: Run[]
  status: string
  statusTime: number
  isAudio: bool
  bars: VoiceBar[]
  // a voice message's sound file's name, the same on every launch: its transcript's key.
  audioKey: string

// isMine: this account reacted with it, so a tap takes it back.
shape Reaction
  key: string
  count: number
  isMine: bool

// the full picture of the photo open in the viewer; message names it.
shape Photo
  message: string
  path: string

// room is the chat the messages belong to, so a chat never shows another's. atStart:
// the chat shows the room's first message, so there is nothing older to load. group: others'
// messages show their sender's name and picture. firstUnread: the first message after this
// account's read receipt ("" for none), where the "New" line goes.
shape Thread
  room: string
  atStart: bool
  group: bool
  firstUnread: string
  messages: Message[]

shape Time
  epochAtZero: number
  utcOffset: number

shape Viewport
  width: number
  height: number
  prefersReducedMotion: bool
  accessibilityTextSize: bool

shape Page
  visibilityState: string

shape SignInReply
  ok: bool
  error: string

shape Reply
  ok: bool

// the emojis the account reacts with most, the most used first.
shape EmojiList
  emojis: string[]

// the largest file the server takes, in bytes; 0 while it is not known.
shape UploadLimit
  bytes: number

// a file message's file, downloaded to open: name names it in the share sheet.
shape OpenedFile
  message: string
  name: string
  path: string

// what a chat's composer holds: its draft, the photos and files picked to send with it, and the message it answers (replyTo, a message's id,
// which names a message only in its own chat), with what the bar shows of it. Each chat keeps
// its own, so a draft or a reply never moves to another chat.
shape Composer
  room: string
  text: string
  replyTo: string
  replyName: string
  replyBody: string
  attachments: Attachment[]

routes nav
  home "/"
    room "/room/:id"
      photo "/room/:id/photo/:message"
      video "/room/:id/video/:message"
      reactions "/room/:id/reactions/:message"
      gifs "/room/:id/gifs"
      camera "/room/:id/camera"
      forward "/room/:id/forward/:message"
      later "/room/:id/later"
      info "/room/:id/info"
        editInfo "/room/:id/info/edit"
        customName "/room/:id/info/name"
        addMember "/room/:id/info/add"
    inboxes "/inboxes"
    settings "/settings"
    scheduled "/scheduled"
      laterChange "/scheduled/:delay/time"
    remind "/remind/:id"

// a group chat names who wrote the last message; a one-to-one chat does not.
fn preview(r: Room): string = r.lastIsOwn ? `You: ${r.lastMessage}` : (r.isDirect or r.lastSender == r.name ? r.lastMessage : `${r.lastSender}: ${r.lastMessage}`)
// an unread chat that is not muted: its name is bolder and its time in the accent.
fn loud(r: Room): bool = (r.unread > 0 or r.markedUnread) and not r.muted
// the inbox's unread count counts it (matrixcore's isInInbox and isLoudlyUnread): in the inbox,
// unread and not muted, or with a mention.
fn inboxUnread(r: Room): bool = not r.archived and not r.lowPriority and (loud(r) or r.mentions > 0)
// a time limit not reached yet (0: none), as limits.ts's within.
fn within(until: number, now: number): bool = until == 0 or now < until
fn countText(n: number): string = n > 99 ? "99+" : n.toString()
// a message in one line, for a reply bar or the forward sheet: its text, else "Photo" or its file's name.
fn messageLine(m: Message): string = m.body != "" ? m.body : (m.isImage ? "Photo" : (m.isVideo ? "Video" : (m.isSticker ? "Sticker" : (m.isFile ? m.fileName : (m.isAudio ? "Voice message" : "")))))
// a chat's composer: the one touched in this launch, else the draft kept in the account's store
// (saved, once it is this chat's), else an empty one.
fn composerOf(cs: Composer[], room: string, saved: Composer): Composer = match first(cs.filter(c => c.room == room)) { case some(c) => c, case none => saved.room == room ? saved : Composer(room=room, text="", replyTo="", replyName="", replyBody="", attachments=[]) }
// cs with c in place of its chat's composer. An empty one stays, so a sent draft that the store
// still held a moment ago does not show again.
fn withComposer(cs: Composer[], c: Composer): Composer[] = cs.filter(x => x.room != c.room).concat([c])

component Multiplexer
  state server = ""
  state user = ""
  state password = ""
  state problem = ""
  state now = 0
  // each chat's composer once it is touched in this launch (see composerOf).
  state composers: Composer[] = []
  // the chat whose draft changed since it was last kept in the account's store ("" for none).
  state unsaved = ""
  // the message held down: its menu and reactions show over the chat.
  state held = ""
  state heldBody = ""
  state heldName = ""
  state heldOwn = false
  state heldTail = false
  state heldY = 0
  state heldHeight = 0
  state heldWidth = 0
  // what was held: "text" (a bubble or a large emoji), "photo", "video", "sticker" or "file"; the
  // overlay lifts a copy of it.
  state heldKind = "text"
  // your own message being edited in the open chat ("" for none): the composer holds its new
  // text, editOld what it said, and the chat's draft waits until the edit ends.
  state editing = ""
  state editText = ""
  state editOld = ""
  // the message the delete alert asks about.
  state deleting = ""
  // the message whose photo or file is downloaded to share.
  state sharing = ""
  // the forward sheet's search, and the chats checked.
  state forwardQuery = ""
  state forwardTo: string[] = []
  // the reaction sheet's search, and the group in view (its tab is chosen).
  state emojiQuery = ""
  state emojiGroup = "frequent"
  // the reader scrolled the chat's newest message out of view.
  state away = false
  // the "+" panel is open, in the keyboard's place.
  state panel = false
  // the file message being downloaded to open.
  state opening = ""
  // the files just picked that are over the server's limit, by name ("" when none).
  state tooLarge = ""
  // the filter menu's choice (inbox.contract's filterName), kept across launches.
  state filter = "all" persist
  // the filter sheet's choice: the network whose chats the list shows ("": every network), kept
  // across launches. It works with the filter menu's: unread WhatsApp chats.
  state network = "" persist
  // the list shown: the inbox, the Archive or Low Priority (inbox.contract's listName), kept
  // across launches. The filter menu and the network narrow any of them.
  state chatList = "inbox" persist
  // the chat held down in the list: its menu and preview are of it.
  state aimed = ""
  // the message a new reply answers, kept in view once the keyboard and the reply bar are up:
  // a swipe can start a reply low on the screen, where the keyboard would cover it.
  state revealing = ""
  resource time = exactTime() as shape Time
  resource viewport = exactViewport() as shape Viewport
  resource page = exactPage() as shape Page
  resource session = currentSession() as shape Session else empty()
  // newest activity first: the order the server ranks the rooms in.
  resource roomList = loadRoomsByRecency(session.userId, filter, network, chatList) as shape RoomList else empty()
  resource uploadLimit = loadUploadLimit(session.userId) as shape UploadLimit else empty()
  resource frequentEmojis = loadFrequentEmojis(session.userId) as shape EmojiList else empty()
  resource profile = loadProfile(session.userId) as shape Profile else empty()
  mutation pinned as shape Reply refreshes roomList
  mutation changedChat as shape Reply queue refreshes roomList
  mutation signedIn as shape SignInReply refreshes session then afterSignIn
  mutation signedOut as shape Reply refreshes session
  mutation sent as shape Reply then toEnd
  mutation sentMedia as shape Reply then toEnd
  mutation staged as shape Reply queue
  mutation opened as shape OpenedFile then openDownloaded
  mutation retried as shape Reply
  mutation discarded as shape Reply
  mutation older as shape Reply
  mutation reacted as shape Reply refreshes frequentEmojis
  // a held photo's Copy: data code writes the picture (@exact/clipboard).
  mutation copiedPhoto as shape Reply
  mutation edited as shape Reply
  mutation deletedMessage as shape Reply
  mutation forwarded as shape Reply
  mutation fetched as shape OpenedFile then shareFetched
  mutation resetEmojis as shape Reply refreshes frequentEmojis
  mutation markedRead as shape Reply
  mutation keptDraft as shape Reply
  derive canSignIn = server.trim() != "" and user.trim() != "" and password != "" and not pending(signedIn)
  derive refusal = match signedIn { case some(r) => r.ok ? "" : r.error, case none => "" }
  derive roomsShown = roomList.owner == session.userId
  derive shown = time.epochAtZero + now
  // the chat stays open under its photo viewer, so the open room is the stack's, not the top's.
  derive openRoom = match first(stack(nav).filter(x => x.name == "room")) { case some(r) => r.params.id, case none => "" }
  derive shownPhoto = top(nav).name == "photo" ? top(nav).params.message : ""
  derive shownPhotoMessage = first(thread.messages.filter(m => m.id == shownPhoto))
  resource photo = loadPhoto(openRoom, shownPhoto) as shape Photo else empty()
  derive openRoomInfo = first(roomList.rooms.filter(r => r.id == openRoom))
  derive openName = match openRoomInfo { case some(r) => r.name, case none => "" }
  derive openRoomName = match openRoomInfo { case some(r) => r.roomName, case none => "" }
  derive openIsDirect = match openRoomInfo { case some(r) => r.isDirect, case none => false }
  derive openNetwork = match openRoomInfo { case some(r) => r.network, case none => "matrix" }
  derive openPinned = roomList.pinned.map(p => p.id).includes(openRoom)
  derive openMuted = match openRoomInfo { case some(r) => r.muted, case none => false }
  // Back's count: the inbox's unread chats on every network (the filter sheet's Inbox row), but this one.
  derive otherUnread = max(0, roomList.unread - (match openRoomInfo { case some(r) => inboxUnread(r) ? 1 : 0, case none => 0 }))
  // the day a message is on is the reader's, so the zone's offset groups them.
  resource thread = loadMessages(openRoom, openIsDirect, openRoomName, time.utcOffset, openNetwork) as shape Thread else empty()
  // the open chat's kept draft, so a draft outlives the app (its photos and files do not).
  resource savedDraft = loadDraft(openRoom) as shape Composer else empty()
  derive composer = composerOf(composers, openRoom, savedDraft)
  derive unsavedComposer = composerOf(composers, unsaved, savedDraft)
  derive lastId = match thread.messages.at(-1) { case some(m) => m.id, case none => "" }
  // the transcript's rows: a line above the oldest loaded message first (a spinner while older ones
  // load, then where the chat starts), as one more row of the list, so `reachstart` still sees the top.
  derive transcriptRows = match thread.messages.at(0) { case some(f) => [Message(f, id="~older")].concat(thread.messages), case none => thread.messages }
  // the reactions a long press offers first, as Beeper does.
  derive quickReactions = ["❤️", "👍", "💯", "😂", "😔", "👀"]
  // the held message, and what its menu offers: Forward once the server has it, Copy for a text, a
  // caption or a photo (the picture, as Messages copies it), Edit and Delete on your own while its
  // network still takes them.
  derive heldMessage = first(thread.messages.filter(m => m.id == held))
  derive heldText = match heldMessage { case some(m) => m.body, case none => "" }
  derive heldCanForward = match heldMessage { case some(m) => m.state == "sent" and not m.isSticker, case none => false }
  derive heldCanShare = heldKind != "sticker"
  derive heldCanCopy = heldKind == "photo" or heldText != ""
  derive heldBig = match heldMessage { case some(m) => m.bigEmoji, case none => false }
  derive heldCanEdit = match heldMessage { case some(m) => m.isEditable and within(m.editUntil, shown), case none => false }
  derive heldCanDelete = heldOwn and (match heldMessage { case some(m) => within(m.deleteUntil, shown), case none => true })
  derive heldRows = 2 + (heldCanShare ? 1 : 0) + (heldCanForward ? 1 : 0) + (heldCanCopy ? 1 : 0) + (heldCanEdit ? 1 : 0) + (heldCanDelete ? 1 : 0)
  // the menu's height, so a message low on the screen moves up and the menu fits under it.
  derive heldMenuHeight = heldRows * (viewport.accessibilityTextSize ? 64 : 44) + 12 + (heldCanEdit or heldCanDelete ? 13 : 0)
  // at the largest text sizes the lifted copy is shorter (a photo shrinks to fit), so the menu
  // has room under it; what it still lacks, it scrolls.
  derive heldCap = viewport.accessibilityTextSize ? 200 : 320
  derive heldScale = min(1, heldCap / max(1, heldHeight))
  derive heldShown = min(heldHeight, heldCap)
  derive heldMenuRoom = max(132, viewport.height - heldShown - 196)
  // the message a sheet over the chat acts on: the reaction sheet's or the forward sheet's.
  derive sheetMessage = top(nav).name == "reactions" or top(nav).name == "forward" ? top(nav).params.message : ""
  derive forwardChats = roomList.rooms.map(r => ForwardChat(id=r.id, name=r.name, avatar=r.avatar, initials=r.initials, network=r.network))
  derive forwardWhat = match first(thread.messages.filter(m => m.id == sheetMessage)) { case some(m) => messageLine(m), case none => "" }
  // the reaction sheet's grid: six emoji a row on a phone, more on a wide screen. It is made while
  // a message is held, so the sheet opens full.
  derive emojiColumns = max(6, round((viewport.width - 16) / 64 - 0.5))
  resource emojiRows = loadEmojiRows(emojiQuery, emojiColumns, frequentEmojis.emojis, held != "" or top(nav).name == "reactions") as shape EmojiRow[] else empty()
  derive threadShown = thread.room == openRoom
  // a chat marked unread by hand counts one: reading it takes the mark away.
  derive openUnread = match openRoomInfo { case some(r) => r.unread + (r.markedUnread ? 1 : 0), case none => 0 }
  // the list under the filter menu's choice; the pinned grid shows above it only while no filter is on.
  derive listedRooms = roomList.rooms.filter(r => r.listed)
  derive gridShown = roomList.filter == "all" and roomList.list == "inbox" and roomList.pinned.length > 0
  // the held chat's last messages, for its menu's preview. loading them reads nothing: only the
  // chat screen marks a chat read.
  derive aimedRoom = first(roomList.rooms.filter(r => r.id == aimed))
  derive aimedName = match aimedRoom { case some(r) => r.name, case none => "" }
  derive aimedRoomName = match aimedRoom { case some(r) => r.roomName, case none => "" }
  derive aimedIsDirect = match aimedRoom { case some(r) => r.isDirect, case none => false }
  derive aimedPinned = roomList.pinned.map(p => p.id).includes(aimed)
  derive aimedUnread = match aimedRoom { case some(r) => r.unread > 0 or r.markedUnread, case none => false }
  derive aimedMuted = match aimedRoom { case some(r) => r.muted, case none => false }
  derive aimedLowPriority = match aimedRoom { case some(r) => r.lowPriority, case none => false }
  derive aimedArchived = match aimedRoom { case some(r) => r.archived, case none => false }
  derive aimedNetwork = match aimedRoom { case some(r) => r.network, case none => "matrix" }
  resource peek = loadMessages(aimed, aimedIsDirect, aimedRoomName, time.utcOffset, aimedNetwork) as shape Thread else empty()
  derive peekShown = peek.room == aimed and aimed != ""
  // the chat is in front, not behind its photo viewer, and the app is too.
  derive reading = top(nav).name == "room" and threadShown and page.visibilityState == "visible"
  task tick mount
    every(60000, step)
  // as Excord does, what the reader sees at the end is read a second after it shows; leaving
  // the end or the chat from there reads it at once (scrolled, back). Older messages read nothing.
  task markSeen when reading and not away and openUnread > 0 key=`${openRoom}/${lastId}`
    after(1000, readNow)
  task reveal when revealing != "" key=revealing
    after(300, revealNow, wait=idle, max=1000)
  // a draft is kept a moment after typing stops, when its chat is left (follow, back), and when
  // the app goes to the background, where iOS may end it.
  task keepDraft when unsaved != "" key=`${unsaved}/${unsavedComposer.text}/${unsavedComposer.replyTo}`
    after(600, keepDraftNow)
  task keepDraftHidden when unsaved != "" and page.visibilityState == "hidden"
    after(1, keepDraftNow)
  members "./details-members.contract"
  members "./voice-members.contract"
  members "./search-members.contract"
  members "./info-members.contract"
  members "./chat-search-members.contract"
  members "./send-later-members.contract"
  members "./gif-members.contract"
  members "./camera-members.contract"
  members "./encryption-members.contract"
  members "./transcribe-members.contract"
  members "./remind-members.contract"

  action step
    now = performanceNow()
  // leaving a screen closes a long-press menu: the bar's Back stays live above it.
  action follow(url: string)
    keepDraftNow()
    nav = go(nav, url)
    held = ""
    panel = false
    tooLarge = ""
    editing = ""
    // a chat opens at its newest message.
    away = false
  action back
    if reading and not away and openUnread > 0
      send markedRead = markRead(openRoom)
    // closing a sheet over the chat keeps an edit; leaving the chat ends it.
    let sheet = top(nav).name == "reactions" or top(nav).name == "forward" or top(nav).name == "gifs"
    keepDraftNow()
    nav = back(nav)
    held = ""
    panel = false
    tooLarge = ""
    if not sheet
      editing = ""
  action readNow
    send markedRead = markRead(openRoom)
  action keepDraftNow
    if unsaved != ""
      send keptDraft = saveDraft(unsaved, unsavedComposer.text, unsavedComposer.replyTo)
      unsaved = ""
  // the newest message is in view while its row's top is above the chat's bottom edge.
  action scrolled(x: number, y: number, e: ScrollEvent)
    let isAway = e.scrollHeight - e.scrollTop - e.clientHeight > max(1, frame(`row-${lastId}`).height)
    if isAway != away
      if isAway and reading and openUnread > 0 and not placing
        send markedRead = markRead(openRoom)
      // at the newest message, every message loaded has been passed: none counts below.
      if not isAway
        seenUnread = thread.messages.map(m => m.id)
      away = isAway

  action editServer(v: string)
    server = v
  action editUser(v: string)
    user = v
  action editPassword(v: string)
    password = v
  action toUser
    focus("user")
  action toPassword
    focus("password")
  action signIn
    if canSignIn
      send signedIn = signIn(server.trim(), user.trim(), password)
  // an account starts at its inbox: the network chosen before was another session's, which may
  // have ended without Sign Out (a lost store).
  action afterSignIn
    if refusal != ""
      problem = refusal
      showModal("sign-in-failed")
    else
      password = ""
      network = ""
      chatList = "inbox"
  action askSignOut
    showModal("sign-out")
  // drafts stay with the account that wrote them.
  // Settings' Sign Out: the sign-in screen shows in the inbox's place.
  action signOut
    send signedOut = signOut()
    nav = go(nav, path("home"))
    composers = []
    unsaved = ""
  action reloadRooms
    refresh roomList
  action reloadThread
    refresh thread
  // while an edit is under way the field holds its text; the draft waits.
  action editDraft(v: string)
    if editing != ""
      editText = v
    else
      composers = withComposer(composers, Composer(composer, text=v))
      unsaved = openRoom
  // as Messages does, Send clears the composer at once and scrolls to the end, even from far up.
  action post
    // an edit that changed nothing just ends.
    if editing != ""
      if editText.trim() != "" and editText.trim() != editOld
        send edited = editMessage(openRoom, editing, editText.trim())
      editing = ""
      editText = ""
    else if composer.attachments.length > 0
      if not pending(sentMedia)
        // the text is the caption: it goes with the last photo or file, the reply with the first.
        send sentMedia = sendMedia(openRoom, composer.attachments, composer.text.trim(), composer.replyTo)
        composers = withComposer(composers, Composer(composer, text="", replyTo="", attachments=[]))
        unsaved = openRoom
        tooLarge = ""
    else if composer.text.trim() != "" and not pending(sent)
      send sent = sendMessage(openRoom, composer.text.trim(), composer.replyTo)
      composers = withComposer(composers, Composer(composer, text="", replyTo=""))
      unsaved = openRoom
    focus("composer")
  // "+" puts the keyboard away and shows the panel in its place; X brings the keyboard back.
  action togglePanel
    if panel
      panel = false
      focus("composer")
    else
      panel = true
      blur("composer")
  action composerFocused
    panel = false
  action choosePhotos
    showPicker("pick-photos")
  action chooseFiles
    showPicker("pick-files")
  // what was picked joins the open chat's composer, and the keyboard comes back for a caption.
  // A photo is made ready (smaller, upright, without its location) while the caption is typed.
  action photosPicked(files: Picked[])
    attachPhotos(files.map(f => Attachment(file=chosenOf(f), photo=true)))
  // a camera photo comes here too (camera-members.contract).
  action attachPhotos(picked: Attachment[])
    composers = withComposer(composers, Composer(composer, attachments=composer.attachments.concat(picked)))
    send staged = stageMedia(picked)
    panel = false
    tooLarge = ""
    focus("composer")
  // a file over the server's limit would only fail: it stays out, and a line says why.
  action filesPicked(files: Picked[])
    let fit = files.filter(f => uploadLimit.bytes == 0 or f.size <= uploadLimit.bytes)
    composers = withComposer(composers, Composer(composer, attachments=composer.attachments.concat(fit.map(f => Attachment(file=chosenOf(f), photo=false)))))
    tooLarge = files.filter(f => uploadLimit.bytes > 0 and f.size > uploadLimit.bytes).map(f => f.name).join(", ")
    panel = false
    focus("composer")
  action unpick(path: string)
    composers = withComposer(composers, Composer(composer, attachments=composer.attachments.filter(a => a.file.path != path)))
  // a tap on a file downloads it once, then opens the share sheet, where it opens in its app.
  action openFile(id: string)
    if not pending(opened)
      opening = id
      send opened = openFile(openRoom, id)
  action openDownloaded
    match opened
      case some(f)
        if f.message == opening and f.path != ""
          share(title=f.name, files=[f.path])
      case none
        opening = opening
    opening = ""
  // a swipe right on a bubble, or Reply in its menu: the open chat's composer answers it. The
  // swipe's haptic is Exact's, at the point where letting go replies; a second one here doubled it.
  action startReply(id: string, name: string, body: string)
    composers = withComposer(composers, Composer(composer, replyTo=id, replyName=name, replyBody=body))
    unsaved = openRoom
    held = ""
    editing = ""
    revealing = id
    focus("composer")
  // Send Later's text now waits on the server: the composer empties, its reply too. A root action,
  // as a members file cannot name Composer (send-later-members.contract calls it).
  action clearComposer
    composers = withComposer(composers, Composer(composer, text="", replyTo=""))
    unsaved = openRoom
  action cancelReply
    composers = withComposer(composers, Composer(composer, replyTo=""))
    unsaved = openRoom
  // a long press lifts the bubble where it is, with reactions above it and actions under it.
  action hold(id: string, body: string, name: string, own: bool, tail: bool)
    // the clock moves once a minute: Edit and Delete read it fresh.
    now = performanceNow()
    heldY = frame(`message-${id}`).y
    heldHeight = min(320, frame(`message-${id}`).height)
    heldWidth = frame(`message-${id}`).width
    held = id
    heldKind = "text"
    heldBody = body
    heldName = name
    heldOwn = own
    heldTail = tail
    blur("composer")
    haptic("impact-light")
  // a long press on a photo or a file lifts it the same way; body is what a reply quotes of it.
  action holdMedia(id: string, kind: string, name: string, own: bool, body: string)
    // the clock moves once a minute: Edit and Delete read it fresh.
    now = performanceNow()
    heldY = frame(`${kind}-${id}`).y
    heldHeight = min(320, frame(`${kind}-${id}`).height)
    heldWidth = frame(`${kind}-${id}`).width
    held = id
    heldKind = kind
    heldBody = body
    heldName = name
    heldOwn = own
    heldTail = false
    blur("composer")
    haptic("impact-light")
  action letGo
    if held != ""
      focus(heldKind == "text" ? `bubble-${held}` : `${heldKind}-${held}`)
    held = ""
  action menuKey(k: string)
    if k == "Escape"
      letGo()
      preventDefault()
  action react(key: string)
    send reacted = react(openRoom, held, key)
    letGo()
  action toggleReaction(id: string, key: string)
    send reacted = react(openRoom, id, key)
  action copyHeld
    if heldKind == "photo"
      send copiedPhoto = copyPhoto(openRoom, held)
    else
      copyText(heldText)
    letGo()
  // a text goes to the share sheet as it is; a photo or a file is downloaded first (shareFetched).
  action shareHeld
    if heldKind == "text"
      share(text=heldText)
    else if not pending(fetched)
      sharing = held
      send fetched = fetchMedia(openRoom, held)
    letGo()
  action shareFetched
    match fetched
      case some(f)
        if f.message == sharing and f.path != ""
          share(title=f.name, files=[f.path])
      case none
        sharing = sharing
    sharing = ""
  // the forward sheet rises over the chat; the menu closes under it.
  action forwardHeld
    forwardQuery = ""
    forwardTo = []
    nav = push(nav, path("forward", openRoom, held))
    held = ""
  action searchForward(v: string)
    forwardQuery = v
  action toggleForward(id: string)
    forwardTo = forwardTo.includes(id) ? forwardTo.filter(x => x != id) : forwardTo.concat([id])
    haptic("selection")
  action sendForward
    if forwardTo.length > 0
      send forwarded = forwardMessage(openRoom, sheetMessage, forwardTo)
      nav = back(nav)
      haptic("success")
  // Edit: the composer takes the message's text, under an "Editing" bar.
  action startEdit
    editing = held
    editText = heldText
    editOld = heldText
    revealing = held
    held = ""
    panel = false
    focus("composer")
    // the caret at the text's end, ready to add to it (an offset past the end is clamped).
    setSelectionRange("composer", 1000000, 1000000)
  action cancelEdit
    editing = ""
    editText = ""
  // Delete asks first: it deletes the message for everyone.
  action askDeleteMessage
    deleting = held
    letGo()
    showModal("delete-message")
  action deleteNow
    send deletedMessage = deleteMessage(openRoom, deleting)
    deleting = ""
  // the reaction bar's "+": the sheet of every emoji rises over the held message.
  action openReactions
    emojiQuery = ""
    emojiGroup = "frequent"
    nav = push(nav, path("reactions", openRoom, held))
  action pickEmoji(key: string)
    send reacted = react(openRoom, sheetMessage, key)
    nav = back(nav)
    held = ""
  action searchEmoji(v: string)
    emojiQuery = v
  action chooseEmojiGroup(g: string)
    emojiGroup = g
    scrollIntoView("emoji-grid", g, block="start")
    haptic("selection")
  // the tab follows the group whose row is at the grid's top.
  action emojiScrolled(x: number, y: number, e: ScrollEvent)
    match e.firstVisibleKey
      case some(k)
        if emojiGroupOf(k) != emojiGroup
          emojiGroup = emojiGroupOf(k)
      case none
        emojiGroup = emojiGroup
  action resetFrequent
    send resetEmojis = resetFrequentEmojis()
  action toEnd
    scrollIntoView("transcript", lastId, block="end")
  action revealNow
    scrollIntoView("transcript", revealing, block="nearest", behavior="smooth")
    revealing = ""
  action showPhoto(id: string)
    nav = push(nav, path("photo", openRoom, id))
  action retry(id: string)
    send retried = retryMessage(openRoom, id)
  // not before or while the chat moves to its "New" line: the list's first render and that move can
  // reach the top of what is loaded, and older messages added above then move the line out of view.
  action loadOlder
    let placingLine = placing or (thread.firstUnread != "" and newLineRoom != openRoom)
    if threadShown and not thread.atStart and not pending(older)
      // the list asks once while its top stays in reach, so a load held back is made once the line is placed.
      if placingLine
        olderWanted = true
      else
        olderWanted = false
        send older = loadOlderMessages(openRoom)
  action discard(id: string)
    send discarded = discardMessage(openRoom, id)

  // the inbox: the filter menu, Inbox in the bar, and a chat's long-press menu.
  // another list starts at its top, as another mailbox does in Mail.
  action chooseFilter(f: string)
    filter = f
    toTop()
  // the up-down button opens the filter sheet; a row chooses a network ("": every network) and
  // closes it.
  // the title's menu: Settings; Select Chats and Merge Chats come later.
  action showSettings
    nav = push(nav, path("settings"))
  action chooseSpeed(s: number)
    voiceSpeed = s
    haptic("selection")
  action openInboxes
    nav = push(nav, path("inboxes"))
  action chooseNetwork(n: string)
    network = n
    if top(nav).name == "inboxes"
      nav = back(nav)
    toTop()
    haptic("selection")
  action toTop
    scrollIntoView(gridShown ? "pinned" : (match first(listedRooms) { case some(r) => `room-${r.id}`, case none => "rooms" }), block="start")
  // the capsule's Inbox and Archive keep the network; a press on the list shown goes back to its top.
  action toInbox
    if chatList != "inbox"
      chatList = "inbox"
    toTop()
  action toArchive
    if chatList != "archive"
      chatList = "archive"
    toTop()
  // the filter sheet's Inbox, Archive and Low Priority rows: that list on every network.
  action chooseList(l: string)
    chatList = l
    network = ""
    if top(nav).name == "inboxes"
      nav = back(nav)
    toTop()
    haptic("selection")
  action aim(id: string)
    aimed = id
  action openChat(id: string)
    follow(path("room", id))
  action togglePin
    send pinned = setPinned(aimed, not aimedPinned)
    haptic("success")
  // the held chat's other actions (app.ts's changeChat); each shows in the list at once.
  action changeAimed(change: string)
    send changedChat = changeChat(aimed, change)
    haptic("success")
  action askDelete
    showModal("delete-chat")
  // the chat bar's "..." pins, mutes or marks unread the open chat.
  action togglePinOpen
    send pinned = setPinned(openRoom, not openPinned)
    haptic("success")
  action toggleMuteOpen
    send changedChat = changeChat(openRoom, openMuted ? "unmute" : "mute")
    haptic("success")
  // the chat is marked unread and left: staying, it would read itself again a second later. Unlike
  // back, leaving does not mark it read.
  action markUnreadOpen
    send changedChat = changeChat(openRoom, "unread")
    keepDraftNow()
    nav = back(nav)
    held = ""
    panel = false
    tooLarge = ""
    editing = ""
    haptic("success")

  view
    main testId="root" navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow notificationclick=openReminder interactive-widget="resizes-content"
      width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "home"
          if session.userId == ""
            column navigationKey=`${e.id}` navigationScroll="sign-in-form" position="absolute" inset=0 display="flex" flex-direction="column"
              header display="flex" align-items="center"
                text "Multiplexer" role="heading" aria-level=1 flex=1
                button press=signIn disabled=(not canSignIn) buttonStyle="filled" testId="sign-in"
                  text "Sign In"
              list id="sign-in-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                section
                  row
                    text "Server" width="6.5rem"
                    input id="server" value=server input=editServer submit=toUser placeholder="matrix.org"
                      aria-label="Server" autocomplete="url" inputmode="url" autocapitalize="none" enterkeyhint="next"
                      disabled=pending(signedIn) testId="server" flex=1 min-width=0
                  footer
                    text "Your chats from WhatsApp and other networks come through this Matrix server."
                section
                  row
                    text "User Name" width="6.5rem"
                    input id="user" value=user input=editUser submit=toPassword placeholder="Required"
                      aria-label="User Name" autocomplete="username" autocapitalize="none" enterkeyhint="next"
                      disabled=pending(signedIn) testId="user" flex=1 min-width=0
                  row
                    text "Password" width="6.5rem"
                    input id="password" type="password" value=password input=editPassword submit=signIn placeholder="Required"
                      aria-label="Password" autocomplete="current-password" enterkeyhint="go"
                      disabled=pending(signedIn) testId="password" flex=1 min-width=0
                if pending(signedIn)
                  section
                    row gap=8 testId="signing-in"
                      progress aria-label="Signing in"
                      text "Signing In…" color="-exact-secondary-label"
          else
            // while searching, the search's results take the list's place, and the bar hides.
            column navigationKey=`${e.id}` navigationScroll=(searching ? "search-results" : "rooms") navigationBar="none"
              position="absolute" inset=0 display="flex" flex-direction="column"
              // the title names the network the filter sheet chose, and opens Beeper's menu.
              if not searching
                TitleMenu(title=listTitle(chatList, network), settings=showSettings, largeText=viewport.accessibilityTextSize)
              // the list stays under the search, covered, so closing the search finds it where it was.
              if roomsShown
                if listedRooms.length == 0 and not gridShown and not searching
                  if roomList.filter != "all"
                    EmptyState(symbol="symbol:filter", title=emptyTitle(roomList.filter), message=emptyMessage(roomList.filter))
                      button press=chooseFilter("all") buttonStyle="bordered" testId="show-all"
                        text "Show All Chats"
                  else if roomList.list != "inbox"
                    // an empty Archive, Low Priority or Reminders: the capsule's Inbox is the way back.
                    EmptyState(symbol=(roomList.list == "archive" ? "symbol:icon.archive" : (roomList.list == "reminders" ? "symbol:icon.alarm" : "symbol:icon.arrow-down-circle")),
                      title=listEmptyTitle(roomList.list), message=listEmptyMessage(roomList.list, roomList.network))
                      if roomList.network != ""
                        button press=chooseNetwork("") buttonStyle="bordered" testId="show-every-network"
                          text "Show Every Network"
                  else if roomList.network == ""
                    EmptyState(symbol="symbol:messages", title="No Chats Yet", message="Chats you join on this account show here.")
                  else
                    EmptyState(symbol="symbol:messages", title=`No ${networkName(roomList.network)} Chats`,
                      message=`Chats from ${networkName(roomList.network)} show here.`)
                      button press=chooseNetwork("") buttonStyle="bordered" testId="show-every-network"
                        text "Show All Chats"
                else
                  // the last row scrolls up above the floating bar.
                  list id="rooms" refresh=reloadRooms refreshing=pending(roomList) flex=1 min-height=0 padding-bottom=64 testId="room-list"
                    inert=searching opacity=(searching ? 0 : 1) transition="opacity 180ms ease"
                    if gridShown
                      PinnedGrid(rooms=roomList.pinned, open=openChat, aim=aim, menu="chat-menu")
                    for r in listedRooms key=r.id
                      link href=path("room", r.id) contextmenu=aim(r.id) contextPopover="chat-menu" id=`room-${r.id}` testId=`room-${r.id}`
                        row align-items="center" flex=1 min-width=0
                          // a fixed 44-point picture, as Messages has; initials grow with the text size, to a cap.
                          // a bridged chat's network logo sits on its corner, outside the clipped circle. The
                          // margin keeps a chat with no message as tall as Messages' rows.
                          view position="relative" flex-shrink=0 margin="8px 12px 8px 0"
                            view width=44 height=44 border-radius=22 overflow="hidden"
                              background-color="-exact-tertiary-fill" display="flex" align-items="center" justify-content="center"
                              testId=`avatar-${r.id}`
                              if r.avatar != ""
                                image r.avatar width="100%" height="100%" object-fit="cover" aria-label=""
                              else
                                text r.initials font-size="min(-exact-headline, 20px)" font-weight=600 color="-exact-secondary-label"
                            if r.network != "matrix"
                              NetworkBadge(network=r.network, identifier=`network-${r.id}`)
                          column flex=1 min-width=0 gap=2 padding="10px 0"
                            // at large text sizes the time wraps under the name instead of covering it.
                            row flex-wrap="wrap" column-gap=6 align-items="baseline"
                              // a muted chat: a crossed bell after its name's last word, as Beeper shows it.
                              text font="-exact-headline" font-weight=(loud(r) ? 700 : 600) flex="1 1 10rem" min-width=0
                                text r.name
                                if r.muted
                                  text " "
                                  image "symbol:icon.bell-slash" width="0.8em" height="0.8em" vertical-align="baseline"
                                    color="-exact-secondary-label" aria-label="Muted" testId=`muted-${r.id}`
                              row gap=6 align-items="baseline" flex-shrink=0 margin-left="auto"
                                if r.lastTime > 0
                                  text formatDay(r.lastTime, shown, time.utcOffset, "list") font="-exact-subheadline"
                                    color=(loud(r) ? "AccentColor" : "-exact-secondary-label")
                                image "symbol:forward-chevron" font="-exact-footnote" color="-exact-tertiary-label"
                            // an unread chat: a bold name and a count beside the preview; muted, a grey
                            // count; with a mention, "@" and the accent. Marked unread by hand: a dot.
                            row gap=8 align-items="flex-start"
                              text (r.lastMessage != "" ? preview(r) : "") font="-exact-subheadline" color="-exact-secondary-label" line-clamp=2
                                flex=1 min-width=0 testId=`room-preview-${r.id}`
                              if r.mentions > 0
                                view flex-shrink=0 testId=`count-${r.id}`
                                  Badge(label=`@ ${countText(max(r.unread, r.mentions))}`, tint=some("AccentColor"))
                              else if r.unread > 0
                                view flex-shrink=0 testId=`count-${r.id}`
                                  Badge(label=countText(r.unread), tint=(r.muted ? none : some("AccentColor")))
                              else if r.markedUnread
                                view width=12 height=12 border-radius=6 margin="4px 4px 0"
                                  background-color=(r.muted ? "-exact-tertiary-label" : "AccentColor") aria-label="Unread" testId=`marked-${r.id}`
                            // a reminder to answer it: when, in the accent once it is due (Remind Me).
                            if r.reminder > 0
                              row gap=4 align-items="center" testId=`reminder-${r.id}`
                                image "symbol:icon.alarm" width="0.9em" height="0.9em" font="-exact-footnote" aria-hidden=true
                                  color=(r.reminder <= shown ? "AccentColor" : "-exact-secondary-label")
                                text `Reminder ${formatDay(r.reminder, shown, time.utcOffset, "day-time")}` font="-exact-footnote"
                                  color=(r.reminder <= shown ? "AccentColor" : "-exact-secondary-label")
              else if not searching
                if failed(roomList) and not pending(roomList)
                  column flex=1 justify-content="center" align-items="center" gap=12 padding=24
                    text "Couldn’t load your chats." color="-exact-secondary-label" testId="rooms-error"
                    button press=reloadRooms buttonStyle="bordered" testId="rooms-retry"
                      text "Try Again"
                else
                  column flex=1 justify-content="center" align-items="center"
                    progress aria-label="Loading chats" testId="rooms-loading"
              if searching
                SearchResults(found=found, shown=foundShown, loading=pending(found), query=searchQuery, kind=searchKind,
                  recentSearches=recentSearches, now=shown, offset=time.utcOffset, largeText=viewport.accessibilityTextSize,
                  reduced=viewport.prefersReducedMotion, chooseKind=chooseKind, openChat=openFoundChat, openMessage=openFoundMessage, openLink=openFoundLink,
                  useSearch=useSearch, clearSearches=clearSearches)
                SearchBar(query=searchQuery, kind=searchKind, scope="", type=typeSearch, submit=submitSearch, close=closeSearch,
                  focused=searchFocused, focus=searchFocus, blur=searchBlur, largeText=viewport.accessibilityTextSize,
                  reduced=viewport.prefersReducedMotion)
              else if roomsShown
                BottomBar(filter=filter, choose=chooseFilter, top=toInbox, archive=toArchive, list=chatList, network=network,
                  sheet=openInboxes, search=openSearch, largeText=viewport.accessibilityTextSize)
              // a chat's long-press menu, from its row or its pinned picture: a preview of its last
              // messages (a tap opens the chat), then its actions.
              column id="chat-menu" popover="auto" role="menu"
                button contextPreview=true press=openChat(aimed) popovertarget="chat-menu" popovertargetaction="hide"
                  aria-label=`Open ${aimedName}` testId="chat-preview" width=(viewport.width - 32) height=min(440, viewport.height * 0.55)
                  display="flex" flex-direction="column" justify-content="flex-end" overflow="hidden" padding="12px 0"
                  background-color="-exact-background" box-sizing="border-box" text-align="start"
                  if peekShown and peek.messages.length == 0
                    column flex=1 justify-content="center" align-items="center"
                      text "No Messages Yet" font="-exact-headline" color="-exact-secondary-label"
                  else if peekShown
                    for m in peek.messages key=m.id
                      column align-items=(m.isOwn ? "flex-end" : "flex-start") padding="1px 12px" padding-bottom=(m.endsRun ? 8 : 1)
                        flex-shrink=0
                        if m.showName
                          text m.senderName font="-exact-caption1" color="-exact-secondary-label" padding-left=14 margin-bottom=2
                        // a video shows its poster here, a sticker its picture.
                        if m.isImage or m.isVideo or m.isSticker
                          view width=`${m.photoWidth}rem` max-width="80%"
                            aspect-ratio=(m.imageWidth > 0 and m.imageHeight > 0 ? `${m.imageWidth} / ${m.imageHeight}` : "4 / 3")
                            border-radius=(m.isSticker ? 0 : 18) overflow="hidden"
                            background-color=(m.isSticker ? "transparent" : "-exact-secondary-background")
                            if m.image != ""
                              image m.image width="100%" height="100%" object-fit=(m.isSticker ? "contain" : "cover") aria-label=(m.body != "" ? m.body : "Photo")
                        if m.isAudio
                          view max-width="80%"
                            VoiceStill(bars=m.bars, seconds=m.seconds, outgoing=m.isOwn, speed=voiceSpeed, dimmed=(m.state == "sending"),
                              stacked=viewport.accessibilityTextSize, identifier=`peek-voice-${m.id}`)
                        if m.waitingForKey
                          text "Waiting for this message" padding="8px 14px 9px" border-radius=20 font-style="italic"
                            background-color="-exact-fill" color="-exact-secondary-label"
                        else if m.balloon or m.bigEmoji
                          view max-width="80%" padding-bottom=(m.endsRun ? 6.65 : 0)
                            Balloon(body=m.body, outgoing=m.isOwn, tail=m.endsRun, dimmed=(m.state == "sending"), identifier=`peek-${m.id}`)
                  else
                    column flex=1 justify-content="center" align-items="center"
                      progress aria-label="Loading messages"
                // Beeper's order. Delete takes the chat out of this app only: the alert says so.
                button press=changeAimed(aimedArchived ? "unarchive" : "archive") popovertarget="chat-menu" popovertargetaction="hide"
                  testId="menu-archive"
                  image (aimedArchived ? "symbol:icon.unarchive" : "symbol:icon.archive")
                  text (aimedArchived ? "Unarchive" : "Archive")
                button press=changeAimed(aimedLowPriority ? "inbox" : "lowPriority") popovertarget="chat-menu" popovertargetaction="hide"
                  testId="menu-low-priority"
                  image (aimedLowPriority ? "symbol:icon.tray" : "symbol:icon.low-priority")
                  text (aimedLowPriority ? "Move to Inbox" : "Move to Low Priority")
                button press=togglePin popovertarget="chat-menu" popovertargetaction="hide" testId="menu-pin"
                  image (aimedPinned ? "symbol:icon.pin-slash" : "symbol:pin")
                  text (aimedPinned ? "Unpin" : "Pin")
                if aimedReminder > 0
                  button press=clearAimedReminder popovertarget="chat-menu" popovertargetaction="hide" testId="menu-clear-reminder"
                    image "symbol:icon.bell-slash"
                    text "Clear Reminder"
                else
                  button press=remindAimed popovertarget="chat-menu" popovertargetaction="hide" testId="menu-remind"
                    image "symbol:icon.alarm"
                    text "Remind Me…"
                button press=changeAimed(aimedUnread ? "read" : "unread") popovertarget="chat-menu" popovertargetaction="hide"
                  testId="menu-unread"
                  image (aimedUnread ? "symbol:messages" : "symbol:icon.mark-unread")
                  text (aimedUnread ? "Mark as Read" : "Mark as Unread")
                button press=changeAimed(aimedMuted ? "unmute" : "mute") popovertarget="chat-menu" popovertargetaction="hide"
                  testId="menu-mute"
                  image (aimedMuted ? "symbol:notifications" : "symbol:icon.bell-slash")
                  text (aimedMuted ? "Unmute" : "Mute")
                hr
                button press=askDelete destructive=true popovertarget="chat-menu" popovertargetaction="hide" testId="menu-delete"
                  image "symbol:delete"
                  text "Delete"
        // Send Later's list, and its time sheet for the composer's text or a waiting message.
        if e.name == "scheduled"
          ScheduledScreen(route=`${e.id}`, messages=scheduledShown, loaded=(scheduledList.owner == session.userId),
            busy=pending(scheduledChanged), refused=laterRefused, now=shown, offset=time.utcOffset, close=back,
            sendNow=sendScheduledNow, change=changeLaterTime, cancel=cancelScheduled)
        if e.name == "later"
          LaterSheet(route=`${e.id}`, title="Send Later", body=composer.text.trim(), bodyLabel="Message", verb="Send", saveLabel="Schedule",
            note=laterNote, picked=laterWhen, saving=laterSaving, refused=laterRefused, choices=false, monday=false, choose=pickLater,
            pick=pickLater, close=closeLater, save=saveLater)
        if e.name == "laterChange"
          LaterSheet(route=`${e.id}`, title="Change Time",
            body=(match first(scheduledShown.filter(m => m.id == laterFor)) { case some(m) => m.body, case none => "" }),
            bodyLabel="Message", verb="Send", saveLabel="Schedule", note=laterNote, picked=laterWhen, saving=laterSaving,
            refused=laterRefused, choices=false, monday=false, choose=pickLater, pick=pickLater, close=closeLater, save=saveLater)
        // Remind Me's time: Send Later's set times, or one picked.
        if e.name == "remind"
          LaterSheet(route=`${e.id}`, title="Remind Me", body=remindName, bodyLabel="Chat", verb="Remind", saveLabel="Set",
            note="This iPhone reminds you at this time, and the chat stays under Reminders until you answer it.",
            picked=laterWhen, saving=pending(reminded), refused=remindRefused, choices=true, monday=laterMonday, choose=remindAt,
            pick=pickLater, close=closeLater, save=saveRemind)
        if e.name == "settings"
          SettingsScreen(route=`${e.id}`, userId=session.userId, profile=profile, speed=voiceSpeed, chooseSpeed=chooseSpeed,
            signOut=askSignOut, recovery=recovery, recoveryDraft=recoveryDraft, unlocking=pending(unlocked), refused=recoveryRefused,
            typeKey=typeRecoveryKey, unlock=unlockRecovery, largeText=viewport.accessibilityTextSize)
        // the filter sheet, from the bottom: half height, pulled up to full; UIKit's glass below full.
        if e.name == "inboxes"
          column navigationKey=`${e.id}` navigationPresentation="modal" navigationDetent="medium large" navigationScroll="inboxes"
            position="absolute" inset=0 display="flex" flex-direction="column" testId="inboxes-sheet"
            InboxSheet(networks=roomList.networks, unread=roomList.unread, archiveUnread=roomList.archiveUnread,
              lowPriorityUnread=roomList.lowPriorityUnread, list=chatList, chosen=network, choose=chooseNetwork,
              chooseList=chooseList, reminders=roomList.reminders, scheduled=scheduledShown.length, openScheduled=chooseSendLater,
              largeText=viewport.accessibilityTextSize)
        // a held message's sheets: every emoji, half height and pulled up to full; the chats to forward to.
        if e.name == "reactions"
          EmojiSheet(route=`${e.id}`, rows=emojiRows, query=emojiQuery, group=emojiGroup, columns=emojiColumns, search=searchEmoji,
            pick=pickEmoji, reset=resetFrequent, choose=chooseEmojiGroup, scrolled=emojiScrolled, close=back,
            largeText=viewport.accessibilityTextSize)
        // the + panel's GIFs from KLIPY (gif.contract), half height and pulled up to full.
        if e.name == "gifs"
          GifSheet(route=`${e.id}`, gifs=gifs, query=gifQuery, shown=gifsShown, loading=pending(gifs), search=typeGif, pick=pickGif,
            close=back, largeText=viewport.accessibilityTextSize)
        // the + panel's Camera (camera.contract), full screen over the chat.
        if e.name == "camera"
          CameraScreen(route=`${e.id}`, track=cameraTrack, refused=cameraRefused, problem=cameraProblem, taking=pending(cameraShot),
            canFlip=canFlipCamera, hasFlash=cameraHasFlash, flash=cameraFlash, close=closeCamera, shutter=shootPhoto, flip=flipCamera,
            toggleFlash=toggleCameraFlash, openSettings=openCameraSettings, largeText=viewport.accessibilityTextSize)
        if e.name == "forward"
          ForwardSheet(route=`${e.id}`, chats=forwardChats, query=forwardQuery, chosen=forwardTo, what=forwardWhat, search=searchForward,
            toggle=toggleForward, send=sendForward, cancel=back, largeText=viewport.accessibilityTextSize)
        if e.name == "photo"
          column navigationKey=`${e.id}` navigationPresentation="fullscreen" navigationSource=`photo-${e.params.message}`
            position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center"
              button id="back" press=back aria-label="Close" testId="close-photo"
                image "symbol:close"
              text viewedPhoto.sender role="heading" aria-level=2
              text (viewedPhoto.found ? formatDay(viewedPhoto.time, shown, time.utcOffset, "day-time") : "")
            // the thumbnail shows at once; the full picture replaces it when it is here.
            if viewedPhoto.found
              image (photo.message == shownPhoto and photo.path != "" ? photo.path : viewedPhoto.image) flex=1 min-height=0 width="100%"
                object-fit="contain" aria-label=viewedPhoto.label testId="photo-full"
            else
              column flex=1
        // a video, full screen: the system's player, zoomed out of its poster.
        if e.name == "video"
          column navigationKey=`${e.id}` navigationPresentation="fullscreen" navigationSource=`video-${e.params.message}`
            position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center"
              button id="back" press=back aria-label="Close" testId="close-video"
                image "symbol:close"
              text viewedVideo.sender role="heading" aria-level=2
              text (viewedVideo.found ? formatDay(viewedVideo.time, shown, time.utcOffset, "day-time") : "")
            if viewedVideo.found
              VideoPlayer(path=(video.message == shownVideo ? video.path : ""), poster=viewedVideo.image, label=viewedVideo.label)
            else
              column flex=1
        // the chat's info page (info.contract), full screen, zoomed out of the chat bar's picture and name.
        if e.name == "info"
          InfoPage(route=`${e.id}`, info=infoShown, loaded=infoLoaded, members=chatMembers.members, total=chatMembers.total,
            media=chatMedia.items, mediaLoaded=(chatMedia.room == openRoom), moreMedia=allMedia, pinned=openPinned, archived=openArchived, lowPriority=openLowPriority,
            muted=openMuted, unread=(openUnread > 0), close=closeInfo, archive=archiveOpen, moveLowPriority=lowPriorityOpen,
            pin=togglePinOpen, read=readOpen, mute=toggleMuteOpen, reminder=openReminderAt, remind=remindOpen,
            clearReminder=clearOpenReminder, now=shown, offset=time.utcOffset, askDelete=askDeleteOpen, deleteChat=deleteOpen, edit=editGroup,
            customize=customize, addMember=addMember, seeMembers=seeAllMembers, seeMedia=seeAllMedia, open=showInfoMedia,
            searching=chatSearching, returned=chatSearchClosed, search=openChatSearch, closeSearch=closeChatSearch,
            largeText=viewport.accessibilityTextSize, reduced=viewport.prefersReducedMotion)
            // the search in this chat, in the page's place (chat-search-members.contract).
            ChatSearchResults(found=chatFound, shown=chatFoundShown, loading=pending(chatFound), query=chatQuery, kind=chatKind,
              now=shown, offset=time.utcOffset, largeText=viewport.accessibilityTextSize, reduced=viewport.prefersReducedMotion,
              chooseKind=chooseChatKind, openMessage=openChatFound, openLink=openChatLink)
            SearchBar(query=chatQuery, kind=chatKind, scope=infoShown.name, type=typeChatSearch, submit=submitChatSearch,
              close=closeChatSearch, focused=chatSearchFocused, focus=chatSearchFocus, blur=chatSearchBlur,
              largeText=viewport.accessibilityTextSize, reduced=viewport.prefersReducedMotion)
        if e.name == "editInfo"
          EditGroupSheet(route=`${e.id}`, info=infoShown, draft=infoDraft, picked=(match first(infoPicked) { case some(f) => f.path, case none => "" }),
            saving=infoSaving, refused=groupRefused, type=typeInfoName, choose=choosePicture, pick=picturePicked, close=back, save=saveGroup)
        if e.name == "customName"
          CustomNameSheet(route=`${e.id}`, info=infoShown, draft=customDraft, saving=infoSaving, refused=customRefused, type=typeCustomName,
            reset=resetCustomName, close=back, save=saveCustomName)
        if e.name == "addMember"
          AddMemberSheet(route=`${e.id}`, draft=inviteDraft, saving=infoSaving, refused=inviteRefused, type=typeInvite, close=back,
            save=invite)
        if e.name == "room"
          // the chat draws its own bar (chat.contract), so a held message's blur covers it.
          column navigationKey=`${e.id}` navigationBar="none" navigationScroll="transcript" position="absolute" inset=0
            display="flex" flex-direction="column"
            // a box above the transcript, so the host clears the screen's top of the status bar and
            // the bar's top=0 starts under it (a scroller at the top edge is inset by UIKit instead).
            view height=0 flex-shrink=0 aria-hidden=true
            if threadShown
              if thread.messages.length == 0
                EmptyState(symbol="symbol:messages", title="No Messages Yet", message="Messages in this chat show here.")
              else
                // the first message can scroll down from under the bar, a chat name of two lines too.
                list id="transcript" inert=(held != "") appearance="none" virtualized=true scroll-start="end" scrollFollowEnd=true
                  reachstart=loadOlder scroll=scrolled flex=1 min-height=0 padding-top=(viewport.accessibilityTextSize ? 116 : 100)
                  testId="transcript"
                  for m in transcriptRows key=m.id
                    // a found message the chat opened at is marked a moment (search-members.contract).
                    column id=`row-${m.id}` intersect=sawMessage(m.id) align-items=(m.isOwn ? "flex-end" : "flex-start") padding="1px 12px" padding-bottom=(m.endsRun ? 8 : 1)
                      background-color=(m.id == jumpedTo ? "-exact-tertiary-fill" : "transparent") transition="background-color 600ms ease"
                      if m.id == "~older"
                        OlderLine(atStart=thread.atStart)
                      else
                        if m.startsGroup
                          DayHeader(time=m.time, now=shown, offset=time.utcOffset, identifier=`day-${m.id}`)
                        if m.id == newLine and newLineRoom == openRoom
                          NewLine()
                        if m.showName
                          text m.senderName font="-exact-caption1" color="-exact-secondary-label" padding-left=(thread.group ? 50 : 14)
                            margin-bottom=2
                        // in a group, the sender's picture sits beside the last bubble of their run.
                        row position="relative" max-width="80%" min-width=0 padding-left=(thread.group and not m.isOwn ? 36 : 0)
                          padding-bottom=(m.endsRun and m.balloon ? 6.65 : 0)
                          if thread.group and not m.isOwn and m.endsRun
                            view position="absolute" left=0 bottom=(m.balloon ? 6.65 : 0)
                              Face(picture=m.senderPicture, initials=m.senderInitials, size=28)
                          column align-items=(m.isOwn ? "flex-end" : "flex-start") gap=2 min-width=0
                            // a photo keeps its shape while it downloads; a tap opens it, zooming out of its box. A swipe
                            // right answers a photo, a video, a sticker or a file, as a text's bubble (SwipeReply).
                            if m.isImage
                              SwipeReply(reply=startReply(m.id, m.isOwn ? "You" : m.senderName, messageLine(m)), open=showPhoto(m.id),
                                hold=holdMedia(m.id, "photo", m.isOwn ? "You" : m.senderName, m.isOwn, messageLine(m)), label=(m.body != "" ? m.body : "Photo"),
                                identifier=`photo-${m.id}`)
                                view opacity=(held == m.id ? 0 : 1) width=`${m.photoWidth}rem` max-width="100%"
                                  aspect-ratio=(m.imageWidth > 0 and m.imageHeight > 0 ? `${m.imageWidth} / ${m.imageHeight}` : "4 / 3")
                                  border-radius=18 overflow="hidden" background-color="-exact-secondary-background" position="relative"
                                  if m.image != ""
                                    image m.image width="100%" height="100%" object-fit="cover" opacity=(m.state == "sending" ? 0.6 : 1) aria-label=""
                                  // a photo on its way: its upload's ring over a dark disc, at its middle.
                                  if m.state == "sending"
                                    view position="absolute" inset=0 display="flex" align-items="center" justify-content="center"
                                      view width=44 height=44 border-radius=22 background-color="media.scrim" display="flex"
                                        align-items="center" justify-content="center" testId=`upload-${m.id}`
                                        UploadRing(fraction=max(0, m.progress), size=32, color="#ffffff", track="rgba(255, 255, 255, 0.3)")
                            if m.isVideo
                              SwipeReply(reply=startReply(m.id, m.isOwn ? "You" : m.senderName, messageLine(m)), open=showVideo(m.id),
                                hold=holdMedia(m.id, "video", m.isOwn ? "You" : m.senderName, m.isOwn, messageLine(m)), label=videoLabel(m.seconds), identifier=`video-${m.id}`)
                                VideoPoster(poster=m.image, width=m.photoWidth, ratio=(m.imageWidth > 0 and m.imageHeight > 0 ? `${m.imageWidth} / ${m.imageHeight}` : "16 / 9"),
                                  seconds=m.seconds, dimmed=(m.state == "sending"))
                            // a sticker opens nothing: its tap lets go of nothing held.
                            if m.isSticker
                              SwipeReply(reply=startReply(m.id, m.isOwn ? "You" : m.senderName, messageLine(m)), open=letGo,
                                hold=holdMedia(m.id, "sticker", m.isOwn ? "You" : m.senderName, m.isOwn, messageLine(m)), label="Sticker", identifier=`sticker-${m.id}`)
                                Sticker(picture=m.image, width=m.photoWidth, ratio=(m.imageWidth > 0 and m.imageHeight > 0 ? `${m.imageWidth} / ${m.imageHeight}` : "1 / 1"))
                            if m.isFile
                              SwipeReply(reply=startReply(m.id, m.isOwn ? "You" : m.senderName, messageLine(m)), open=openFile(m.id),
                                hold=holdMedia(m.id, "file", m.isOwn ? "You" : m.senderName, m.isOwn, messageLine(m)), label=`${m.fileName}, ${fileDetail(m.fileName, m.fileSize)}`,
                                identifier=`file-${m.id}`)
                                FileBubble(name=m.fileName, size=m.fileSize, outgoing=m.isOwn, progress=(m.state == "sending" ? max(0, m.progress) : -1),
                                  opening=(opening == m.id and pending(opened)), stacked=viewport.accessibilityTextSize)
                            // a voice message plays here; a swipe right answers it and a long press holds it, as a text's bubble.
                            if m.isAudio
                              box position="relative" max-width="100%" user-select="none" touch-action="pan-y" transition="translate -exact-spring(300, 30, 1)"
                                opacity=(held == m.id ? 0 : 1) swiperight=startReply(m.id, m.isOwn ? "You" : m.senderName, messageLine(m))
                                contextmenu=holdMedia(m.id, "voice", m.isOwn ? "You" : m.senderName, m.isOwn, messageLine(m)) testId=`voice-swipe-${m.id}`
                                view swipeIndicator=true position="absolute" right="calc(100% + 14px)" top=0 bottom=0
                                  display="flex" align-items="center" opacity=0 scale=0.4 aria-hidden=true
                                  transition="opacity -exact-spring(900, 60, 1), scale -exact-spring(900, 60, 1)"
                                  image "symbol:icon.arrowshape-turn-up-left" font-size="min(-exact-body, 28px)" color="-exact-secondary-label"
                                VoiceBubble(bars=m.bars, seconds=m.seconds, outgoing=m.isOwn, current=(voicePlaying == m.id and voiceRoom == openRoom),
                                  playing=(voicePlaying == m.id and voiceRoom == openRoom and not voicePaused and voiceSrc != ""),
                                  loading=(voicePlaying == m.id and voiceSrc == "" and not failed(voiceFile)), time=voiceTime, speed=voiceSpeed,
                                  dimmed=(m.state == "sending"), stacked=viewport.accessibilityTextSize, play=playVoice(m.id), speedUp=speedUp,
                                  identifier=`voice-${m.id}`)
                              // its transcript under it (transcribe-members.contract): the words heard while it is
                              // made, then the text, kept across launches by its sound file's name.
                              if transcribing == m.id and transcribeRoom == openRoom
                                text (heardSoFar != "" ? heardSoFar : "Transcribing…") font="-exact-footnote" color="-exact-secondary-label"
                                  max-width="100%" padding="2px 8px" testId=`transcribing-${m.id}`
                              for t in transcripts.filter(x => x.key == m.audioKey and m.audioKey != "") key=t.key
                                text (t.text != "" ? t.text : (t.problem == "noSpeech" ? "No speech in this voice message." : "Couldn’t transcribe this voice message on this iPhone."))
                                  font="-exact-subheadline" color=(t.text != "" ? "-exact-label" : "-exact-secondary-label") max-width="100%"
                                  padding="2px 8px" user-select="text" testId=`transcript-${m.id}`
                            // a message on its way is dimmed; one that failed says so, with a way to send it again.
                            if m.waitingForKey
                              text "Waiting for this message" padding="8px 14px 9px" border-radius=20 font-style="italic"
                                background-color="-exact-fill" color="-exact-secondary-label" testId=`message-${m.id}`
                            else if m.isDeleted
                              text "Message deleted" padding="8px 14px 9px" border-radius=20 font-style="italic"
                                background-color="-exact-fill" color="-exact-secondary-label" testId=`deleted-${m.id}`
                            else if m.balloon or m.bigEmoji
                              if m.hasReply
                                column padding="2px 0 2px 10px" margin="0 6px 2px" border-left="2px solid -exact-separator" max-width="100%"
                                  testId=`quote-${m.id}`
                                  // the name comes a moment after the quote when its sender's profile is not loaded yet.
                                  if m.replyName != ""
                                    text m.replyName font="-exact-caption1" font-weight=600 color="-exact-secondary-label" line-clamp=1
                                      testId=`quote-name-${m.id}`
                                  text m.replyBody font="-exact-footnote" color="-exact-secondary-label" line-clamp=2
                              // a swipe right answers it; a long press opens its reactions and actions. The bubble
                              // follows the finger and, with the transition, springs back when it lets go.
                              box id=`bubble-${m.id}` testId=`bubble-${m.id}` tabindex=0 retainFocus=true user-select="none" max-width="100%"
                                position="relative" touch-action="pan-y" transition="translate -exact-spring(300, 30, 1)"
                                opacity=(held == m.id ? 0 : 1) swiperight=startReply(m.id, m.isOwn ? "You" : m.senderName, m.body)
                                contextmenu=hold(m.id, m.body, m.isOwn ? "You" : m.senderName, m.isOwn, m.endsRun) aria-label=m.body
                                // the reply arrow, left of the bubble's middle: unseen at rest, it grows in as the
                                // swipe nears the 64 points that answer. On release it leaves faster than the bubble
                                // springs back, so it is gone before it reaches a sender's picture. It grows with the
                                // text size, to a cap, so it still fits in the 64 points the bubble leaves.
                                view swipeIndicator=true position="absolute" right="calc(100% + 14px)" top=0 bottom=0
                                  display="flex" align-items="center" opacity=0 scale=0.4 aria-hidden=true
                                  transition="opacity -exact-spring(900, 60, 1), scale -exact-spring(900, 60, 1)"
                                  image "symbol:icon.arrowshape-turn-up-left" font-size="min(-exact-body, 28px)" color="-exact-secondary-label"
                                if m.bigEmoji
                                  BigEmoji(body=m.body, dimmed=(m.state == "sending"), identifier=`message-${m.id}`)
                                else
                                  RichBalloon(runs=m.runs, outgoing=m.isOwn, tail=m.endsRun, dimmed=(m.state == "sending"), identifier=`message-${m.id}`,
                                    open=openLink)
                            if m.isEdited
                              text "Edited" font="-exact-caption2" color="-exact-secondary-label" padding="0 8px" testId=`edited-${m.id}`
                            if m.reactions.length > 0
                              row gap=4 flex-wrap="wrap" justify-content=(m.isOwn ? "flex-end" : "flex-start") margin-top=2
                                for x in m.reactions key=x.key
                                  // a 44-point target around a smaller pill; the margins keep the rows close.
                                  button appearance="none" press=toggleReaction(m.id, x.key) testId=`reaction-${m.id}-${x.key}`
                                    aria-label=`${x.key} ${x.count}` aria-pressed=x.isMine -exact-press-haptic="selection"
                                    min-width=44 min-height=44 margin="-8px 0" display="flex" align-items="center" justify-content="center"
                                    row gap=4 align-items="center" padding="2px 8px" border-radius=12 min-height=28
                                      background-color=(x.isMine ? "-exact-tertiary-fill" : "-exact-quaternary-fill")
                                      border=(x.isMine ? "1px solid AccentColor" : "1px solid transparent")
                                      text x.key
                                      if x.count > 1
                                        text `${x.count}` font="-exact-footnote" font-weight=600 font-variant-numeric="tabular-nums"
                                          color=(x.isMine ? "AccentColor" : "-exact-secondary-label")
                        if m.state == "failed"
                          row gap=12 align-items="center"
                            text "Not Delivered" font="-exact-footnote" color="-exact-system-red" testId=`failed-${m.id}`
                            button press=retry(m.id) disabled=pending(retried) testId=`retry-${m.id}`
                              text "Try Again"
                            button press=discard(m.id) destructive=true disabled=pending(discarded) testId=`discard-${m.id}`
                              text "Delete"
                        if m.status != ""
                          StatusLine(label=seenText(m.status, m.statusTime, shown, time.utcOffset), own=m.isOwn,
                            indent=(thread.group and not m.isOwn ? 36 : 0))
            else
              if failed(thread) and not pending(thread)
                column flex=1 justify-content="center" align-items="center" gap=12 padding=24
                  text "Couldn’t load this chat." color="-exact-secondary-label" testId="thread-error"
                  button press=reloadThread buttonStyle="bordered" testId="thread-retry"
                    text "Try Again"
              else
                column flex=1 justify-content="center" align-items="center"
                  progress aria-label="Loading messages" testId="thread-loading"
            // the reply bar and the composer share one bar in the page's colour: the chat's rows scroll
            // on past the list's frame, and without it they show through the reply and the field.
            if threadShown
              column inert=(held != "") flex-shrink=0 background-color="-exact-background" position="relative" testId="composer-bar"
                // above the bar, at the right, while the newest message is out of view.
                if away and thread.messages.length > 0
                  view position="absolute" bottom="calc(100% + 8px)" right=12
                    JumpButton(count=belowUnread, press=jumpToEnd)
                // this chat's messages waiting on the server (Send Later): how many, and when the first goes.
                match first(openScheduled)
                  case some(m)
                    ScheduledBar(count=openScheduled.length, first=m.at, now=shown, offset=time.utcOffset, open=openScheduledList)
                  case none
                    view
                // an edit's bar takes the reply bar's place, in its look; the reply waits with the draft.
                if editing != ""
                  row align-items="center" gap=8 margin="6px 12px 0" padding-left=12 border-left="2px solid AccentColor" testId="edit-bar"
                    column flex=1 min-width=0
                      text "Editing" font="-exact-caption1" font-weight=600 color="AccentColor"
                      text editOld font="-exact-footnote" color="-exact-secondary-label" line-clamp=2
                    button press=cancelEdit aria-label="Cancel Editing" testId="cancel-edit"
                      image "symbol:close"
                else if composer.replyTo != ""
                  row align-items="center" gap=8 margin="6px 12px 0" padding-left=12 border-left="2px solid AccentColor" testId="reply-bar"
                    column flex=1 min-width=0
                      text `Replying to ${composer.replyName}` font="-exact-caption1" font-weight=600 color="AccentColor"
                      text composer.replyBody font="-exact-footnote" color="-exact-secondary-label" line-clamp=2
                    button press=cancelReply aria-label="Cancel Reply" testId="cancel-reply"
                      image "symbol:close"
                // "+" on the left, as Beeper and Messages have it; the photos and files picked sit above the text.
                row align-items="flex-end" gap=8 margin="6px 12px"
                  AddButton(open=panel, press=togglePanel, disabled=(editing != "" or recording != "idle"))
                  // no HEIC in the list, so the picker hands over an iPhone photo as a JPEG, which the tray can show.
                  input type="file" id="pick-photos" accept="image/jpeg,image/png,image/gif,image/webp" multiple=true display="none"
                    change=photosPicked testId="pick-photos"
                  input type="file" id="pick-files" multiple=true display="none" change=filesPicked testId="pick-files"
                  // a voice message takes the field's place while it records, then as a draft until it goes.
                  if recording == "draft"
                    view flex=1 min-width=0
                      DraftBar(bars=draftBars, seconds=draftSeconds, current=(voicePlaying == "draft"),
                        playing=(voicePlaying == "draft" and not voicePaused), time=voiceTime, preparing=pending(voicePrepared),
                        remove=cancelVoice, play=playVoice("draft"), send=sendVoiceDraft)
                  else if recording != "idle"
                    view flex=1 min-width=0
                      RecordingBar(track=recordTrack, milliseconds=recorderState.duration, starting=(recording != "recording"),
                        cancel=cancelVoice, stop=stopVoice)
                  else
                    column flex=1 min-width=0 border-radius=22 border="1px solid -exact-separator"
                      if composer.attachments.length > 0 and editing == ""
                        Tray(items=composer.attachments, stacked=viewport.accessibilityTextSize, remove=unpick)
                      if tooLarge != ""
                        text `${tooLarge} ${tooLarge.includes(", ") ? "are" : "is"} over ${sizeText(uploadLimit.bytes)}, the most this server takes.`
                          font="-exact-footnote" color="-exact-system-red" padding="8px 12px 0" testId="too-large"
                      // the field's own padding makes it a 44-point target; the row adds none above or below.
                      // a bridged chat's network logo at the field's start says where the message goes, as
                      // the placeholder does ("Reply on WhatsApp").
                      row align-items="flex-end" padding="0 4px 0 12px"
                        if openNetwork != "matrix" and not viewport.accessibilityTextSize
                          ComposerNetwork(network=openNetwork)
                        textarea id="composer" value=(editing != "" ? editText : composer.text) input=editDraft focus=composerFocused rows=1 field-sizing="content" max-height=140
                          placeholder=composerPlaceholder(openNetwork, composer.attachments.length > 0, viewport.accessibilityTextSize)
                          aria-label=replyPlaceholder(openNetwork) testId="composer" flex=1 min-width=0 padding="12px 0"
                          border="none" background-color="transparent"
                        // the voice button while the field is empty and nothing is picked; Send once there is
                        // something to send. While editing, a checkmark saves the edit.
                        if voiceOffered
                          VoiceButton(press=startVoice, disabled=pending(sentVoice))
                        else
                          // a long press offers Send Later's times (send-later-members.contract) where the chat can
                          // have it; it is on a view around Send, as a native button takes no long press.
                          view contextmenu=holdSend contextPopover=(canLater ? "send-later-menu" : "") testId="send-hold"
                            button press=post buttonStyle="filled" margin="4px 0" retainFocus=true testId="send"
                              disabled=(editing != "" ? editText.trim() == "" : ((composer.text.trim() == "" and composer.attachments.length == 0) or pending(sent) or pending(sentMedia)))
                              aria-label=(editing != "" ? "Save Edit" : "Send")
                              image (editing != "" ? "symbol:checkmark" : "symbol:send")
            column id="send-later-menu" popover="auto" role="menu"
              button press=sendLaterAt("tomorrow") popovertarget="send-later-menu" popovertargetaction="hide" testId="later-tomorrow"
                image "symbol:icon.clock"
                text "Tomorrow, 9:00 AM"
              if laterMonday
                button press=sendLaterAt("monday") popovertarget="send-later-menu" popovertargetaction="hide" testId="later-monday"
                  image "symbol:icon.clock"
                  text "Monday, 9:00 AM"
              button press=pickLaterTime popovertarget="send-later-menu" popovertargetaction="hide" testId="later-custom"
                image "symbol:calendar"
                text "Custom Time…"
            if threadShown and panel
              AddPanel(photos=choosePhotos, camera=openCamera, cameraOffered=cameraOffered, files=chooseFiles, gifs=openGifs,
                reduced=viewport.prefersReducedMotion)
            if jumpMissed != "" and jumpMissed == openRoom
              JumpNote(largeText=viewport.accessibilityTextSize)
            ChatBar(name=openName, picture=(match openRoomInfo { case some(r) => r.avatar, case none => "" }),
              initials=(match openRoomInfo { case some(r) => r.initials, case none => "" }), network=openNetwork,
              unread=otherUnread, back=back, pinned=openPinned, pin=togglePinOpen, muted=openMuted, mute=toggleMuteOpen,
              markUnread=markUnreadOpen, info=openInfo, covered=(held != ""), largeText=viewport.accessibilityTextSize)
            // the chat's one player of voice messages: no box of its own; each bubble is its button.
            if voiceSrc != ""
              audio voiceSrc id="voice-player" paused=voicePaused playbackRate=voiceSpeed preservesPitch=true timeupdate=voiceTimed
                ended=voiceEnded pause=voiceStopped play=voiceStarted testId="voice-player"
            // a held message: the chat blurs, the bubble stays where it was, the reactions sit above it
            // and its actions under it, as Beeper and Messages show them.
            if held != ""
              column keycapture=menuKey position="absolute" inset=0 z-index=30 testId="message-menu"
                // the blur reaches past the screen's top and bottom edges too: under the status bar and the home indicator.
                button press=letGo aria-label="Close" position="absolute" top=-120 left=0 right=0 bottom=-60 backgroundMaterial="thin" testId="close-menu"
                column position="absolute" left=12 right=12 gap=10 align-items=(heldOwn ? "flex-end" : "flex-start")
                  padding-left=(thread.group and not heldOwn ? 36 : 0)
                  top=max(76, min(heldY - 64, viewport.height - heldShown - min(heldMenuHeight, heldMenuRoom) - 120))
                  // Beeper's six, then "+" for every emoji.
                  row gap=2 padding=6 border-radius=28 backgroundMaterial="glass" testId="quick-reactions"
                    for k in quickReactions key=k
                      // fixed as Beeper's, a little larger at the largest text sizes, so the bar fits the screen.
                      button appearance="none" press=react(k) min-width=44 min-height=44 border-radius=22 aria-label=k testId=`react-${k}`
                        display="flex" align-items="center" justify-content="center"
                        text k font-size="min(-exact-title1, 30px)"
                    button appearance="none" press=openReactions min-width=44 min-height=44 border-radius=22 aria-label="More Reactions"
                      testId="react-more" display="flex" align-items="center" justify-content="center" background-color="-exact-tertiary-fill"
                      image "symbol:add" font-size="min(-exact-title3, 22px)" color="-exact-label"
                  // a copy of what was held, where it was: a bubble, a large emoji, a picture (a photo, a
                  // video's poster, a sticker) or a file.
                  if heldKind == "photo" or heldKind == "video" or heldKind == "sticker"
                    // the margin keeps the menu clear of the picture, which the host enlarges.
                    view contextTarget=`${heldKind}-${held}` contextMagnify=true width=(heldWidth * heldScale) height=(heldHeight * heldScale)
                      max-width="100%" border-radius=(heldKind == "sticker" ? 0 : 18) overflow="hidden" position="relative"
                      background-color=(heldKind == "sticker" ? "transparent" : (heldKind == "video" ? "media.backdrop" : "-exact-secondary-background"))
                      margin-bottom=14 testId="held-photo"
                      match heldMessage
                        case some(m)
                          if m.image != ""
                            image m.image width="100%" height="100%" object-fit=(heldKind == "sticker" ? "contain" : "cover")
                              aria-label=(m.body != "" ? m.body : messageLine(m))
                        case none
                          view
                      // a video keeps its play mark.
                      if heldKind == "video"
                        view position="absolute" inset=0 display="flex" align-items="center" justify-content="center" aria-hidden=true
                          view width=52 height=52 border-radius=26 background-color="media.scrim" display="flex" align-items="center"
                            justify-content="center"
                            image "symbol:play-fill" font-size="min(-exact-title2, 24px)" color="media.ink" margin-left=3
                  else if heldKind == "file"
                    column contextTarget=`file-${held}` contextMagnify=true width=heldWidth max-width="100%" margin-bottom=6 testId="held-file"
                      match heldMessage
                        case some(m)
                          FileBubble(name=m.fileName, size=m.fileSize, outgoing=m.isOwn, progress=-1, opening=false,
                            stacked=viewport.accessibilityTextSize)
                        case none
                          view
                  else if heldKind == "voice"
                    column contextTarget=`voice-${held}` contextMagnify=true width=heldWidth max-width="100%" margin-bottom=6 testId="held-voice"
                      match heldMessage
                        case some(m)
                          VoiceStill(bars=m.bars, seconds=m.seconds, outgoing=m.isOwn, speed=voiceSpeed, dimmed=false,
                            stacked=viewport.accessibilityTextSize, identifier="held-voice-bubble")
                        case none
                          view
                  else if heldBig
                    column contextTarget=`message-${held}` contextMagnify=true width=heldWidth max-width="100%" testId="held-emoji"
                      BigEmoji(body=heldBody, dimmed=false, identifier="held-big-emoji")
                  else
                    // a bubble cut at the cap keeps round corners where it is cut.
                    column contextTarget=`message-${held}` contextMagnify=true width=heldWidth max-width="100%" max-height=heldCap overflow="hidden"
                      border-radius=(heldHeight > heldCap ? 20 : 0)
                      padding-bottom=6.65
                      Balloon(body=heldBody, outgoing=heldOwn, tail=heldTail, dimmed=false, identifier="held-bubble")
                  // the emoji sheet hides the actions, as Beeper's does: they would show through it.
                  if top(nav).name != "reactions"
                    MessageActions(maxHeight=heldMenuRoom, canShare=heldCanShare, canForward=heldCanForward, canCopy=heldCanCopy, canEdit=heldCanEdit, canDelete=heldCanDelete,
                      reply=startReply(held, heldName, heldBody), share=shareHeld, forward=forwardHeld, copy=copyHeld, canTranscribe=heldCanTranscribe, transcribe=transcribeHeld,
                      markUnread=markUnreadOpen, edit=startEdit, delete=askDeleteMessage)
      // a choice of Send Later's menu the server refused.
      dialog id="later-refused" role="alertdialog" aria-label="Couldn’t Schedule"
        text laterProblem(laterRefused)
        button commandfor="later-refused" command="close" testId="later-refused-ok"
          text "OK"
      dialog id="sign-in-failed" role="alertdialog" aria-label="Couldn’t Sign In"
        text problem testId="problem"
        button commandfor="sign-in-failed" command="close" testId="sign-in-failed-ok"
          text "OK"
      dialog id="delete-chat" role="alertdialog" aria-label=`Delete “${aimedName}”?`
        text deleteMessage(aimedNetwork) testId="delete-chat-message"
        button press=changeAimed("delete") destructive=true commandfor="delete-chat" command="close" testId="delete-chat-confirm"
          text "Delete"
        button commandfor="delete-chat" command="close" testId="delete-chat-cancel"
          text "Cancel"
      dialog id="delete-message" role="alertdialog" aria-label="Delete Message?"
        text deleteMessageText(openNetwork) testId="delete-message-text"
        button press=deleteNow destructive=true commandfor="delete-message" command="close" testId="delete-message-confirm"
          text "Delete for Everyone"
        button commandfor="delete-message" command="close" testId="delete-message-cancel"
          text "Cancel"
      // the microphone was refused once: the system asks no more, so the alert says where to allow it.
      dialog id="microphone-off" role="alertdialog" aria-label="Microphone Access Is Off"
        text "To record a voice message, turn on the microphone for Multiplexer in Settings." testId="microphone-off-text"
        button press=openSettings commandfor="microphone-off" command="close" testId="microphone-settings"
          text "Open Settings"
        button commandfor="microphone-off" command="close" testId="microphone-cancel"
          text "Cancel"
      dialog id="voice-failed" role="alertdialog" aria-label="Couldn’t Record"
        text "The voice message could not be recorded. Try again." testId="voice-failed-text"
        button commandfor="voice-failed" command="close" testId="voice-failed-ok"
          text "OK"
      dialog id="sign-out" role="alertdialog" aria-label="Sign Out?"
        text "This iPhone forgets your session. Your chats stay on the server."
        button press=signOut destructive=true commandfor="sign-out" command="close" testId="sign-out-confirm"
          text "Sign Out"
        button commandfor="sign-out" command="close"
          text "Cancel"
