use Attachment from "./attach.contract"

shape DroppedFiles
  owner: string
  room: string
  items: Attachment[]
  problem: string

members Multiplexer
  state hoveredRoom = ""
  action desktopHover(id: string, hovered: bool)
    if composerSurface.desktop
      if hovered
        hoveredRoom = id
      else if hoveredRoom == id
        hoveredRoom = ""
  mutation droppedFiles as shape DroppedFiles queue then didDropFiles
  state dropProblem = ""
  state dropRoom = ""
  action dismissDropProblem
    dropProblem = ""
  action composeKey(key: string, event: KeyboardEvent)
    if composerSurface.desktop and key == "Enter" and not event.shiftKey and not event.isComposing
      preventDefault()
      post()
  action desktopShortcut(key: string, event: KeyboardEvent)
    if composerSurface.desktop and session.userId != "" and not event.isComposing
      if event.metaKey and not event.altKey and not event.ctrlKey and (key == "n" or key == "N")
        preventDefault()
        openNewConversation()
      else if event.metaKey and not event.altKey and not event.ctrlKey and (key == "k" or key == "K")
        preventDefault()
        keepDraftNow()
        nav = go(nav, path("home"))
        openSearch()
        focus("search-field")
      else if key == "Escape" and top(nav).name == "newConversation"
        preventDefault()
        closeNewConversation()
      else if key == "Escape" and searching
        preventDefault()
        closeSearch()
