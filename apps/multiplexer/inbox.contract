// the inbox's own parts, after Beeper's chat list: the floating bar under the list with its
// filter menu, and the pinned chats above the list. the platform's glass and menus draw them.
use networkName from "./network.contract"

// a pinned chat in the grid. shortName: a person's first name, or a group's whole name.
// unread: unread messages, or marked unread by hand.
shape PinnedChat
  id: string
  name: string
  shortName: string
  avatar: string
  initials: string
  unread: bool

// the filter menu's choices, in Beeper's order; Drafts waits for drafts that the app keeps.
fn filterName(f: string): string = f == "unread" ? "Unread" : (f == "unanswered" ? "Unanswered" : (f == "people" ? "DMs" : (f == "groups" ? "Groups" : "All")))
// what the list says when a filter leaves no chat in it.
fn emptyTitle(f: string): string = f == "unread" ? "No Unread Chats" : (f == "unanswered" ? "No Unanswered Chats" : (f == "people" ? "No DMs" : "No Groups"))
fn emptyMessage(f: string): string = f == "unread" ? "You’ve read every chat." : (f == "unanswered" ? "You answered the last message in every chat." : (f == "people" ? "Chats with one other person show here." : "Chats with more than one other person show here."))
// the lists besides the inbox: the filter sheet's rows and the screen's title.
fn listName(l: string): string = l == "archive" ? "Archive" : (l == "lowPriority" ? "Low Priority" : (l == "reminders" ? "Reminders" : "Inbox"))
// the screen's title: the list, and the name of the filter sheet's network or community
// (scope; "": every chat).
fn listTitle(l: string, scope: string): string = l == "inbox" ? (scope == "" ? "Inbox" : scope) : (scope == "" ? listName(l) : `${scope} ${listName(l)}`)
// what an empty Archive, Low Priority or Reminders says.
fn listEmptyTitle(l: string): string = l == "archive" ? "No Archived Chats" : (l == "reminders" ? "No Reminders" : "No Low Priority Chats")
fn listEmptyMessage(l: string, scope: string): string = l == "reminders" ? `Chats you ask to be reminded about${scope == "" ? "" : ` from ${scope}`} show here until you answer them.` : `${l == "archive" ? "Chats you archive" : "Chats you move to Low Priority"}${scope == "" ? "" : ` from ${scope}`} show here.${l == "archive" ? " A new message brings one back, unless it’s muted." : ""}`
// what Delete's alert says: the chat leaves this app only.
fn deleteMessage(network: string): string = `It leaves Multiplexer on all your devices, but stays ${network == "matrix" ? "on your server" : `in ${networkName(network)}`}. A new message brings it back.`

// the floating bar over the chat list: a round filter button on the left (filled with the accent
// while a filter is on), a capsule in the middle: Inbox (the chosen network's logo when the
// filter sheet chose one), Archive, the list shown selected, then the up-down button that opens
// the filter sheet; and a round search button on the right, which turns into the search's field
// (search.contract's SearchBar). a press on the list shown goes back to its top. glass that comes
// close merges, as the platform's does.
component BottomBar
  props
    filter: string
    choose: action
    top: action
    archive: action
    // the list shown (inbox, archive or lowPriority), the filter sheet's network ("": every
    // network), and what opens the sheet.
    list: string
    network: string
    // the filter sheet's community instead of a network: its name ("" for none) and its picture.
    communityName: string
    communityPicture: string
    sheet: action
    search: action
    // the reader chose one of the accessibility text sizes.
    largeText: bool
  derive inArchive = list == "archive"
  derive inInbox = list == "inbox"
  derive filtered = filter != "all"
  // the symbols grow a little at the accessibility text sizes, and stay inside their glass.
  derive symbolSize = largeText ? 24 : 20
  view
    row position="absolute" left=0 right=0 bottom=0 padding="0 16px" align-items="center" justify-content="space-between"
      glassGroup=12 pointer-events="none" testId="bottom-bar"
      button popovertarget="filter-menu" buttonStyle=(filtered ? "prominent-glass" : "glass") width=48 height=48 pointer-events="auto"
        aria-label=(filtered ? `Filter, ${filterName(filter)}` : "Filter") testId="filter"
        image "symbol:filter" font-size=symbolSize
      row backgroundMaterial="glass" border-radius=24 padding=2 gap=2 pointer-events="auto" testId="bar-capsule"
        button appearance="none" press=top aria-label=(communityName != "" ? communityName : (network == "" ? "Inbox" : networkName(network))) aria-selected=inInbox
          testId="inbox" min-width=68 height=44 border-radius=22 background-color=(inInbox ? "-exact-tertiary-fill" : "transparent")
          display="flex" align-items="center" justify-content="center"
          if communityName != "" and communityPicture != ""
            image communityPicture width=(symbolSize + 4) height=(symbolSize + 4) border-radius=6 object-fit="cover" aria-hidden=true
          else if communityName != ""
            image "symbol:people" font-size=symbolSize color="-exact-label"
          else if network == ""
            image "symbol:icon.tray" font-size=symbolSize color="-exact-label"
          else
            image `assets/networks/${network}.svg` width=(symbolSize + 4) height=(symbolSize + 4) aria-hidden=true
        button appearance="none" press=archive aria-label="Archive" aria-selected=inArchive testId="archive"
          min-width=68 height=44 border-radius=22 background-color=(inArchive ? "-exact-tertiary-fill" : "transparent")
          display="flex" align-items="center" justify-content="center"
          image "symbol:icon.archive" font-size=symbolSize color="-exact-label"
        button appearance="none" press=sheet aria-label="Inboxes" testId="inboxes-button"
          width=44 height=44 border-radius=22 display="flex" align-items="center" justify-content="center"
          image "symbol:chooser" font-size=symbolSize color="-exact-label"
      // its own glass face, as the capsule's: it flies into the search's field (a native button
      // takes no layout transition).
      button appearance="none" press=search backgroundMaterial="glass" width=48 height=48 border-radius=24 pointer-events="auto"
        display="flex" align-items="center" justify-content="center" aria-label="Search" testId="search"
        sharedElement="search" -exact-layout-transition="340ms cubic-bezier(.32,.72,0,1)"
        image "symbol:search" font-size=symbolSize color="-exact-label"
      column id="filter-menu" popover="auto" role="menu" pointer-events="auto"
        for f in ["all", "unread", "unanswered", "people", "groups"] key=f
          button role="menuitemradio" aria-checked=(filter == f) press=choose(f)
            popovertarget="filter-menu" popovertargetaction="hide" testId=`filter-${f}`
            text filterName(f)

// the pinned chats above the list, as Messages draws them: large round pictures, three to a
// row (a short last row centred), a name under each, and a dot on one with unread messages.
// a long press opens the chat's menu (`menu`, with its preview).
component PinnedGrid
  props
    rooms: PinnedChat[]
    open: action
    aim: action
    menu: string
  view
    row id="pinned" flex-wrap="wrap" justify-content="center" padding="4px 8px 12px" border-bottom="none" testId="pinned"
      for r in rooms key=r.id
        button appearance="none" press=open(r.id) contextmenu=aim(r.id) contextPopover=menu width="33.333%"
          aria-label=(r.unread ? `${r.name}, unread` : r.name) testId=`pinned-${r.id}`
          display="flex" flex-direction="column" align-items="center" gap=6 padding="8px 4px"
          view position="relative" width=80 height=80
            view width=80 height=80 border-radius=40 overflow="hidden" background-color="-exact-tertiary-fill"
              display="flex" align-items="center" justify-content="center"
              if r.avatar != ""
                image r.avatar width="100%" height="100%" object-fit="cover" aria-label=""
              else
                text r.initials font-size="min(-exact-title1, 36px)" font-weight=600 color="-exact-secondary-label"
            if r.unread
              view position="absolute" left=0 top=2 width=18 height=18 border-radius=9 background-color="AccentColor"
                border="3px solid -exact-background" box-sizing="border-box" testId=`pinned-unread-${r.id}`
          text r.shortName font="-exact-subheadline" color="-exact-secondary-label" line-clamp=1 max-width="100%"

// the inbox's title, as Beeper's: its words and a chevron at the top left, which open a menu.
// Select Chats and Merge Chats come later, so they show greyed. The route draws this row in
// place of the system bar, whose large title cannot open a menu.
component TitleMenu
  props
    title: string
    settings: action
    largeText: bool
  view
    row padding="2px 16px 6px" align-items="center" testId="title-bar"
      button popovertarget="title-menu" appearance="none" aria-label=`${title}, menu` testId="title-button"
        display="flex" align-items="center" gap=6 max-width="100%" min-height=44
        text title role="heading" aria-level=1 font="-exact-title1" font-weight=700 color="-exact-label" testId="title"
        image "symbol:icon.chevron-down" font=(largeText ? "-exact-title3" : "-exact-headline") font-weight=600 color="-exact-label"
          aria-hidden=true
      // a row with no press is a break between sections on iOS, so the greyed rows name one,
      // which a disabled row never runs.
      column id="title-menu" popover="auto" role="menu"
        button press=settings disabled=true testId="menu-select-chats"
          image "symbol:select"
          text "Select Chats"
        button press=settings disabled=true testId="menu-merge-chats"
          image "symbol:icon.merge"
          text "Merge Chats"
        button press=settings popovertarget="title-menu" popovertargetaction="hide" testId="menu-settings"
          image "symbol:settings"
          text "Settings"
