// the inbox's own parts, after Beeper's chat list: the floating bar under the list with its
// filter menu, and the pinned chats above the list. the platform's glass and menus draw them.
use networkName from "./network.contract"

// a pinned chat in the grid. shortName: a person's first name, or a group's whole name.
// unread: unread messages, or marked unread by hand.
shape PinnedChat
  id: string
  name: string
  shortName: string
  avatar: string
  initials: string
  unread: bool

// select chats' change on several chats (app.ts's changechats).
shape ChatsChanged
  ok: bool

// the filter menu's choices, in Beeper's order; Drafts waits for drafts that the app keeps.
fn filterName(f: string): string = f == "unread" ? "Unread" : (f == "unanswered" ? "Unanswered" : (f == "people" ? "DMs" : (f == "groups" ? "Groups" : "All")))
// what the list says when a filter leaves no chat in it.
fn emptyTitle(f: string): string = f == "unread" ? "No Unread Chats" : (f == "unanswered" ? "No Unanswered Chats" : (f == "people" ? "No DMs" : "No Groups"))
fn emptyMessage(f: string): string = f == "unread" ? "You’ve read every chat." : (f == "unanswered" ? "You answered the last message in every chat." : (f == "people" ? "Chats with one other person show here." : "Chats with more than one other person show here."))
// the lists besides the inbox: the filter sheet's rows and the screen's title.
fn listName(l: string): string = l == "archive" ? "Archive" : (l == "lowPriority" ? "Low Priority" : (l == "reminders" ? "Reminders" : "Inbox"))
// the screen's title: the list, and the name of the filter sheet's network or community
// (scope; "": every chat).
fn listTitle(l: string, scope: string): string = l == "inbox" ? (scope == "" ? "Inbox" : scope) : (scope == "" ? listName(l) : `${scope} ${listName(l)}`)
// what an empty Archive, Low Priority or Reminders says.
fn listEmptyTitle(l: string): string = l == "archive" ? "No Archived Chats" : (l == "reminders" ? "No Reminders" : "No Low Priority Chats")
fn listEmptyMessage(l: string, scope: string): string = l == "reminders" ? `Chats you ask to be reminded about${scope == "" ? "" : ` from ${scope}`} show here until you answer them.` : `${l == "archive" ? "Chats you archive" : "Chats you move to Low Priority"}${scope == "" ? "" : ` from ${scope}`} show here.${l == "archive" ? " A new message brings one back, unless it’s muted." : ""}`
// what Delete's alert says: the chat leaves this app only.
fn deleteMessage(network: string): string = `It leaves Multiplexer on all your devices, but stays ${network == "matrix" ? "on your server" : `in ${networkName(network)}`}. A new message brings it back.`
// select chats' delete: the same, for several chats.
fn deleteChatsTitle(n: number): string = n == 1 ? "Delete 1 Chat?" : `Delete ${n} Chats?`
fn deleteChatsMessage(n: number): string = `${n == 1 ? "It leaves" : "They leave"} Multiplexer on all your devices, but ${n == 1 ? "stays" : "stay"} on ${n == 1 ? "its" : "their"} network. A new message brings ${n == 1 ? "it" : "each"} back.`
fn selectedTitle(n: number): string = n == 0 ? "Select Chats" : `${n} Selected`

// the floating bar over the chat list: a round filter button on the left (filled with the accent
// while a filter is on), a capsule in the middle: Inbox (the chosen network's logo when the
// filter sheet chose one), Archive, the list shown selected, then the up-down button that opens
// the filter sheet; and a round search button on the right, which turns into the search's field
// (search.contract's SearchBar). a press on the list shown goes back to its top. glass that comes
// close merges, as the platform's does.
component BottomBar
  props
    filter: string
    choose: action
    top: action
    archive: action
    // the list shown (inbox, archive or lowPriority), the filter sheet's network ("": every
    // network), and what opens the sheet.
    list: string
    network: string
    // the filter sheet's community instead of a network: its name ("" for none) and its picture.
    communityName: string
    communityPicture: string
    sheet: action
    search: action
    // the reader chose one of the accessibility text sizes.
    largeText: bool
    // dark mode: the dark material and a black tint, as the chat's composer edge.
    dark: bool
  derive inArchive = list == "archive"
  derive inInbox = list == "inbox"
  derive filtered = filter != "all"
  // the symbols grow a little at the accessibility text sizes, and stay inside their glass.
  derive symbolSize = largeText ? 24 : 20
  view
    // as iOS's scroll edge effect under a floating bar (R06): the rows stay visible under the glass, softened
    // by a thin material that is full at the screen's bottom edge and fades out a little above the bar. The
    // chat screen's top and composer use the same values. Under Reduce Transparency, UIKit draws the material
    // solid. Outside the bar's glass group, so its glass stays its own. In dark mode "ultra-thin" lifted the
    // black page to a grey band (about #25 at the bottom edge); the "dark" material and the chat's
    // chat.edge-bottom tint keep it near black.
    view position="absolute" left=0 right=0 bottom=0 pointer-events="none"
      view position="absolute" left=0 right=0 top=-24 bottom=-40 backgroundMaterial=(dark ? "dark" : "ultra-thin")
        mask-image="linear-gradient(to top, black 0%, transparent 100%)"
      view position="absolute" left=0 right=0 top=-24 bottom=-40
        background-image="linear-gradient(to top, chat.edge-bottom 0%, transparent 100%)"
      row position="relative" padding="0 16px" align-items="center" justify-content="space-between"
        glassGroup=12 pointer-events="none" testId="bottom-bar"
        button popovertarget="filter-menu" buttonStyle=(filtered ? "prominent-glass" : "glass") width=48 height=48 pointer-events="auto"
          aria-label=(filtered ? `Filter, ${filterName(filter)}` : "Filter") testId="filter"
          image "symbol:filter" font-size=symbolSize
        row backgroundMaterial="glass" border-radius=24 padding=2 gap=2 pointer-events="auto" testId="bar-capsule"
          button appearance="none" press=top aria-label=(communityName != "" ? communityName : (network == "" ? "Inbox" : networkName(network))) aria-selected=inInbox
            testId="inbox" min-width=68 height=44 border-radius=22 background-color=(inInbox ? "-exact-tertiary-fill" : "transparent")
            display="flex" align-items="center" justify-content="center"
            if communityName != "" and communityPicture != ""
              image communityPicture width=(symbolSize + 4) height=(symbolSize + 4) border-radius=6 object-fit="cover" aria-hidden=true
            else if communityName != ""
              image "symbol:people" font-size=symbolSize color="-exact-label"
            else if network == ""
              image "symbol:icon.tray" font-size=symbolSize color="-exact-label"
            else
              image `assets/networks/${network}.svg` width=(symbolSize + 4) height=(symbolSize + 4) aria-hidden=true
          button appearance="none" press=archive aria-label="Archive" aria-selected=inArchive testId="archive"
            min-width=68 height=44 border-radius=22 background-color=(inArchive ? "-exact-tertiary-fill" : "transparent")
            display="flex" align-items="center" justify-content="center"
            image "symbol:icon.archive" font-size=symbolSize color="-exact-label"
          button appearance="none" press=sheet aria-label="Inboxes" testId="inboxes-button"
            width=44 height=44 border-radius=22 display="flex" align-items="center" justify-content="center"
            image "symbol:chooser" font-size=symbolSize color="-exact-label"
        // its own glass face, as the capsule's: it flies into the search's field (a native button
        // takes no layout transition).
        button appearance="none" press=search backgroundMaterial="glass" width=48 height=48 border-radius=24 pointer-events="auto"
          display="flex" align-items="center" justify-content="center" aria-label="Search" testId="search"
          sharedElement="search" -exact-layout-transition="340ms cubic-bezier(.32,.72,0,1)"
          image "symbol:search" font-size=symbolSize color="-exact-label"
        column id="filter-menu" popover="auto" role="menu" pointer-events="auto"
          for f in ["all", "unread", "unanswered", "people", "groups"] key=f
            button role="menuitemradio" aria-checked=(filter == f) press=choose(f)
              popovertarget="filter-menu" popovertargetaction="hide" testId=`filter-${f}`
              text filterName(f)

// the pinned chats above the list, as Messages draws them: large round pictures, three to a
// row (a short last row centred), a name under each, and a dot on one with unread messages.
// a long press opens the chat's menu (`menu`, with its preview).
component PinnedGrid
  props
    rooms: PinnedChat[]
    open: action
    aim: action
    menu: string
    // select chats: `open` chooses a chat then, and a mark on its picture says so.
    selecting: bool
    chosen: string[]
    busy: bool
  view
    row id="pinned" flex-wrap="wrap" justify-content="center" padding="4px 8px 12px" border-bottom="none" testId="pinned"
      for r in rooms key=r.id
        button appearance="none" press=open(r.id) disabled=busy contextmenu=aim(r.id) contextPopover=(selecting ? "" : menu)
          width="33.333%" aria-label=(r.unread ? `${r.name}, unread` : r.name) testId=`pinned-${r.id}`
          role=(selecting ? "checkbox" : "button") aria-checked=(selecting and chosen.includes(r.id))
          display="flex" flex-direction="column" align-items="center" gap=6 padding="8px 4px"
          view position="relative" width=80 height=80
            view width=80 height=80 border-radius=40 overflow="hidden" background-color="-exact-tertiary-fill"
              display="flex" align-items="center" justify-content="center"
              if r.avatar != ""
                image r.avatar width="100%" height="100%" object-fit="cover" aria-label=""
              else
                text r.initials font-size="min(-exact-title1, 36px)" font-weight=600 color="-exact-secondary-label"
            if r.unread
              view position="absolute" left=0 top=2 width=18 height=18 border-radius=9 background-color="AccentColor"
                border="3px solid -exact-background" box-sizing="border-box" testId=`pinned-unread-${r.id}`
            if selecting
              view position="absolute" right=0 bottom=0 border-radius=14 background-color="-exact-background" padding=2
                ChooseMark(on=chosen.includes(r.id), identifier=`pinned-mark-${r.id}`)
          text r.shortName font="-exact-subheadline" color="-exact-secondary-label" line-clamp=1 max-width="100%"

// the inbox's title, as Beeper's: its words and a chevron at the top left, which open a menu.
// Select Chats, Merge Chats and Settings. The route draws this row in place of the system bar,
// whose large title cannot open a menu.
// the inbox's top edge (R05), as Beeper's: the title, or Select Chats' count, over the chats, which scroll on
// under it and under the status bar, softened by the same material recipe as the bottom bar (one ultra-thin
// or dark layer plus chat.edge-bottom, full under the status bar, fading out just below the title). In the
// list it is the first row, sticky: at rest it holds its natural height above the first chat at any text
// size, and while scrolling it stays on top. Under the status bar: the list starts 62 points higher (the
// status bar of the largest iPhones), so the header pads those points back. Under Reduce Transparency,
// UIKit draws the material solid.
component InboxHeader
  props
    title: string
    selecting: bool
    count: number
    done: action
    busy: bool
    problem: string
    select: action
    settings: action
    merge: action
    largeText: bool
    // in the list, which starts under the status bar.
    underStatusBar: bool
    // the list is scrolled from its top: chats are under the header. At rest the material is not drawn, as
    // UIKit's scroll edge effect is not over a list at rest: over nothing it would show only its grey tint.
    scrolled: bool
    // Reduce Transparency: a solid fade in place of the blur. dark: the dark material, the faintest grey
    // over a black page.
    solid: bool
    dark: bool
  view
    // its own bottom edge: no list separator under the title (the line above the pinned chats).
    column id="inbox-header" position="sticky" top=0 z-index=2 flex-shrink=0 padding-top=(underStatusBar ? 62 : 0) border-bottom="none"
      testId="inbox-header"
      // soft edge over the list: one ultra-thin material (even in dark — the bottom bar's "dark"
      // material plus tint blacked out the title), full under the status bar, then open through the
      // title. The title itself stays readable as white text; rows show as blur under it.
      view position="absolute" left=0 right=0 top=0 bottom=0 pointer-events="none" opacity=(scrolled ? 1 : 0) transition="opacity 150ms ease"
        if solid
          view position="absolute" top=0 left=0 right=0 bottom=-12
            background-image="linear-gradient(to bottom, -exact-background 0%, -exact-background 35%, transparent 100%)"
        else
          view position="absolute" top=0 left=0 right=0 bottom=-12 backgroundMaterial="ultra-thin"
            mask-image="linear-gradient(to bottom, black 0%, black 35%, transparent 100%)"
      // the list's first row has a top line the app cannot hide (finding 49): at rest it sits at the
      // screen's top edge, so the page's colour covers it there.
      if underStatusBar
        view position="absolute" left=0 right=0 top=0 height=1 pointer-events="none" background-color="-exact-background"
          opacity=(scrolled ? 0 : 1)
      if selecting
        SelectTitle(count=count, done=done, busy=busy)
      else
        TitleMenu(title=title, select=select, settings=settings, merge=merge, largeText=largeText)
      if selecting and problem != ""
        text problem role="alert" font="-exact-footnote" color="-exact-system-red" padding="4px 16px 8px" testId="select-error"

component TitleMenu
  props
    title: string
    select: action
    settings: action
    // Merge Chats' sheet (merge.contract).
    merge: action
    largeText: bool
  view
    row padding="2px 16px 6px" align-items="center" testId="title-bar"
      button popovertarget="title-menu" appearance="none" aria-label=`${title}, menu` testId="title-button"
        display="flex" align-items="center" gap=6 max-width="100%" min-height=44
        text title role="heading" aria-level=1 font="-exact-title3" font-weight=700 color="-exact-label" testId="title"
        image "symbol:icon.chevron-down" font=(largeText ? "-exact-headline" : "-exact-subheadline") font-weight=600 color="-exact-label"
          aria-hidden=true
      // a row with no press is a break between sections on iOS, so the greyed rows name one,
      // which a disabled row never runs.
      column id="title-menu" popover="auto" role="menu"
        button press=select popovertarget="title-menu" popovertargetaction="hide" testId="menu-select-chats"
          image "symbol:select"
          text "Select Chats"
        button press=merge popovertarget="title-menu" popovertargetaction="hide" testId="menu-merge-chats"
          image "symbol:icon.merge"
          text "Merge Chats"
        button press=settings popovertarget="title-menu" popovertargetaction="hide" testId="menu-settings"
          image "symbol:settings"
          text "Settings"

// select chats' mark on a row or a pinned picture: an empty circle, or the accent's filled check.
component ChooseMark
  props
    on: bool
    identifier: string
  view
    image (on ? "symbol:select-fill" : "symbol:circle") font-size="min(-exact-title2, 28px)" color=(on ? "AccentColor" : "-exact-tertiary-label")
      aria-hidden=true testId=identifier

// the title row while choosing chats: how many are chosen, and done, which ends the mode. at the
// largest text sizes done goes under the count rather than squeezing it.
component SelectTitle
  props
    count: number
    done: action
    busy: bool
  view
    row padding="2px 16px 6px" align-items="center" flex-wrap="wrap" column-gap=12 row-gap=4 min-height=50 testId="select-title"
      text selectedTitle(count) role="heading" aria-level=1 font="-exact-title3" font-weight=700 color="-exact-label" flex="1 1 12rem"
        min-width=0 testId="select-count"
      if busy
        progress aria-label="Updating chats" testId="select-progress"
      button press=done disabled=busy buttonStyle="glass" margin-left="auto" testId="select-done"
        text "Done" font-weight=600

// the bar under the list while choosing chats, in the place of the inbox's bar: archive (or
// unarchive in the archive), mark as read (or unread), mute (or unmute), more (low priority and
// pin), and delete in red. with nothing chosen, all are off.
component SelectBar
  props
    count: number
    archived: bool
    lowPriority: bool
    unread: bool
    muted: bool
    pinned: bool
    change: action
    delete: action
    labelChats: action
    // Merge Chats with the chosen chats: two or more that are not merged already.
    canMerge: bool
    merge: action
    largeText: bool
    busy: bool
    // dark mode: the dark material and a black tint under the bar.
    dark: bool
  derive off = count == 0 or busy
  derive symbolSize = largeText ? 24 : 20
  view
    // as iOS's scroll edge effect under a floating bar (R06): the rows stay visible under the glass, softened
    // by a thin material that is full at the screen's bottom edge and fades out a little above the bar. The
    // chat screen's top and composer use the same values. Under Reduce Transparency, UIKit draws the material
    // solid. Outside the bar's glass group, so its glass stays its own. In dark mode "ultra-thin" lifted the
    // black page to a grey band (about #25 at the bottom edge); the "dark" material and the chat's
    // chat.edge-bottom tint keep it near black.
    view position="absolute" left=0 right=0 bottom=0 pointer-events="none"
      view position="absolute" left=0 right=0 top=-24 bottom=-40 backgroundMaterial=(dark ? "dark" : "ultra-thin")
        mask-image="linear-gradient(to top, black 0%, transparent 100%)"
      view position="absolute" left=0 right=0 top=-24 bottom=-40
        background-image="linear-gradient(to top, chat.edge-bottom 0%, transparent 100%)"
      row position="relative" padding="0 16px" align-items="center" justify-content="space-between"
        glassGroup=12 pointer-events="none" testId="select-bar"
        row backgroundMaterial="glass" border-radius=24 padding=2 gap=2 pointer-events="auto" testId="select-capsule"
          button appearance="none" press=change(archived ? "unarchive" : "archive") disabled=off
            aria-label=(archived ? "Unarchive" : "Archive") testId="select-archive"
            width=56 height=44 border-radius=22 display="flex" align-items="center" justify-content="center" opacity=(off ? 0.35 : 1)
            image (archived ? "symbol:icon.unarchive" : "symbol:icon.archive") font-size=symbolSize color="-exact-label"
          button appearance="none" press=change(unread ? "read" : "unread") disabled=off
            aria-label=(unread ? "Mark as Read" : "Mark as Unread") testId="select-read"
            width=56 height=44 border-radius=22 display="flex" align-items="center" justify-content="center" opacity=(off ? 0.35 : 1)
            image (unread ? "symbol:messages" : "symbol:icon.mark-unread") font-size=symbolSize color="-exact-label"
          button appearance="none" press=change(muted ? "unmute" : "mute") disabled=off
            aria-label=(muted ? "Unmute" : "Mute") testId="select-mute"
            width=56 height=44 border-radius=22 display="flex" align-items="center" justify-content="center" opacity=(off ? 0.35 : 1)
            image (muted ? "symbol:notifications" : "symbol:icon.bell-slash") font-size=symbolSize color="-exact-label"
          button appearance="none" popovertarget="select-more" disabled=off aria-label="More" testId="select-more-button"
            width=56 height=44 border-radius=22 display="flex" align-items="center" justify-content="center" opacity=(off ? 0.35 : 1)
            image "symbol:more" font-size=symbolSize color="-exact-label"
        button appearance="none" press=delete disabled=off backgroundMaterial="glass" width=48 height=48 border-radius=24
          pointer-events="auto" display="flex" align-items="center" justify-content="center" aria-label="Delete" testId="select-delete"
          opacity=(off ? 0.35 : 1)
          image "symbol:delete" font-size=symbolSize color="-exact-system-red"
        column id="select-more" popover="auto" role="menu" pointer-events="auto"
          button press=labelChats disabled=off popovertarget="select-more" popovertargetaction="hide" testId="select-label"
            image "symbol:icon.tag"
            text "Label…"
          button press=change(lowPriority ? "inbox" : "lowPriority") popovertarget="select-more" popovertargetaction="hide"
            testId="select-low-priority"
            image (lowPriority ? "symbol:icon.tray" : "symbol:icon.low-priority")
            text (lowPriority ? "Move to Inbox" : "Move to Low Priority")
          button press=change(pinned ? "unpin" : "pin") popovertarget="select-more" popovertargetaction="hide" testId="select-pin"
            image (pinned ? "symbol:icon.pin-slash" : "symbol:pin")
            text (pinned ? "Unpin" : "Pin")
          if canMerge
            button press=merge popovertarget="select-more" popovertargetaction="hide" testId="select-merge"
              image "symbol:icon.merge"
              text "Merge Chats"
