members Multiplexer
  state flightPhase = 0
  state flightId = ""
  state flightRoom = ""
  state flightRoute = ""
  state flightDraft = ""
  state flightReply = ""
  state flightSerial = 0
  state flightAt = 0
  state squashAt = 0
  state flightBottom = 0
  state fieldBottom = 0
  state fieldX = 0
  state fieldRight = 0
  state flierBottom = 0
  state flightScale = 1
  state flightSlide = 0
  state flightReach = 0
  state flightNarrow = 0
  state flightShift = 0
  state flightRise = 0
  derive flightMessage = first(thread.messages.filter(m => m.presentationId == flightId))
  // the field keeps the width the message leaves from until it has risen clear (the swell, 185 ms on).
  derive flightHoldsField = flightPhase > 0 and flightPhase < 4 and flightRoom == openRoom
  // the sent row's receipt waits for the landing, as the template's does.
  derive flightHidesReceipt = flightPhase > 0 and flightRoom == openRoom
  derive flightNarrowed = flightPhase >= 3 ? flightNarrow : 0
  derive flightMotion = flightPhase >= 3 ? "translate -exact-spring(141.759, 17.3503, 1), scale -exact-spring(310, 38, 2), opacity 200ms ease-in" : "none"
  derive swellMotion = flightPhase >= 4 ? "scale -exact-spring(320, 38, 2)" : "none"
  derive narrowMotion = flightPhase >= 3 ? "translate 200ms cubic-bezier(0.541951, 0, 0.58, 1)" : "none"

  action beginSendFlight(id: string)
    let pageFrame = frame("conversation")
    let pill = frame("composer-glass")
    flightRoom = openRoom
    flightRoute = `${top(nav).id}`
    flightDraft = composer.text
    flightReply = composer.replyTo
    flightSerial = flightSerial + 1
    flightId = id
    flightAt = performanceNow()
    flightPhase = viewport.prefersReducedMotion or pageFrame.unavailable or pill.unavailable ? 0 : 1
    flightBottom = pageFrame.y + pageFrame.height - pill.y - pill.height
    fieldBottom = pill.y + pill.height
    fieldX = pill.x
    fieldRight = pill.x + pill.width
    flightScale = 0.7 + 0.2 * min(1, max(0, (pill.height - 40.3333) / (6 * 40.3333)))
    flightSlide = 0
    flightShift = 0
    flightRise = 0
    flightReach = 0
    flightNarrow = 0

  action sentText
    if failed(sent)
      flightPhase = 0

  action animateSend
    let stamp = performanceNow()
    if flightRoom != openRoom or flightRoute != `${top(nav).id}` or top(nav).name != "room" or page.visibilityState != "visible" or viewport.prefersReducedMotion
      flightPhase = 0
      handOffSend()
    else if failed(sent)
      flightPhase = 0
    else if flightPhase == 1
      let flier = frame("flying-balloon")
      if not flier.unavailable and not flier.provisional
        let x = sendOrigin.available ? sendOrigin.x : fieldX
        let right = sendOrigin.available ? sendOrigin.x + sendOrigin.width : fieldRight
        if sendOrigin.available
          let pageFrame = frame("conversation")
          flightBottom = flightBottom + flier.y + flier.height - pageFrame.y - sendOrigin.bottom
          fieldBottom = pageFrame.y + sendOrigin.bottom
          flierBottom = pageFrame.y + sendOrigin.bottom
        else
          flierBottom = flier.y + flier.height
        let slide = right - flier.x - flier.width
        flightSlide = slide
        flightReach = x - frame("send-flight").x - slide
        flightNarrow = flier.x - x + slide
        let words = frame("flying-message-text")
        flightShift = x + 14 - slide - (words.unavailable ? flier.x + 14 : words.x)
        flightPhase = 2
        flightAt = stamp
        handOffSend()
      else if stamp - flightAt > 500
        flightPhase = 0
        handOffSend()
    else if flightPhase == 2 and stamp - flightAt >= 16
      flightShift = 0
      flightSlide = 0
      flightPhase = 3
      squashAt = stamp
    else if flightPhase >= 2 and stamp - flightAt > 2500
      flightPhase = 0
    else if flightPhase >= 3 and stamp - squashAt >= 995
      flightPhase = 0
    else if flightPhase >= 3
      if flightPhase == 3 and stamp - squashAt >= 185
        flightPhase = 4
      if stamp - squashAt >= 55
        let target = match flightMessage { case some(m) => m.id, case none => flightId }
        let row = frame(`bubble-${target}`)
        let container = frame(`row-${target}`)
        if not row.unavailable and not row.provisional and not container.unavailable and not container.provisional
          let below = container.y + container.height - row.y - row.height
          let end = fieldBottom - frame("composer-glass").height - 6 - (composerSurface.desktop ? 8 : 0) - below
          let bottom = min(row.y + row.height, end)
          if max(bottom - flierBottom - flightRise, flierBottom + flightRise - bottom) > 0.5
            flightRise = bottom - flierBottom
  task failedTextSend when failed(sent)
    after(1, restoreSendDraft)
  task sendingFlight when flightPhase > 0
    every(frame, animateSend)
