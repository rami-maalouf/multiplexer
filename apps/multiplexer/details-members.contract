// the chat screen's state and actions for its details (details.contract): the "New" line kept
// while the chat is open, the jump to the newest message, the video viewer, and links.
use VideoFile from "./details.contract"
use opensInApp from "./network.contract"
use openBrowser, inAppBrowserStatus, InAppBrowserStatus, BrowserResult from "@exact/in-app-browser"

members Multiplexer
  // the first message that was unread when the chat opened: its "New" line stays while the chat
  // is open, though reading the chat moves the read receipt past it. newLineRoom: the chat it is of.
  state newLine = ""
  state newLineRoom = ""
  // the chat moves to its "New" line as it opens; that move is not the reader leaving the newest
  // message, which would read the chat (app.contract's scrolled).
  state placing = false
  // the list asked for older messages while the chat moved to its line (app.contract's loadOlder).
  state olderWanted = false
  derive shownVideo = top(nav).name == "video" ? top(nav).params.message : ""
  derive shownVideoMessage = first(thread.messages.filter(m => m.id == shownVideo))
  resource video = loadVideo(openRoom, shownVideo) as shape VideoFile else empty()
  // the unread messages (others', from the "New" line on) that have been in view since the chat
  // opened: a row says so as it comes into view (sawMessage).
  state seenUnread: string[] = []
  derive newLineAt = newLine != "" and newLineRoom == openRoom ? thread.messages.map(m => m.id).indexOf(newLine) : -1
  // the chat's unread count, which reading its newest message clears.
  derive roomUnread = match openRoomInfo { case some(r) => r.unread, case none => 0 }
  // the unread messages the jump to the newest passes, as Beeper counts them: those below the
  // "New" line not yet in view, which scrolling down lowers (reaching the newest message sees
  // them all: app.contract's scrolled); with no line (none unread when the chat opened, or the
  // first further back than the chat pages), the chat's unread count.
  derive belowUnread = (newLineAt >= 0
    ? thread.messages.slice(newLineAt).filter(m => not m.isOwn and not seenUnread.includes(m.id)).length
    : roomUnread)
  // a link's page opens over the chat on iOS (Safari's view, Done comes back), else in the browser.
  resource browser = inAppBrowserStatus() as shape InAppBrowserStatus else empty(available=false, overApp=false)
  mutation browsed as shape BrowserResult
  // the line is the live answer's: a kept copy has none, and while more is on its way it may be
  // further back than the first answer shows.
  task keepNew when threadShown and newLineRoom != openRoom and (thread.firstUnread != "" or not thread.settling) key=openRoom
    after(1, keepNewLine)
  task forgetNew when openRoom == "" and newLineRoom != ""
    after(1, forgetNewLine)
  task placed when placing
    after(800, donePlacing)

  // as Beeper does, a chat with unread messages opens at its "New" line, with the read ones above
  // it; when they all fit, the chat stays at its newest message.
  action keepNewLine
    newLine = thread.firstUnread
    newLineRoom = openRoom
    seenUnread = []
    // a chat opened at a found message moves there instead (search-members.contract).
    if thread.firstUnread != "" and (jumpEvent == "" or jumpRoom != openRoom)
      placing = true
      let key = match first(thread.messages.filter(m => m.id == thread.firstUnread)) { case some(m) => m.presentationId, case none => thread.firstUnread }
      scrollIntoView("transcript", key, block="center")
  action forgetNewLine
    newLine = ""
    newLineRoom = ""
    seenUnread = []
  // a message's row came into view: below the "New" line, it is no longer below the reader.
  action sawMessage(id: string, e: IntersectionObserverEntry)
    if e.isIntersecting and newLineAt >= 0 and not seenUnread.includes(id)
      seenUnread = seenUnread.concat([id])
  action donePlacing
    placing = false
    if olderWanted and threadShown and not thread.atStart and not pending(older)
      olderWanted = false
      send older = loadOlderMessages(openRoom)
  // to the very end, as far as the transcript scrolls: past the last row's own bottom by the list's
  // padding under the composer and, with the keyboard up, its inset. block="end" stopped the last
  // row at the list's edge, behind the composer. The offset is clamped to the scroll range.
  action jumpToEnd
    scrollIntoView("transcript", lastKey, offset=1000000, behavior="smooth")
  // a tap on a video's poster plays it full screen, zooming out of the poster.
  action showVideo(id: string)
    nav = push(nav, path("video", openRoom, id))
  // a link to a network with its own app (network.contract's opensInApp) goes to that app.
  action openLink(url: string)
    if opensInApp(url)
      openURL(url)
    else if browser.overApp
      send browsed = openBrowser(url=url)
    else
      openURL(url)
