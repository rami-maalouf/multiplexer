// the filter sheet, after Beeper's: the up-down button in the inbox's bar opens it from the
// bottom at half height, and it pulls up to full. Its rows choose which chats the list shows:
// a list (the inbox, the Archive or Low Priority, on every network), or one network's chats in
// the list shown. Each row says how many of its chats are unread, as the list's accent marks
// show them (a muted chat counts only with a mention). The rows that do nothing yet come with
// their tasks (see InboxSheet).
use networkName from "./network.contract"
use ChatLabel from "./labels.contract"

// a network the account has chats on, and how many of them are unread.
shape NetworkCount
  network: string
  unread: number

// a community (a space the account has joined: a WhatsApp community, or a space of Matrix), its
// picture once it is downloaded ("" for none), and how many of its chats are unread.
shape CommunityCount
  id: string
  name: string
  avatar: string
  unread: number

// one row: a symbol or a network's logo, a name, and the unread chats (none when 0). The row
// chosen sits on a light pill, as Beeper shows it. choose(value) chooses it.
component SheetRow
  props
    picture: string
    logo: bool
    // a community's picture: a rounded square, as WhatsApp and Beeper draw one.
    rounded: bool
    name: string
    unread: number
    // what the count counts: "unread", or "scheduled" for Send Later's waiting messages.
    noun: string
    chosen: bool
    value: string
    choose: action
    // the reader chose one of the accessibility text sizes: the picture grows with the name.
    largeText: bool
    identifier: string
  derive side = largeText ? 36 : 26
  // a symbol grows as a logo does, and stays inside the same box.
  derive symbolSize = largeText ? 30 : 22
  view
    // 46 points tall: UIKit draws the half-height sheet a little smaller, and a row stays 44 there.
    button appearance="none" press=choose(value) aria-selected=chosen
      aria-label=(unread > 0 ? `${name}, ${unread} ${noun}` : name) testId=identifier
      display="flex" flex-direction="row" align-items="center" gap=12 min-height=46 padding="6px 14px" margin="0 10px"
      box-sizing="border-box" border-radius=16 background-color=(chosen ? "-exact-tertiary-fill" : "transparent") text-align="start"
      // the box is a little wider than a logo, so the tray symbol, which is wider than tall, fits too.
      view width=(side + 6) height=side flex-shrink=0 display="flex" align-items="center" justify-content="center"
        if logo
          image picture width=side height=side border-radius=(rounded ? side * 0.24 : 0) object-fit="cover" aria-hidden=true
        else if rounded
          // a community with no picture: its place, with the people symbol small inside it.
          view width=side height=side border-radius=(side * 0.24) background-color="-exact-tertiary-fill" display="flex"
            align-items="center" justify-content="center"
            image picture font-size=(side * 0.5) color="-exact-secondary-label" aria-hidden=true
        else
          image picture font-size=symbolSize color="-exact-label" aria-hidden=true
      // at the accessibility text sizes the count goes under the name, so a long word ("WhatsApp")
      // has the row's width; a name longer than that wraps between its words.
      if largeText
        column flex=1 min-width=0
          text name font="-exact-body" color="-exact-label"
          if unread > 0
            text unread.toString() font="-exact-body" color="-exact-secondary-label" font-variant-numeric="tabular-nums"
              testId=`${identifier}-unread`
      else
        text name font="-exact-body" color="-exact-label" flex=1 min-width=0
        if unread > 0
          text unread.toString() font="-exact-body" color="-exact-secondary-label" font-variant-numeric="tabular-nums"
            testId=`${identifier}-unread`

// the sheet's rows, in Beeper's order. list: the list shown (inbox, archive, lowPriority or
// reminders); chosen: the network it shows ("" for every network); community: the community it
// shows ("" for none). A list's row shows that list on every network (chooseList); a network's or
// a community's row shows its chats in the list shown (choose, chooseCommunity).
component InboxSheet
  props
    labels: ChatLabel[]
    activeLabel: string
    chooseLabel: action
    createLabel: action
    renameLabel: action
    deleteLabel: action
    networks: NetworkCount[]
    communities: CommunityCount[]
    community: string
    chooseCommunity: action
    unread: number
    archiveUnread: number
    lowPriorityUnread: number
    list: string
    chosen: string
    choose: action
    chooseList: action
    // the chats with a reminder (Remind Me).
    reminders: number
    // the chats this account is invited to, and the list of them (Requests).
    requests: number
    openRequests: action
    newSpace: action
    // messages waiting on the server, and the list of them (Send Later).
    scheduled: number
    openScheduled: action
    // the saved messages (Bookmarks).
    openBookmarks: action
    largeText: bool
  view
    for l in labels key=l.id
      column id=`label-menu-${l.id}` popover="auto" role="menu"
        button press=renameLabel(l.id) popovertarget=`label-menu-${l.id}` popovertargetaction="hide" testId=`label-rename-${l.id}`
          image "symbol:pencil"
          text "Rename Label"
        button press=deleteLabel(l.id) destructive=true popovertarget=`label-menu-${l.id}` popovertargetaction="hide" testId=`label-delete-${l.id}`
          image "symbol:delete"
          text "Delete Label"
    // up and down only, as the chat list (R01).
    scroll id="inboxes" flex=1 min-height=0 overflow-x="hidden" testId="inboxes"
      column padding="14px 0" gap=4
        SheetRow(rounded=false, picture="symbol:icon.tray", logo=false, name="Inbox", unread=unread, noun="unread", chosen=(list == "inbox" and chosen == "" and community == ""),
          value="inbox", choose=chooseList, largeText=largeText, identifier="inboxes-inbox")
        SheetRow(rounded=false, picture="symbol:icon.archive", logo=false, name="Archive", unread=archiveUnread, noun="unread", chosen=(list == "archive"),
          value="archive", choose=chooseList, largeText=largeText, identifier="inboxes-archive")
        for l in labels key=l.id
          view contextPopover=`label-menu-${l.id}`
            SheetRow(rounded=false, picture="symbol:icon.tag", logo=false, name=l.name, unread=l.unread, noun="unread", chosen=(activeLabel == l.id),
              value=l.id, choose=chooseLabel, largeText=largeText, identifier=`label-filter-${l.id}`)
        SheetRow(rounded=false, picture="symbol:add", logo=false, name="Create Label", unread=0, noun="", chosen=false,
          value="", choose=createLabel, largeText=largeText, identifier="inboxes-create-label")
        SheetRow(rounded=false, picture="symbol:icon.alarm", logo=false, name="Reminders", unread=reminders, noun="chats", chosen=(list == "reminders"),
          value="reminders", choose=chooseList, largeText=largeText, identifier="inboxes-reminders")
        SheetRow(rounded=false, picture="symbol:icon.clock", logo=false, name="Send Later", unread=scheduled, noun="scheduled", chosen=false,
          value="scheduled", choose=openScheduled, largeText=largeText, identifier="inboxes-send-later")
        // no count: the sheet's numbers are for what waits (unread chats, scheduled messages).
        SheetRow(rounded=false, picture="symbol:bookmark", logo=false, name="Bookmarks", unread=0, noun="", chosen=false,
          value="bookmarks", choose=openBookmarks, largeText=largeText, identifier="inboxes-bookmarks")
        SheetRow(rounded=false, picture="symbol:icon.person-badge-plus", logo=false, name="Requests", unread=requests, noun="waiting",
          chosen=false, value="requests", choose=openRequests, largeText=largeText, identifier="inboxes-requests")
        SheetRow(rounded=false, picture="symbol:icon.arrow-down-circle", logo=false, name="Low Priority", unread=lowPriorityUnread, noun="unread",
          chosen=(list == "lowPriority"), value="lowPriority", choose=chooseList, largeText=largeText, identifier="inboxes-low-priority")
        for n in networks key=n.network
          SheetRow(rounded=false, picture=`assets/networks/${n.network}.svg`, logo=true, name=networkName(n.network), unread=n.unread, noun="unread",
            chosen=(chosen == n.network), value=n.network, choose=choose, largeText=largeText, identifier=`inboxes-${n.network}`)
        // the communities after the networks, by name, as Beeper lists WhatsApp's; one with no
        // picture shows the people symbol. The gear, New Space and Edit come under the rows.
        for c in communities key=c.id
          SheetRow(picture=(c.avatar != "" ? c.avatar : "symbol:people"), logo=(c.avatar != ""), rounded=true, name=c.name,
            unread=c.unread, noun="unread", chosen=(community == c.id), value=c.id, choose=chooseCommunity, largeText=largeText,
            identifier=`inboxes-community-${c.id}`)
        SheetRow(rounded=false, picture="symbol:add", logo=false, name="New Space", unread=0, noun="", chosen=false,
          value="new", choose=newSpace, largeText=largeText, identifier="inboxes-new-space")
