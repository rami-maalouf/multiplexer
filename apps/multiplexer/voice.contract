use Appearance from "./appearance.contract"
// voice messages in a chat, as Beeper shows them: a bubble with play, the waveform with its
// progress, the length and one speed for every voice message; and the composer's voice button, the
// bar while a voice message records, and its draft before it goes. Their state and actions are the
// chat screen's (voice-members.contract).
use lengthText from "./details.contract"

// a voice message's sound, downloaded to play; message names it.
shape VoiceFile
  message: string
  path: string

// one bar of a voice message's waveform: how loud its part is, from 0 to 1. id is its place, from 0:
// a key that is not the loop's position keeps `verify` clean (the bars are never inserted or moved).
shape VoiceBar
  id: string
  level: number

// a recording made ready to go: recording is the recorder's file (it plays in the draft), path the
// Ogg Opus file that goes, duration in milliseconds (seconds, whole), waveform the loudness of each
// part for the others, bars the draft's.
shape VoiceDraft
  recording: string
  path: string
  duration: number
  size: number
  waveform: number[]
  seconds: number
  bars: VoiceBar[]

shape VoiceSent
  ok: bool

// "1x", "1.5x", "2x".
fn speedText(speed: number): string = `${speed}x`
// the speed after this one: 1x, 1.5x, 2x, then 1x again.
fn nextSpeed(speed: number): number = speed == 1 ? 1.5 : (speed == 1.5 ? 2 : 1)

// a voice message's waveform: one bar for each part, from its start to its end, as tall as that
// part is loud. While it plays, the bars played are in full ink and the rest faint. With no bars yet
// (a draft's waveform is being measured), a flat line.
component VoiceBars
  props
    bars: VoiceBar[]
    // how much has played, from 0 to 1; -1 when it is not the one playing (every bar in full ink).
    played: number
    ink: string
  view
    row flex=1 min-width=0 height=26 align-items="center" justify-content="space-between" gap=1 aria-hidden=true
      if bars.length == 0
        view flex=1 height=2 border-radius=1 background-color=ink opacity=0.4
      for b, i in bars key=b.id
        view width=2 flex-shrink=0 height=(3 + b.level * 23) border-radius=1 background-color=ink
          opacity=(played < 0 or i < played * bars.length ? 1 : 0.4)

// the round play or pause mark: the ink's disc with the bubble's colour cut out, as Beeper draws it;
// a spinner while the sound downloads.
component VoicePlayMark
  props
    playing: bool
    loading: bool
    ink: string
    fill: string
    size: number
  view
    view width=size height=size border-radius=(size / 2) background-color=ink display="flex" align-items="center" justify-content="center"
      flex-shrink=0
      if loading
        progress aria-label="Loading"
      else
        // it grows with the reader's text a little, to what its disc holds.
        image (playing ? "symbol:pause-fill" : "symbol:play-fill") font-size=(size > 30 ? "min(-exact-subheadline, 14px)" : "min(-exact-footnote, 12px)")
          color=fill margin-left=(playing ? 0 : 2) aria-hidden=true

// a voice message: play, its waveform, its length (the time left once it has played some) and the
// speed chip, which changes the speed of every voice message. Yours in the accent, others' grey, with
// no tail, as Beeper's. At the accessibility text sizes (stacked) the length and the chip go under
// the waveform. VoiceStill draws one with no buttons.
component VoiceBubble
  props
    appearance: Appearance
    bars: VoiceBar[]
    // its length in seconds (0 when the sender did not say: the player's is used once it plays).
    seconds: number
    outgoing: bool
    // it is the one in the player (playing or paused), so its progress shows.
    current: bool
    playing: bool
    loading: bool
    // seconds played, while it is current.
    time: number
    speed: number
    dimmed: bool
    stacked: bool
    play: action
    speedUp: action
    identifier: string
  derive ink = outgoing ? appearance.onFill : "-exact-label"
  derive fill = outgoing ? appearance.bubble : "bubble.incoming"
  derive played = current and seconds > 0 ? min(1, time / seconds) : -1
  derive shown = current and time > 0 ? max(0, ceil(seconds - time)) : seconds
  view
    column id=identifier testId=identifier role="group" aria-label=`Voice message, ${lengthText(seconds)}` gap=4
      width="16.5rem" max-width="100%" box-sizing="border-box" padding=(stacked ? "6px 12px 6px 4px" : "1px 6px 1px 4px")
      border-radius=20 background-color=fill opacity=(dimmed and not outgoing ? 0.6 : 1)
      row align-items="center" gap=8 min-width=0
        // the length in its name, so VoiceOver tells one voice message's button from another's.
        button appearance="none" press=play aria-label=`${playing ? "Pause" : "Play"}, ${lengthText(seconds)}` testId=`${identifier}-play`
          min-width=44 min-height=44 display="flex" align-items="center" justify-content="center" flex-shrink=0
          VoicePlayMark(playing=playing, loading=loading, ink=ink, fill=fill, size=32)
        VoiceBars(bars=bars, played=played, ink=ink)
        if not stacked
          text lengthText(shown) font="-exact-footnote" color=ink font-variant-numeric="tabular-nums" flex-shrink=0
            testId=`${identifier}-time`
          VoiceSpeed(appearance=appearance, speed=speed, outgoing=outgoing, press=speedUp, identifier=`${identifier}-speed`)
      if stacked
        row align-items="center" justify-content="space-between" gap=8 padding-left=6
          text lengthText(shown) font="-exact-footnote" color=ink font-variant-numeric="tabular-nums" testId=`${identifier}-time`
          VoiceSpeed(appearance=appearance, speed=speed, outgoing=outgoing, press=speedUp, identifier=`${identifier}-speed`)

// a voice message as VoiceBubble draws it at rest, with no buttons: a held message's copy, and a
// chat's preview (itself a button).
component VoiceStill
  props
    appearance: Appearance
    bars: VoiceBar[]
    seconds: number
    outgoing: bool
    speed: number
    dimmed: bool
    stacked: bool
    identifier: string
  derive ink = outgoing ? appearance.onFill : "-exact-label"
  derive fill = outgoing ? appearance.bubble : "bubble.incoming"
  view
    column id=identifier testId=identifier role="group" aria-label=`Voice message, ${lengthText(seconds)}` gap=4
      width="16.5rem" max-width="100%" box-sizing="border-box" padding=(stacked ? "6px 12px 6px 4px" : "1px 6px 1px 4px")
      border-radius=20 background-color=fill opacity=(dimmed and not outgoing ? 0.6 : 1)
      row align-items="center" gap=8 min-width=0
        view min-width=44 min-height=44 display="flex" align-items="center" justify-content="center" flex-shrink=0
          VoicePlayMark(playing=false, loading=false, ink=ink, fill=fill, size=32)
        VoiceBars(bars=bars, played=-1, ink=ink)
        if not stacked
          text lengthText(seconds) font="-exact-footnote" color=ink font-variant-numeric="tabular-nums" flex-shrink=0
          view min-width=44 min-height=44 display="flex" align-items="center" justify-content="center" flex-shrink=0
            VoiceSpeedText(appearance=appearance, speed=speed, outgoing=outgoing)
      if stacked
        row align-items="center" justify-content="space-between" gap=8 padding-left=6
          text lengthText(seconds) font="-exact-footnote" color=ink font-variant-numeric="tabular-nums"
          VoiceSpeedText(appearance=appearance, speed=speed, outgoing=outgoing)

// the speed chip: "1x" on a faint fill, in a 44-point target.
component VoiceSpeed
  props
    appearance: Appearance
    speed: number
    outgoing: bool
    press: action
    identifier: string
  view
    button appearance="none" press=press aria-label=`Playback Speed ${speedText(speed)}` testId=identifier min-width=44 min-height=44
      display="flex" align-items="center" justify-content="center" flex-shrink=0 -exact-press-haptic="selection"
      VoiceSpeedText(appearance=appearance, speed=speed, outgoing=outgoing)

component VoiceSpeedText
  props
    appearance: Appearance
    speed: number
    outgoing: bool
  view
    text speedText(speed) font="-exact-caption1" font-size="min(-exact-caption1, 22px)" font-weight=600 font-variant-numeric="tabular-nums"
      color=(outgoing ? appearance.onFill : "-exact-label") padding="3px 7px" border-radius=10 min-width=34 text-align="center" box-sizing="border-box"
      background-color=(outgoing ? "transparent" : "-exact-tertiary-fill")

// beside the composer's field, in its own glass circle as Beeper's, while the field is empty and
// nothing is picked; Send takes its place once there is text.
component VoiceButton
  props
    press: action
    disabled: bool
  view
    button press=press disabled=disabled buttonStyle="glass" width=48 height=48 flex-shrink=0 retainFocus=true
      aria-label="Record Voice Message" testId="voice-record"
      image "symbol:waveform" font-size="min(-exact-title3, 24px)"

// cancel (left) and stop (right) sit outside this capsule, in the + and voice slots, as Beeper's.
// Inside: the red dot, the time and the microphone's live level, with no border, a soft red fill only.
component RecordingBar
  props
    track: string
    milliseconds: number
    starting: bool
  view
    // no stroke: a red border was the old look; fill alone, clipped to the capsule.
    view flex=1 min-width=0 min-height=48 border-radius=24 overflow="hidden" background-color="voice.recording" testId="recording-bar"
      row align-items="center" gap=8 min-height=48 padding="0 14px"
        view width=10 height=10 border-radius=5 background-color="-exact-system-red" flex-shrink=0 aria-hidden=true
        text lengthText(floor(milliseconds / 1000)) font="-exact-body" font-size="min(-exact-body, 24px)" color="-exact-system-red" font-variant-numeric="tabular-nums"
          flex-shrink=0 testId="voice-elapsed" aria-label=`Recording, ${lengthText(floor(milliseconds / 1000))}`
        if starting
          view flex=1
        else
          audio-waveform track=track tint="#ff3b30" flex=1 min-width=0 height=28 testId="voice-level"

// X that replaces "+" while a voice message records or waits as a draft (same mark either way).
component VoiceCancel
  props
    press: action
    // draft: still an X; the test id names the draft so drives can tell it apart.
    draft: bool
  view
    button press=press buttonStyle="glass" width=48 height=48 flex-shrink=0 retainFocus=true
      aria-label=(draft ? "Delete Recording" : "Cancel Recording") testId=(draft ? "voice-delete" : "voice-cancel")
      image "symbol:close" font-size="min(-exact-title3, 24px)"

// stop that replaces the voice button while recording: the whole circle is liquid glass with a
// light red wash; a small red square marks stop (a stop-fill symbol read as a solid red disc).
component VoiceStop
  props
    press: action
    disabled: bool
  view
    button appearance="none" press=press disabled=disabled width=48 height=48 flex-shrink=0 border-radius=24 border-width=0
      backgroundMaterial="glass" background-color="voice.stop-glass" retainFocus=true
      aria-label="Stop Recording" testId="voice-stop"
      display="flex" align-items="center" justify-content="center"
      view width=14 height=14 border-radius=3 background-color="-exact-system-red" aria-hidden=true
// the recording before it goes: play with its waveform and length inside the capsule; Delete and
// Send sit outside in the + and voice slots, as while recording.
component DraftBar
  props
    appearance: Appearance
    bars: VoiceBar[]
    seconds: number
    // the draft is the one in the player (playing or paused).
    current: bool
    playing: bool
    time: number
    play: action
  derive played = current and seconds > 0 ? min(1, time / seconds) : -1
  derive shown = current and time > 0 ? max(0, ceil(seconds - time)) : seconds
  view
    row align-items="center" gap=6 min-height=48 padding="0 10px 0 8px" border-radius=24 testId="voice-draft"
      button appearance="none" press=play aria-label=(playing ? "Pause" : "Play") testId="voice-draft-play" min-width=36 min-height=44
        display="flex" align-items="center" justify-content="center" flex-shrink=0
        VoicePlayMark(playing=playing, loading=false, ink="AccentColor", fill="-exact-background", size=28)
      VoiceBars(bars=bars, played=played, ink="AccentColor")
      text lengthText(shown) font="-exact-footnote" font-size="min(-exact-footnote, 20px)" color="-exact-secondary-label" font-variant-numeric="tabular-nums"
        flex-shrink=0 testId="voice-draft-time"
