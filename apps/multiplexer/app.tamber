tamber multiplexer

theme
  // the tint at the chat's top edge (chat.contract), over its blur: the page's colour, part clear,
  // thicker over the status bar so the clock reads over a bright photo, and the messages still show.
  chat.edge = light-dark(rgba(255, 255, 255, 0.7), rgba(0, 0, 0, 0.7))
  chat.edge-soft = light-dark(rgba(255, 255, 255, 0.35), rgba(0, 0, 0, 0.35))
  // under the floating composer and the home indicator: the messages dimmed more than at the top's
  // edge, so the field's glass stays calm and a black page stays black under the blur's grey.
  chat.edge-bottom = light-dark(rgba(255, 255, 255, 0.55), rgba(0, 0, 0, 0.6))
  // others' bubbles: Messages' grey, opaque so the tail and the body join without a seam.
  bubble.incoming = light-dark(#e9e9eb, #262629)
  // the disc behind a file's icon in your own bubble: the accent's white text, faint, in both schemes.
  bubble.outgoing-disc = rgba(255, 255, 255, 0.22)
  // the disc behind an upload's ring on a photo: it sits on the photo, so it is dark in both schemes.
  media.scrim = rgba(0, 0, 0, 0.5)
  // a video's box before its poster is here: dark in both schemes, as a player is.
  media.backdrop = #1c1c1e scheme=fixed
  // the play mark and the length on a video's poster, over the scrim: white in both schemes.
  media.ink = #ffffff scheme=fixed
  // the field while a voice message records: the system's red, faint.
  voice.recording = light-dark(rgba(255, 59, 48, 0.1), rgba(255, 69, 58, 0.18))
  // the stop mark on the red stop button: white in both schemes.
  voice.on-red = #ffffff scheme=fixed
  // the camera is dark in both schemes, as the phone's camera: black, white ink, the shutter white.
  camera.backdrop = #000000 scheme=fixed
  camera.ink = #ffffff scheme=fixed
  camera.ink-soft = rgba(255, 255, 255, 0.7) scheme=fixed
  camera.ink-faint = rgba(255, 255, 255, 0.6) scheme=fixed
  camera.problem = #ff6961 scheme=fixed

icons
  // private chat labels, with the same native symbol on apple hosts.
  icon.tag = icon(sf "tag", svg "icons/tag.svg")
  // the "+" panel's rows, as Beeper draws them; the svg is for hosts without SF Symbols.
  icon.photos = icon(sf "photo.on.rectangle", svg "icons/photos.svg")
  icon.folder = icon(sf "folder", svg "icons/folder.svg")
  // Beeper's inbox tray, and a pin's Unpin; each has a drawing for the hosts without SF Symbols.
  icon.tray = icon(sf "tray", svg "icons/tray.svg")
  icon.pin-slash = icon(sf "pin.slash", svg "icons/pin-slash.svg")
  // a chat's long-press actions and the capsule's Archive, as Beeper draws them.
  icon.archive = icon(sf "archivebox", svg "icons/archive.svg")
  icon.unarchive = icon(sf "tray.and.arrow.up", svg "icons/unarchive.svg")
  icon.low-priority = icon(sf "text.line.last.and.arrowtriangle.forward", svg "icons/low-priority.svg")
  icon.mark-unread = icon(sf "message.badge", svg "icons/mark-unread.svg")
  icon.bell-slash = icon(sf "bell.slash", svg "icons/bell-slash.svg")
  // the filter sheet's Low Priority row, as Beeper draws it.
  icon.arrow-down-circle = icon(sf "arrow.down.circle", svg "icons/arrow-down-circle.svg")
  // the reply arrow beside a swiped bubble; the svg is Exact's forward arrow, mirrored.
  icon.arrowshape-turn-up-left = icon(sf "arrowshape.turn.up.left", svg "icons/arrowshape-turn-up-left.svg")
  // a held message's Forward, as Beeper draws it; the svg is the reply arrow's, mirrored.
  icon.arrowshape-turn-up-right = icon(sf "arrowshape.turn.up.right", svg "icons/arrowshape-turn-up-right.svg")
  // the chat's jump to its newest message, beside the count of unread messages below, as Beeper draws it.
  icon.arrow-down = icon(sf "arrow.down", svg "icons/arrow-down.svg")
  // search's Videos kind, a recent search, and a found link's page, as Beeper and Safari draw them.
  icon.video = icon(sf "video", svg "icons/video.svg")
  icon.clock = icon(sf "clock", svg "icons/clock.svg")
  icon.alarm = icon(sf "alarm", svg "icons/alarm.svg")
  icon.safari = icon(sf "safari", svg "icons/safari.svg")
  // a chat search's Audio kind and a found voice message, as Beeper draws them.
  icon.waveform = icon(sf "waveform", svg "icons/waveform.svg")
  // the + panel's Search KLIPY, as Beeper draws it.
  icon.number = icon(sf "number", svg "icons/number.svg")
  // a voice message's Transcribe, as lines of text.
  icon.transcribe = icon(sf "text.alignleft", svg "icons/transcribe.svg")
  // the camera's flash (on, off) and its switch between the back and front cameras, as the phone's camera draws them.
  icon.bolt = icon(sf "bolt.fill", svg "icons/bolt.svg")
  icon.bolt-slash = icon(sf "bolt.slash.fill", svg "icons/bolt-slash.svg")
  // the filter sheet's Requests row, as Beeper draws it.
  icon.person-badge-plus = icon(sf "person.badge.plus", svg "icons/person-badge-plus.svg")
  icon.camera-flip = icon(sf "arrow.triangle.2.circlepath.camera", svg "icons/camera-flip.svg")
  // the inbox title menu's Merge Chats.
  icon.merge = icon(sf "arrow.triangle.merge", svg "icons/merge.svg")
  icon.chevron-down = icon(sf "chevron.down", svg "icons/chevron-down.svg")
  // a saved message's Remove Bookmark, in its menu and the list's.
  icon.bookmark-slash = icon(sf "bookmark.slash", svg "icons/bookmark-slash.svg")
