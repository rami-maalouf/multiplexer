// Requests, after Beeper's row of that name in the filter sheet: the chats this account is
// invited to and has not answered (a person or a group asked it in). Each says who asked; Accept
// joins the chat, which then shows in the list; Decline refuses it. (A network's own message
// requests, such as Instagram's, are not invites: not built, see tasks/todo.md, L3.)
use EmptyState from "exact:content"
use Face from "./bubble.contract"

// a request: the chat, its picture once downloaded ("" for none) or its initials, and who invited
// this account (their name, else their id; "" when the invite does not say).
shape ChatRequest
  id: string
  name: string
  isDirect: bool
  inviterId: string
  inviterName: string
  avatar: string
  initials: string

// the account's requests (owner: whose they are, so another account's never show).
shape RequestList
  owner: string
  requests: ChatRequest[]

// an answered request's reply. (A members file cannot name the root's `Reply` shape.)
shape RequestAnswered
  ok: bool

fn inviterLine(r: ChatRequest): string = r.inviterName != "" ? `${r.inviterName} invited you` : (r.inviterId != "" ? `${r.inviterId} invited you` : "You’re invited")

component RequestsScreen
  props
    route: string
    requests: ChatRequest[]
    loaded: bool
    // a request being answered: its buttons wait.
    answering: string
    // why the last answer failed ("" for none).
    refused: string
    close: action
    accept: action
    decline: action
    largeText: bool
  view
    column navigationKey=route navigationScroll="requests" position="absolute" inset=0 display="flex" flex-direction="column"
      testId="requests-screen"
      header display="flex" align-items="center"
        button id="back" press=close aria-label="Back" testId="requests-back"
          image "symbol:back"
        text "Requests" role="heading" aria-level=1
      if requests.length == 0
        if loaded
          EmptyState(symbol="symbol:icon.person-badge-plus", title="No Requests",
            message="When someone invites you to a chat, it waits here until you accept it.")
        else
          column flex=1 justify-content="center" align-items="center"
            progress aria-label="Loading requests" testId="requests-loading"
      else
        list id="requests" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 testId="requests-list"
          if refused != ""
            section
              text refused color="-exact-system-red" testId="requests-refused"
          section
            for r in requests key=r.id
              // the chat and who asked, and the buttons under them, so a long name keeps its two lines.
              view display="flex" flex-direction="column" align-items="stretch" gap=10 padding="10px 16px" testId=`request-${r.id}`
                row gap=12 align-items="center" flex=1 min-width=0
                  Face(picture=r.avatar, initials=r.initials, size=44)
                  column flex=1 min-width=0 gap=2
                    text r.name font="-exact-body" font-weight=600 color="-exact-label" line-clamp=2
                    text inviterLine(r) font="-exact-subheadline" color="-exact-secondary-label" line-clamp=2
                row gap=8 justify-content=(largeText ? "flex-start" : "flex-end") flex-wrap="wrap" padding-left=(largeText ? 0 : 56)
                  button press=decline(r.id) buttonStyle="bordered" disabled=(answering != "") aria-label=`Decline ${r.name}`
                    testId=`request-decline-${r.id}`
                    text "Decline"
                  button press=accept(r.id) buttonStyle="filled" disabled=(answering != "") aria-label=`Accept ${r.name}`
                    testId=`request-accept-${r.id}`
                    text "Accept"
