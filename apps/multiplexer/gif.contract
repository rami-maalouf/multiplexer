// GIFs from KLIPY (B12, D10): the + panel's "Search KLIPY" opens this sheet over the chat, half
// height and pulled up to full, as the reaction sheet. Before any word it shows KLIPY's trending
// GIFs; the words search once typing pauses (gif-members.contract). A tap puts the GIF in the
// composer's tray (caption, remove, add more), and Send posts it: same as photos and videos.
// KLIPY's rules: the field says "Search KLIPY", results keep KLIPY's order, and its media loads
// from its own addresses; "Powered by KLIPY" shows under the grid.
use EmptyState from "exact:content"

// a GIF of the grid: its KLIPY slug (id), its title, and its small animated preview (a WebP of
// KLIPY's) with its size in pixels.
shape Gif
  id: string
  title: string
  preview: string
  width: number
  height: number

// what KLIPY answered for query ("" for trending); failed: KLIPY could not be reached or refused.
shape GifResults
  query: string
  failed: bool
  items: Gif[]

component GifSheet
  props
    // the sheet's route (its stack entry's id).
    route: string
    gifs: GifResults
    query: string
    // the grid answers the words typed (gifs.query is the search that settled).
    shown: bool
    loading: bool
    // a chosen GIF is downloading into the tray: the grid waits.
    picking: bool
    search: action
    pick: action
    close: action
    largeText: bool
  derive typed = query.trim() != ""
  view
    column navigationKey=route navigationPresentation="modal" navigationDetent="medium large" navigationScroll="gif-grid"
      position="absolute" inset=0 display="flex" flex-direction="column" testId="gif-sheet"
      header display="flex" align-items="center" padding="8px 16px"
        text "GIFs" role="heading" flex=1
        button id="back" press=close disabled=picking testId="gif-cancel"
          text "Cancel"
      // KLIPY asks for this placeholder. At the accessibility text sizes the text moves past the magnifier.
      input type="search" inputmode="text" enterkeyhint="search" value=query input=search placeholder="Search KLIPY" aria-label="Search KLIPY"
        margin="4px 16px 8px" font-size="min(-exact-body, 22px)" padding-left=(largeText ? 40 : 0) disabled=picking testId="gif-search"
      if gifs.failed and gifs.items.length == 0
        EmptyState(symbol="symbol:alert", title="Couldn’t Load GIFs", message="KLIPY did not answer. Try again in a moment.")
      else if shown and not loading and gifs.items.length == 0 and typed
        EmptyState(symbol="symbol:search", title="No GIFs Found", message=`Nothing on KLIPY matches “${query.trim()}”.`)
      else if gifs.items.length == 0
        column flex=1 align-items="center" justify-content="center"
          progress aria-label="Loading GIFs" testId="gif-loading"
      else
        scroll id="gif-grid" flex=1 min-height=0 keyboardDismissMode="on-drag" testId="gif-grid"
          // three to a row, as Photos shows pictures; KLIPY's order, left to right.
          row flex-wrap="wrap" padding="0 6px" box-sizing="border-box" width="100%" opacity=((loading or picking) ? 0.5 : 1)
            for g in gifs.items key=g.id
              button appearance="none" press=pick(g.id) disabled=picking aria-label=(g.title != "" ? g.title : "GIF") testId=`gif-${g.id}`
                width="33.333%" aspect-ratio="1" padding=2 box-sizing="border-box"
                image g.preview width="100%" height="100%" object-fit="cover" border-radius=10 background-color="-exact-tertiary-fill"
                  aria-label=""
          text "Powered by KLIPY" font="-exact-footnote" color="-exact-secondary-label" text-align="center"
            padding="14px 16px" padding-bottom="calc(14px + env(safe-area-inset-bottom))" testId="gif-powered-by"
        if picking
          column position="absolute" inset=0 align-items="center" justify-content="center" pointer-events="none" testId="gif-picking"
            progress aria-label="Adding GIF"
