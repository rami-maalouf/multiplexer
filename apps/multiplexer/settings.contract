use Balloon from "./bubble.contract"
use Appearance, AccentBadge, accentPresets from "./appearance.contract"

// Settings, from the inbox's title menu, in the platform's grouped style: the signed-in account,
// whether new messages notify (and a way to allow it), the one speed every voice message plays at
// (the speed chip on a voice message changes the same setting), and Sign Out, which asks first.

// the account as others see it. avatar: its picture once it is downloaded ("" until then, or
// for none), else its initials show. version: the app's.
shape Profile
  userId: string
  name: string
  avatar: string
  initials: string
  version: string

// the account's recovery (encryption-members.contract), for owner: status is on (this iPhone reads
// the backup of the account's message keys), off (the account has none), key (the account has
// one, and this iPhone needs its recovery key), or "" while it is not known.
shape Recovery
  owner: string
  status: string

// what entering a recovery key did: problem is "" when it worked, "wrongKey" for a key that is
// not this account's, else "failed".
shape RecoveryReply
  ok: bool
  problem: string

fn recoveryText(status: string): string = status == "on" ? "On" : (status == "off" ? "Off" : (status == "key" ? "Needs Your Key" : ""))

// the voice note speeds, in the speed chip's order.
fn speeds(): number[] = [1, 1.5, 2]

component SettingsScreen
  props
    // the screen's route (its stack entry's id).
    route: string
    // the signed-in account's id ("" while signed out), and its name and picture.
    userId: string
    profile: Profile
    appearance: Appearance
    chooseAccent: action
    resetAccent: action
    speed: number
    chooseSpeed: action
    signOut: action
    // the account's recovery, the key typed, and what entering it did.
    recovery: Recovery
    recoveryDraft: string
    unlocking: bool
    refused: string
    typeKey: action
    unlock: action
    largeText: bool
    // the notification permission: "granted", "denied", "prompt" (not asked yet) or "unknown".
    notifications: string
    allowNotifications: action
  derive side = largeText ? 72 : 60
  derive shown = profile.userId == userId
  view
    column navigationKey=route navigationScroll="settings" position="absolute" inset=0 display="flex" flex-direction="column"
      testId="settings"
      header display="flex" align-items="center"
        text "Settings" role="heading" aria-level=1 flex=1
      list id="settings" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
        if userId != ""
          section
            // at the accessibility sizes the picture goes above, so the id has the row's width.
            row gap=14 flex-direction=(largeText ? "column" : "row") align-items=(largeText ? "flex-start" : "center") testId="account"
              view width=side height=side border-radius=(side / 2) overflow="hidden" flex-shrink=0
                background-color="-exact-tertiary-fill" display="flex" align-items="center" justify-content="center"
                if shown and profile.avatar != ""
                  image profile.avatar width="100%" height="100%" object-fit="cover" aria-hidden=true testId="account-picture"
                else
                  text (shown ? profile.initials : "") font="-exact-title2" font-weight=600 color="-exact-secondary-label" aria-hidden=true
              column flex=1 min-width=0 max-width="100%" align-self="stretch" gap=2
                text (shown ? profile.name : "") font="-exact-title3" font-weight=600 testId="account-name"
                // an id has no spaces: it may break after its colon and its dots.
                text userId.replaceAll(":", ":\u200B").replaceAll(".", ".\u200B") font="-exact-subheadline" color="-exact-secondary-label" hyphens="none"
                  testId="account-id"
        if userId != "" and notifications != "unknown"
          section
            // at the largest text sizes the button goes under the word, which never breaks inside it.
            row column-gap=12 row-gap=4 align-items="center" flex-wrap="wrap" testId="notifications"
              text "Notifications" flex="1 0 auto"
              if notifications == "prompt"
                button press=allowNotifications testId="allow-notifications"
                  text "Turn On"
              else
                text (notifications == "granted" ? "On" : "Off") color="-exact-secondary-label" testId="notifications-state"
            footer
              text (notifications == "denied" ? "Turn them on in the iPhone's Settings, under Multiplexer." : "A new message shows its chat, its sender and its text.")
        section testId="appearance-settings"
          header
            text "Appearance"
          row gap=12 align-items=(largeText ? "flex-start" : "center") flex-direction=(largeText ? "column" : "row")
            text "Accent Color" flex=1
            row gap=8 align-items="center" flex-shrink=0
              view width=28 height=28 border-radius=14 background-color=appearance.fill border="1px solid -exact-separator" aria-hidden=true
              text appearance.fill font="-exact-footnote" color="-exact-secondary-label" testId="accent-value"
          row
            view display="flex" flex-wrap="wrap" gap=8 role="group" aria-label="Accent presets"
              for preset in accentPresets() key=preset.id
                button press=chooseAccent(preset.color) aria-pressed=(appearance.fill == preset.color)
                  aria-label=preset.name testId=`accent-${preset.id}` appearance="none" min-height=44
                  border=(appearance.fill == preset.color ? "2px solid AccentColor" : "1px solid -exact-separator")
                  border-radius=10 padding="8px 10px"
                  row gap=6 align-items="center"
                    view width=18 height=18 border-radius=9 background-color=preset.color border="1px solid -exact-separator" aria-hidden=true
                    text preset.name
                    if appearance.fill == preset.color
                      image "symbol:checkmark" aria-hidden=true
          row gap=10 align-items="center" justify-content="flex-end" testId="accent-preview"
            AccentBadge(appearance=appearance, label="3", muted=false)
            Balloon(appearance=appearance, body="Your messages", outgoing=true, tail=false, dimmed=false, identifier="accent-preview-bubble")
          row gap=12 align-items=(largeText ? "flex-start" : "center") flex-direction=(largeText ? "column" : "row")
            text "Custom Color" flex=1
            accent-picker selected=appearance.fill message=chooseAccent width=(largeText ? 240 : 100) height=(largeText ? 72 : 44) aria-label="Custom accent color" testId="accent-custom"
          row
            button press=resetAccent disabled=(appearance.fill == "#007aff") testId="accent-reset"
              text "Reset to Default Blue"
          footer
            text "Your messages keep this color. Buttons and links adapt for readability. Saved on this device."
        section
          header
            text "Voice Messages"
          row gap=12 align-items="center" flex-wrap="wrap"
            text "Playback Speed" flex=1
            row role="radiogroup" aria-label="Playback Speed" testId="speed"
              for s in speeds() key=s
                button role="radio" aria-checked=(speed == s) press=chooseSpeed(s) testId=`speed-${s}`
                  text `${s}x`
          footer
            text "Every voice message plays at this speed. The speed button on a voice message changes it too."
        // older encrypted messages: this iPhone reads them once it has the account's recovery key.
        if userId != "" and recovery.owner == userId and recovery.status != ""
          section testId="encryption"
            header
              text "Encryption"
            row gap=12 align-items="center" flex-wrap="wrap"
              text "Recovery" flex=1
              // the one state that asks something of the reader stands out by weight, not a pale colour.
              text recoveryText(recovery.status) color=(recovery.status == "key" ? "-exact-label" : "-exact-secondary-label")
                font-weight=(recovery.status == "key" ? 600 : 400)
                testId="recovery-status"
            if recovery.status == "key"
              row
                input type="password" value=recoveryDraft input=typeKey submit=unlock placeholder="Recovery Key" aria-label="Recovery Key"
                  autocomplete="off" autocapitalize="none" enterkeyhint="done" disabled=unlocking flex=1 min-width=0 testId="recovery-key"
              row
                button press=unlock disabled=(unlocking or recoveryDraft.trim() == "") testId="unlock" flex=1
                  text (unlocking ? "Unlocking…" : "Unlock Older Messages")
            footer
              text (recovery.status == "key"
                ? (refused == "wrongKey" ? "That recovery key is not this account’s. Check it and try again."
                  : (refused != "" ? "Couldn’t unlock. Check the connection and try again."
                    : "Enter the recovery key you saved when you set up recovery, in Element or another app. This iPhone then reads your older encrypted messages."))
                : (recovery.status == "on" ? "This iPhone reads your encrypted messages, older ones too."
                  : "Recovery is off for this account: messages sent before this iPhone signed in stay unreadable in encrypted chats."))
                color=(refused != "" and recovery.status == "key" ? "-exact-system-red" : "-exact-secondary-label") testId="recovery-footer"
        if userId != ""
          section
            row
              button press=signOut destructive=true testId="sign-out" flex=1
                text "Sign Out"
            footer
              text (shown and profile.version != "" ? `Multiplexer ${profile.version}` : "") testId="version"
