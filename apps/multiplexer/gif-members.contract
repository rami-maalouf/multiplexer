// the GIF sheet's state and actions (gif.contract). The words typed search once typing pauses
// for 400 ms, so one search is one call to KLIPY (its test key allows 100 an hour). A tap puts
// the GIF in the composer's tray (Chosen from attach.contract); Send posts it with any caption.
use GifResults from "./gif.contract"
use Attachment, Chosen from "./attach.contract"

members Multiplexer
  // the words typed, and the words the grid searches for (they catch up after the pause).
  state gifQuery = ""
  state gifSearch = ""
  derive gifsOpen = top(nav).name == "gifs"
  resource gifs = loadGifs(gifsOpen, gifSearch) as shape GifResults else empty()
  derive gifsShown = gifs.query == gifQuery.trim()
  // a chosen GIF's file, ready for the tray (path under app:/tmp/gifs).
  mutation stagedGif as shape Chosen then gifAttached
  task settleGifSearch when gifsOpen and gifQuery.trim() != gifSearch key=gifQuery
    after(400, applyGifSearch)

  // the + panel's "Search KLIPY": the panel goes, and the sheet opens on trending GIFs.
  action openGifs
    panel = false
    gifQuery = ""
    gifSearch = ""
    blur("composer")
    nav = push(nav, path("gifs", openRoom))
  action typeGif(v: string)
    gifQuery = v
  action applyGifSearch
    gifSearch = gifQuery.trim()
  // a tap downloads the GIF into the tray; the sheet closes when it is ready. Send posts it.
  action pickGif(id: string)
    if not pending(stagedGif)
      send stagedGif = stageGif(id)
  action gifAttached
    match stagedGif
      case some(c)
        attachPhotos([Attachment(file=c, photo=true)])
        haptic("selection")
        nav = back(nav)
      case none
        stagedGif = stagedGif
