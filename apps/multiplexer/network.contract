// a chat's network as a small logo on the bottom right corner of its picture, as Beeper shows
// it. The logos are assets/networks/<network>.svg (their sources: assets/networks/SOURCES.md).

// a network's name, as the filter sheet shows it and VoiceOver says it.
fn networkName(network: string): string = network == "whatsapp" ? "WhatsApp" : (network == "instagram" ? "Instagram"
  : (network == "messenger" ? "Messenger" : (network == "telegram" ? "Telegram" : (network == "signal" ? "Signal"
  : (network == "discord" ? "Discord" : (network == "linkedin" ? "LinkedIn" : (network == "matrix" ? "Matrix" : network)))))))

// the sites whose own app a link opens, as Beeper does: a reel goes to Instagram, a profile to
// LinkedIn. iOS hands such a link to the app when it is installed, and to Safari when it is not.
// Every other link opens over the chat (details-members.contract's openLink).
fn appSites(): string[] = ["instagram.com", "instagr.am", "facebook.com", "fb.com", "fb.watch", "m.me", "messenger.com",
  "whatsapp.com", "wa.me", "linkedin.com", "lnkd.in", "threads.net", "threads.com", "x.com", "twitter.com", "tiktok.com",
  "youtube.com", "youtu.be", "t.me", "telegram.me", "signal.me", "discord.com", "discord.gg", "spotify.com"]
// a web link's host, lowercased and without its port: "" for anything that is not http or https.
fn linkHost(url: string): string = ((url.toLowerCase().startsWith("https://") or url.toLowerCase().startsWith("http://"))
  ? (match url.toLowerCase().split("/").at(2) { case some(h) => cut(cut(cut(h, "?"), "#"), ":"), case none => "" }) : "")
fn cut(text: string, mark: string): string = match text.split(mark).at(0) { case some(p) => p, case none => text }
fn opensInApp(url: string): bool = appSites().filter(d => hostIs(linkHost(url), d)).length > 0
fn hostIs(host: string, site: string): bool = host == site or host.endsWith(`.${site}`)

// the logo sits in a ring of the list's background, so it stands apart from the picture under
// it. The picture's parent places it: it is outside the picture's clipped box.
component NetworkBadge
  props
    network: string
    identifier: string
  view
    view position="absolute" right=-2 bottom=-2 padding=1.5 border-radius=5 background-color="-exact-background" display="flex"
      testId=identifier
      image `assets/networks/${network}.svg` width=15 height=15 aria-label=networkName(network)

// a merged chat's networks (Merge Chats): each one's logo side by side, at the picture's corner.
component NetworkBadges
  props
    networks: string[]
    identifier: string
  view
    row position="absolute" right=-6 bottom=-2 gap=1 padding=1.5 border-radius=5 background-color="-exact-background"
      testId=identifier
      for n in networks key=n
        image `assets/networks/${n}.svg` width=15 height=15 aria-label=networkName(n)
