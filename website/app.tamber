tamber mux

// mux's brand (docs/brand.md). the site is dark only, as the logo is, so every colour is fixed:
// it is the same in light and dark mode on purpose.
theme
  page = #0C1118  scheme=fixed
  screen = #05080D  scheme=fixed
  notch = #000000  scheme=fixed
  ink = #F2F6FA  scheme=fixed
  ink.soft = #C9D3DE  scheme=fixed
  ink.muted = #9AA7B6  scheme=fixed
  ink.preview = #8A97A6  scheme=fixed
  ink.faint = #808D9D  scheme=fixed
  ink.on-brand = #0C1118  scheme=fixed
  ink.on-blue = #FFFFFF  scheme=fixed
  brand.turquoise = #57DED4  scheme=fixed
  brand.blue = #519AFF  scheme=fixed
  brand.lime = #D4F46A  scheme=fixed
  glass.fill = #FFFFFF09  scheme=fixed
  glass.fill.strong = #FFFFFF0A  scheme=fixed
  glass.field = #FFFFFF12  scheme=fixed
  glass.button = #FFFFFF14  scheme=fixed
  glass.edge = #FFFFFF14  scheme=fixed
  glass.edge.logo = #FFFFFF1A  scheme=fixed
  glass.edge.phone = #FFFFFF24  scheme=fixed
  glass.edge.strong = #FFFFFF2E  scheme=fixed
  line = #FFFFFF0F  scheme=fixed
