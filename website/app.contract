// mux's website: one landing page that says what mux is, why it exists and how it was built.
// every page renders at build (`render=build`): the words are app.ts's, fixed when the site is built,
// so a static host serves `dist/` as it is. `bun exact.mjs web-build --out dist` builds it and
// `bun exact.mjs serve dist` serves it locally.
// the look follows docs/brand.md: deep space behind, glass cards, and the logo's turquoise, blue and lime.
// the site is dark only, as the logo is, so the root says `color-scheme="dark"`.

routes nav
  home "/" render=build
  notfound render=build

shape Chat
  id: string
  name: string
  initials: string
  preview: string
  time: string
  network: string
  unread: number
  hue: string

shape Card
  id: string
  title: string
  body: string

shape Step
  id: string
  step: string
  title: string
  body: string

shape Layer
  id: string
  label: string
  title: string
  body: string
  detail: string

shape Stat
  id: string
  value: string
  label: string

shape Milestone
  id: string
  when: string
  title: string
  body: string
  done: bool

// the brand's three colours as one sweep, for words and small marks.
fn sweep(): string = "linear-gradient(100deg, #57DED4 0%, #519AFF 55%, #D4F46A 100%)"
fn networkName(n: string): string = n == "whatsapp" ? "WhatsApp" : (n == "instagram" ? "Instagram" : "LinkedIn")

style Wrap
  box-sizing="border-box" width="100%" max-width="72rem" margin-left="auto" margin-right="auto" padding-left=24 padding-right=24

style Glass
  background-color="glass.fill" border-width=1 border-style="solid" border-color="glass.edge" border-radius=22
  backdrop-filter="blur(20px)"

style Body
  font-size="1rem" line-height=1.6 color="ink.muted"

style Small
  font-size="0.875rem" line-height=1.5 color="ink.muted"

style Eyebrow
  font-size="0.8125rem" font-weight=600 letter-spacing=1.5 color="brand.turquoise"

style H2
  overflow-wrap="break-word" font-size="2.5rem" font-weight=700 line-height=1.2 letter-spacing=-1 color="ink"

style H3
  font-size="1.1875rem" font-weight=650 line-height=1.3 color="ink"

style Grid
  display="grid" gap=16

component App
  resource chats = loadChats() as shape Chat[] else empty()
  resource reasons = loadReasons() as shape Card[] else empty()
  resource features = loadFeatures() as shape Card[] else empty()
  resource steps = loadSteps() as shape Step[] else empty()
  resource layers = loadLayers() as shape Layer[] else empty()
  resource stats = loadStats() as shape Stat[] else empty()
  resource milestones = loadMilestones() as shape Milestone[] else empty()

  // a link's location; the browser's back, forward and a deep link (`/#how`) arrive here too.
  action follow(url: string)
    nav = go(nav, url)

  view
    view navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="app" width="100%" height="100%"
      color-scheme="dark" background-color="page" color="ink"
      head title="Mux: all your chats, one inbox you own" description="Mux puts WhatsApp, Instagram, LinkedIn and more in one iPhone app. Every message goes through a Matrix server that you run." image="assets/mux-share.jpg"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` navigationScroll="home-page" position="absolute" inset=0
            display="flex" flex-direction="column"
            scroll document id="home-page" flex=1 min-height=0
              // the glow behind the top of the page: the logo's colours, far out of focus.
              view position="relative"
                background-image="radial-gradient(ellipse farthest-side at 78% 0%, #519AFF38, transparent 70%), radial-gradient(ellipse farthest-side at 8% 4%, #57DED421, transparent 60%)"
                SiteHeader()
                main display="flex" flex-direction="column"
                  Hero(chats=chats)
                  Why(reasons=reasons)
                  Features(features=features)
                  How(steps=steps, layers=layers)
                  Built(stats=stats, milestones=milestones)
                SiteFooter()
        if e.name == "notfound"
          column navigationKey=`${e.id}` navigationScroll="missing-page" position="absolute" inset=0
            display="flex" flex-direction="column"
            scroll document id="missing-page" flex=1 min-height=0
              head title="Not found: Mux" status=404
              SiteHeader()
              main class=Wrap display="flex" flex-direction="column" align-items="flex-start" gap=16 padding-top=96 padding-bottom=160
                text "This page does not exist." role="heading" aria-level=1 class=H2
                text "Its link may be out of date." class=Body
                link href="/" testId="notfound-home"
                  text "Go to the home page" color="brand.turquoise" font-weight=600
              SiteFooter()

// the bar on top: the logo and name, which go home, the sections, and the code.
component SiteHeader
  view
    header appearance="none" class=Wrap padding-top=20 padding-bottom=20
      row align-items="center" gap=16 flex-wrap="wrap"
        link href="/" testId="home" aria-label="Mux, home" flex-shrink=0
          row align-items="center" gap=10
            image "assets/mux-mark.jpg" alt="" width=32 height=32 border-radius=8
            text "Mux" font-size="1.25rem" font-weight=700 letter-spacing=-0.4
        // the section links are one group that cannot break: where it does not fit beside the name (a
        // phone), it wraps to a second line that this box clips, so the bar shows only the name and Code.
        // css alone decides it: the page is built at a phone's width, and a woken page keeps the build's
        // `exactViewport` until the window is resized, so a branch on the width would never show them.
        nav aria-label="Sections" flex=1 min-width=0 height=36 overflow="hidden"
          row flex-wrap="wrap" justify-content="flex-end" align-items="center" height=36
            // an empty first item: a group alone on a line never wraps, so this one lets it.
            view width=0 height=36 aria-hidden=true
            row align-items="center" gap=24 height=36 flex-shrink=0 white-space="nowrap"
              link href="#why" testId="nav-why"
                text "Why" class=Small color="ink.soft"
              link href="#features" testId="nav-features"
                text "Features" class=Small color="ink.soft"
              link href="#how" testId="nav-how"
                text "How it works" class=Small color="ink.soft"
              link href="#built" testId="nav-built"
                text "How we built it" class=Small color="ink.soft"
        link href="https://github.com/rami-maalouf/multiplexer" target="_blank" testId="nav-code" flex-shrink=0
          text "Code" class=Small color="ink" font-weight=600 padding="6px 14px" border-radius=999
            border-width=1 border-style="solid" border-color="glass.edge.strong"

// the first screen: what mux is in one line, and a phone with one inbox of many networks.
component Hero
  props
    chats: Chat[]
  view
    section aria-labelledby="hero-title" class=Wrap padding-top=56 padding-bottom=48
      view display="grid" grid-template-columns="repeat(auto-fit, minmax(min(100%, 26rem), 1fr))" gap=56 align-items="center"
        column gap=24 align-items="flex-start" min-width=0
          image "assets/mux-hero.jpg" alt="The Mux logo: a glass paper plane of three folded paths that meet at one nose" width=104 height=104
            border-radius=24 border-width=1 border-style="solid" border-color="glass.edge.logo" box-shadow="0 18px 60px rgba(81, 154, 255, 0.35)"
          text "All your chats." role="heading" aria-level=1 id="hero-title" overflow-wrap="break-word" align-self="stretch" font-size="3.375rem" font-weight=750 line-height=1.2 letter-spacing=-2
            text " One inbox you own." background-image=sweep() background-clip="text" color="transparent"
          text "Mux puts WhatsApp, Instagram, LinkedIn and more in one iPhone app. Every message goes through a Matrix server that you run, not through a company’s cloud." class=Body font-size="1.1875rem" max-width="34rem"
          row gap=12 flex-wrap="wrap" padding-top=8
            link href="#how" testId="cta-how"
              text "See how it works" font-weight=650 color="ink.on-brand" padding="12px 22px" border-radius=999 background-image=sweep()
            link href="#built" testId="cta-built"
              text "How we built it" font-weight=600 color="ink" padding="12px 22px" border-radius=999
                border-width=1 border-style="solid" border-color="glass.edge.strong" background-color="glass.fill.strong"
          text "iPhone today · Mac next · The code is on GitHub" class=Small color="ink.faint"
        row justify-content="center"
          Phone(chats=chats)

// a phone drawn in the page: mux's inbox with made-up chats, each with its network's logo.
component Phone
  props
    chats: Chat[]
  view
    view position="relative" width=320 max-width="100%"
      // the light the phone sits in.
      view position="absolute" inset=-24 border-radius=72 aria-hidden=true
        background-image="radial-gradient(closest-side, rgba(81, 154, 255, 0.35), rgba(87, 222, 212, 0.10) 60%, transparent 100%)"
      column position="relative" gap=14 padding="18px 14px 22px" border-radius=46 background-color="screen"
        border-width=1 border-style="solid" border-color="glass.edge.phone" box-shadow="0 40px 120px rgba(0, 0, 0, 0.55), inset 0 0 0 6px #0B1017"
        aria-label="The Mux inbox on an iPhone, with made-up chats" role="img"
        row justify-content="space-between" align-items="center" padding="4px 14px 0"
          text "9:41" testId="phone-clock" font-size=14 font-weight=650
          view width=90 height=26 border-radius=999 background-color="notch"
          text "100%" testId="phone-battery" font-size=12 color="ink.muted"
        row justify-content="space-between" align-items="center" padding="6px 8px 0"
          text "Inbox" testId="phone-title" font-size=30 font-weight=750 letter-spacing=-0.6
          view width=34 height=34 border-radius=999 background-color="glass.button"
        text "Search" testId="phone-search" font-size=15 color="ink.faint" padding="9px 14px" border-radius=12 background-color="glass.field" margin="0 4px"
        // the rows size their text against this one fixed size, as a real iPhone does at its default size.
        column gap=2 font-size=15 testId="phone-rows"
          for c in chats key=c.id
            row gap=12 align-items="center" padding="9px 6px"
              view position="relative" width=48 height=48 flex-shrink=0
                view width=48 height=48 border-radius=999 background-image=c.hue display="flex" align-items="center" justify-content="center"
                  text c.initials testId=`phone-initials-${c.id}` font-size="1em" font-weight=700 color="ink.on-brand" padding-right=6 padding-bottom=6
                image `assets/${c.network}.svg` alt=networkName(c.network) width=18 height=18 position="absolute" right=-2 bottom=-2
                  border-radius=5 border-width=2 border-style="solid" border-color="screen"
              column flex=1 min-width=0 gap=2
                row justify-content="space-between" gap=8
                  text c.name testId=`phone-name-${c.id}` font-size="1em" font-weight=(c.unread > 0 ? 700 : 550) white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
                  text c.time testId=`phone-time-${c.id}` font-size="0.8em" color=(c.unread > 0 ? "brand.blue" : "ink.faint") flex-shrink=0
                row justify-content="space-between" gap=8 align-items="center"
                  text c.preview testId=`phone-preview-${c.id}` font-size="0.8667em" color="ink.preview" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
                  if c.unread > 0
                    text `${c.unread}` testId=`phone-unread-${c.id}` font-size="0.7333em" font-weight=700 color="ink.on-blue" min-width=20 height=20 padding="0 6px" border-radius=999
                      background-color="brand.blue" display="flex" align-items="center" justify-content="center" flex-shrink=0

// a section's opening: a small label, a heading and one paragraph.
component SectionHead
  props
    id: string
    eyebrow: string
    title: string
    lead: string
  view
    column gap=14 max-width="44rem" padding-bottom=40
      text eyebrow class=Eyebrow
      text title role="heading" aria-level=2 id=id class=H2
      text lead class=Body font-size="1.125rem"

component Why
  props
    reasons: Card[]
  view
    section aria-labelledby="why-title" id="why" class=Wrap padding-top=64 padding-bottom=64
      SectionHead(id="why-title", eyebrow="WHY WE BUILT IT", title="Messages are too personal to rent.", lead="Mux started as a replacement for Beeper. Beeper proved that one inbox for every network works. But it is a company’s product: the company decides what it costs, which features you get, and what happens to the code. Mux keeps the idea and gives the keys back to you.")
      view class=Grid grid-template-columns="repeat(auto-fit, minmax(min(100%, 18rem), 1fr))"
        for r in reasons key=r.id
          column class=Glass gap=10 padding=28
            view width=28 height=4 border-radius=999 background-image=sweep() margin-bottom=8
            text r.title role="heading" aria-level=3 class=H3
            text r.body class=Body

component Features
  props
    features: Card[]
  view
    section aria-labelledby="features-title" id="features" class=Wrap padding-top=64 padding-bottom=64
      SectionHead(id="features-title", eyebrow="WHAT IT DOES", title="Beeper’s features. Messages’ feel.", lead="Mux takes every feature from Beeper that we use each day, and keeps the parts of Apple’s Messages that already feel right.")
      view class=Grid grid-template-columns="repeat(auto-fill, minmax(min(100%, 17rem), 1fr))"
        for f in features key=f.id
          column class=Glass gap=8 padding=24
            text f.title role="heading" aria-level=3 class=H3
            text f.body class=Small font-size="0.9375rem"

component How
  props
    steps: Step[]
    layers: Layer[]
  view
    section aria-labelledby="how-title" id="how" class=Wrap padding-top=64 padding-bottom=64
      SectionHead(id="how-title", eyebrow="HOW IT WORKS", title="Four parts, and you own three of them.", lead="Your chat networks stay where they are. Everything between them and your phone runs on a server you control.")
      view class=Grid grid-template-columns="repeat(auto-fit, minmax(min(100%, 15rem), 1fr))"
        for s in steps key=s.id
          column class=Glass gap=10 padding=24
            text s.step testId=`step-${s.id}` font-size="0.9375rem" font-weight=750 color="ink.on-brand" width="2rem" height="2rem" border-radius=999 background-image=sweep()
              display="flex" align-items="center" justify-content="center"
            text s.title role="heading" aria-level=3 class=H3
            text s.body class=Small font-size="0.9375rem"
      text "Under the hood" role="heading" aria-level=3 class=H3 font-size="1.5rem" padding-top=56 padding-bottom=20
      view class=Grid grid-template-columns="repeat(auto-fit, minmax(min(100%, 19rem), 1fr))"
        for l in layers key=l.id
          column class=Glass gap=10 padding=28
            text l.label class=Eyebrow color="brand.blue"
            text l.title role="heading" aria-level=4 class=H3 font-size="1.375rem"
            text l.body class=Body font-size="0.9375rem"
            text l.detail font-size="0.8125rem" color="ink.faint" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" padding-top=6

component Built
  props
    stats: Stat[]
    milestones: Milestone[]
  // the last milestone has no line under it: the card's edge ends the list.
  derive lastId = match milestones.at(-1) { case some(m) => m.id, case none => "" }
  view
    section aria-labelledby="built-title" id="built" class=Wrap padding-top=64 padding-bottom=96
      SectionHead(id="built-title", eyebrow="HOW WE BUILT IT", title="Eleven days, one small proof at a time.", lead="Rami built Mux with a team of AI coding agents. Several agents worked at once, each in its own copy of the code, guided by one shared plan.")
      view class=Grid grid-template-columns="repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr))" padding-bottom=48
        for s in stats key=s.id
          column class=Glass gap=6 padding=24
            text s.value align-self="flex-start" font-size="2.75rem" font-weight=750 letter-spacing=-1.5 line-height=1.15 background-image=sweep() background-clip="text" color="transparent"
            text s.label class=Small
      view display="grid" grid-template-columns="repeat(auto-fit, minmax(min(100%, 24rem), 1fr))" gap=48 align-items="start"
        column gap=20
          text "Prove each step before the next." role="heading" aria-level=3 class=H3 font-size="1.375rem"
          text "That was the rule. A task ended with a passing test or a screenshot of the real app, never with “it should work”." class=Body
          text "The order followed the biggest unknowns. First the server and one bridge, then one screen, then daily reading and sending on a real iPhone, then Beeper’s features one by one." class=Body
          text "Mux is also a field test of Exact, a new framework for native apps. Each place where Exact slowed the work became a written note for its team, and some became fixes in Exact itself." class=Body
          text "Today Mux has one user: Rami. The code is public, and a guide to run Mux on your own server comes next." class=Body color="ink.soft"
        column class=Glass padding="12px 24px" aria-label="Milestones"
          for m in milestones key=m.id
            row gap=16 padding="16px 0" border-bottom-width=(m.id == lastId ? 0 : 1) border-bottom-style="solid" border-bottom-color="line" align-items="flex-start"
              text m.when font-size="0.8125rem" font-weight=650 color=(m.done ? "brand.turquoise" : "ink.faint") width="4rem" flex-shrink=0 padding-top=3
              if m.done
                view width=10 height=10 border-radius=999 background-image=sweep() margin-top=7 flex-shrink=0
              else
                view width=10 height=10 border-radius=999 border-width=1.5 border-style="solid" border-color="ink.faint" margin-top=7 flex-shrink=0
              column gap=4 flex=1 min-width=0
                text m.title font-size="1rem" font-weight=650 color=(m.done ? "ink" : "ink.soft")
                text m.body class=Small

component SiteFooter
  view
    footer border-top-width=1 border-top-style="solid" border-top-color="line"
      row class=Wrap padding-top=32 padding-bottom=48 justify-content="space-between" align-items="center" gap=16 flex-wrap="wrap"
        row align-items="center" gap=10
          image "assets/mux-mark.jpg" alt="" width=24 height=24 border-radius=6
          text "Mux, built by Rami Maalouf." class=Small
        row gap=20 flex-wrap="wrap"
          link href="https://github.com/rami-maalouf/multiplexer" target="_blank" testId="footer-code"
            text "Code on GitHub" class=Small color="ink.soft"
          link href="https://matrix.org" target="_blank" testId="footer-matrix"
            text "About Matrix" class=Small color="ink.soft"
