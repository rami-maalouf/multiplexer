// the landing page's tests: its sections are there, a section link stays on the page, and a lost
// path is the not-found page with a way home.

test "the home page says what mux is and lists every section"
  clock data
  expect tree has "nav-why"
  expect tree has "cta-how"
  expect state chats.length == 6
  expect state features.length == 9
  expect state steps.length == 4
  expect state milestones.length == 7

test "a section link keeps the reader on the home page"
  clock data
  tap "nav-how"
  clock settle
  expect tree has "cta-how"

test "a path no route matches is the not-found page, with a way home"
  at "/no/such/page"
  clock data
  expect tree has "notfound-home"
  tap "notfound-home"
  clock settle
  expect tree has "cta-how"
